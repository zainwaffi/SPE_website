@rendermode InteractiveServer
@inject OpportunityService OppSvc
@inject NavigationManager Nav

@* The live opportunity board: search, the committee's add/delete controls, and row
   navigation.

   This is the only part of the Opportunities page that needs a SignalR circuit, so it is a
   component rather than markup on the page. The page itself is static SSR — Volunteering, the
   stats strip and Careers are fixed copy rendered from arrays — which means a guest, who never
   sees this board at all, does not open a circuit just to read them.

   The caller is responsible for only rendering this for signed-in users; it does not repeat
   that check. *@

    <section class=" border-slate-200 pt-10">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
                <h2 class="font-heading text-2xl font-bold text-black">Available Opportunities</h2>
                <p class="mt-2 text-sm text-slate-600">Curated opportunities from leading energy companies.</p>
            </div>
            <AuthorizeView Roles="CommitteeMember,TeamLeader">
                <Authorized>
                    <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add</button>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="mb-6">
            <input class="w-full spe-input" placeholder="Search opportunities by title or description..."
                   @bind="searchQuery" @bind:event="oninput" />
        </div>

        @if (showForm)
        {
            <div class="spe-card mb-8 p-6">
                <h3 class="mb-4 text-xl font-semibold text-spe-cobalt font-heading">New Opportunity</h3>
                @* Blog-style authoring, matching tutorial articles: the body is markdown and is
           rendered with headings, bullets and links on the detail page. *@
                <div class="flex flex-col gap-3">
                    <input class="spe-input" placeholder="Title" @bind="newTitle" />
                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-600"
                               for="opportunity-body">
                            Details
                        </label>
                        <textarea id="opportunity-body" class="spe-input w-full font-mono text-sm" rows="12"
                                  placeholder="@MarkdownPlaceholder" @bind="newDescription"></textarea>
                        <p class="mt-1.5 text-xs text-slate-500">
                            Markdown supported — <code>## Heading</code>, <code>- bullet</code>,
                            <code>[link](https://example.com)</code>, <code>**bold**</code>.
                        </p>
                    </div>
                    <input class="spe-input" placeholder="External URL (optional)" @bind="newUrl" />
                </div>
                <div class="mt-4 flex gap-3">
                    <button @onclick="SaveOpp" class="spe-primary-btn">Save</button>
                    <button @onclick="() => showForm = false"
                            class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
                </div>
            </div>
        }

        @if (opportunities is null)
        {
            <p class="py-20 text-center text-slate-500">Loading...</p>
        }
        else if (!FilteredOpportunities.Any())
        {
            <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
                <p class="text-xl font-medium text-slate-400">No opportunities match your search.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var opp in FilteredOpportunities)
                {
                    <article @key="opp.Id"
                             class="spe-card cursor-pointer border-slate-200 p-6 transition-shadow hover:shadow-md"
                             @onclick="() => GoToDetail(opp.Id)"
                             @oncontextmenu="e => OpenMenu(e, opp)"
                             @oncontextmenu:preventDefault="canManage">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <h3
                                    class="mb-1 text-lg font-bold text-spe-cobalt transition-colors hover:text-spe-endeavor font-heading">
                                    @opp.Title</h3>
                                    <p class="mb-3 line-clamp-3 text-slate-600">@Excerpt(opp.Description)</p>
                                    <span class="text-sm font-semibold text-spe-cobalt">View Details</span>
                                </div>
                                <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                    <Authorized>
                                        <button @onclick:stopPropagation="true" @onclick="() => DeleteOpp(opp.Id)"
                                                class="shrink-0 text-sm font-medium text-red-400 transition-colors hover:text-red-600">
                                            Delete
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </article>
                    }
                </div>
            }

        @* ---------- Committee: right-click menu, edit dialog, delete confirmation ---------- *@

        @if (menuOpp is not null)
        {
            <ContextMenu X="menuX" Y="menuY" Label="@menuOpp.Title"
                         OnUpdate="StartEdit" OnDelete="StartDelete" OnClose="CloseMenu" />
        }

        @if (editOpp is not null)
        {
            <div class="spe-modal-backdrop" @onclick="CancelEdit">
                <div class="spe-modal-card max-w-2xl" @onclick:stopPropagation="true">
                    <h2 class="mb-6 font-heading text-xl font-bold text-spe-cobalt">Edit Opportunity</h2>
                    <div class="flex flex-col gap-3">
                        <input class="spe-input" placeholder="Title" @bind="editTitle" />
                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-600"
                                   for="opportunity-edit-body">
                                Details
                            </label>
                            <textarea id="opportunity-edit-body" class="spe-input w-full font-mono text-sm" rows="12"
                                      @bind="editDescription"></textarea>
                            <p class="mt-1.5 text-xs text-slate-500">
                                Markdown supported — <code>## Heading</code>, <code>- bullet</code>,
                                <code>[link](https://example.com)</code>, <code>**bold**</code>.
                            </p>
                        </div>
                        <input class="spe-input" placeholder="External URL (optional)" @bind="editUrl" />
                    </div>
                    @if (!string.IsNullOrEmpty(editError))
                    {
                        <p class="mt-3 text-sm text-red-600">@editError</p>
                    }
                    <div class="mt-6 flex gap-3">
                        <button @onclick="SaveEdit" class="spe-primary-btn flex-1">Save changes</button>
                        <button @onclick="CancelEdit"
                                class="flex-1 rounded-lg border border-slate-300 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (deleteOpp is not null)
        {
            <ConfirmDialog Title="Delete this opportunity?"
                           Message="@($"“{deleteOpp.Title}” will be taken off the board for everyone. This cannot be undone.")"
                           OnConfirm="ConfirmDelete" OnCancel="() => deleteOpp = null" />
        }
        </section>


@code {
    /* ---------- Board state ---------- */

    private List<Opportunity>? opportunities;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newUrl = "";
    private string searchQuery = "";

    /* ---------- Committee: right-click update/delete ---------- */

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    // Same audience as the Add and Delete controls: <AuthorizeView Roles="CommitteeMember,
    // TeamLeader">. Resolved once in C# rather than left to that component, because the
    // contextmenu handler has to decide whether to run at all — an <AuthorizeView> could hide
    // the menu, but not stop the paired preventDefault from suppressing the browser's own
    // right-click menu for every other reader of the page.
    private bool canManage;

    private Opportunity? menuOpp;
    private double menuX, menuY;

    private Opportunity? editOpp;
    private string editTitle = "";
    private string editDescription = "";
    private string editUrl = "";
    private string? editError;

    private Opportunity? deleteOpp;

    private IEnumerable<Opportunity> FilteredOpportunities =>
        opportunities?.Where(opp =>
            string.IsNullOrWhiteSpace(searchQuery) ||
            opp.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            opp.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Opportunity>();

    // #UpdateLink — the example text shown in the empty "Details" box on the add form.
    private const string MarkdownPlaceholder = """
        ## About the role

        A short intro paragraph.

        - Requirement one
        - Requirement two

        Apply via the [company site](https://example.com).
        """;

    /* ---------- Load, create, delete ---------- */

    protected override async Task OnInitializedAsync()
    {
        canManage = await AuthStateTask.IsInAnyRoleAsync("CommitteeMember", "TeamLeader");
        opportunities = await OppSvc.GetAllAsync();
    }

    private async Task SaveOpp()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await OppSvc.CreateAsync(new Opportunity
        {
            Title = newTitle,
            Description = newDescription,
            ExternalUrl = string.IsNullOrWhiteSpace(newUrl) ? null : newUrl
        });
        showForm = false;
        newTitle = newDescription = newUrl = "";
        opportunities = await OppSvc.GetAllAsync();
    }

    private async Task DeleteOpp(int id)
    {
        await OppSvc.DeleteAsync(id);
        opportunities = await OppSvc.GetAllAsync();
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"/opportunities/{id}");

    /* ---------- Committee: right-click update/delete ---------- */

    /// <summary>
    /// Opens the context menu over the card. Does nothing for a member without edit rights,
    /// whose browser then keeps its own right-click menu — the markup pairs this with
    /// <c>@@oncontextmenu:preventDefault="canManage"</c> so the two agree.
    /// </summary>
    private void OpenMenu(MouseEventArgs e, Opportunity opp)
    {
        if (!canManage) return;

        menuOpp = opp;
        (menuX, menuY) = (e.ClientX, e.ClientY);
    }

    private void CloseMenu() => menuOpp = null;

    private void StartEdit()
    {
        if (menuOpp is null) return;

        editOpp = menuOpp;
        editTitle = editOpp.Title;
        editDescription = editOpp.Description;
        editUrl = editOpp.ExternalUrl ?? "";
        editError = null;
        CloseMenu();
    }

    private async Task SaveEdit()
    {
        if (editOpp is null) return;

        editError = null;
        if (string.IsNullOrWhiteSpace(editTitle))
        {
            // The add form drops a title-less save on the floor; here there is a dialog to say so in.
            editError = "Give the opportunity a title.";
            return;
        }

        await OppSvc.UpdateAsync(
            editOpp.Id, editTitle, editDescription,
            string.IsNullOrWhiteSpace(editUrl) ? null : editUrl);

        editOpp = null;
        opportunities = await OppSvc.GetAllAsync();
    }

    private void CancelEdit()
    {
        editOpp = null;
        editError = null;
    }

    private void StartDelete()
    {
        deleteOpp = menuOpp;
        CloseMenu();
    }

    private async Task ConfirmDelete()
    {
        if (deleteOpp is null) return;

        var id = deleteOpp.Id;
        deleteOpp = null;
        await DeleteOpp(id);
    }

    /// <summary>
    /// Plain-text preview for the list card. The body is markdown, so showing it raw would leak
    /// "##" and "- " into the summary. This strips only the common inline and block markers —
    /// it is a preview, not a renderer.
    /// </summary>
    private static string Excerpt(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"^#{1,6}\s*", "",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^\s*[-*+]\s+", "",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^\s*>\s?", "",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\[([^\]]*)\]\([^)]*\)", "$1");
        text = text.Replace("**", "").Replace("__", "").Replace("`", "");

        return string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
    }
}
