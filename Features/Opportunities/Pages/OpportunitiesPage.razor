@page "/opportunities"
@rendermode InteractiveServer
@inject OpportunityService OppSvc

<PageTitle>Opportunities — SPE Chapter</PageTitle>

<div class="max-w-4xl mx-auto px-6 py-12">
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-spe-blue">Opportunities</h1>
            <p class="text-slate-500 mt-1">SPE-related opportunities for our members.</p>
        </div>
        <AuthorizeView Roles="CommitteeMember,President">
            <Authorized>
                <button @onclick="() => showForm = true"
                        class="bg-spe-blue text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-800 transition-colors">
                    + Add
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <div class="bg-white rounded-xl shadow-md p-6 mb-8 border border-slate-200">
            <h2 class="text-xl font-semibold text-spe-blue mb-4">New Opportunity</h2>
            <div class="flex flex-col gap-3">
                <input class="border border-slate-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-blue"
                       placeholder="Title" @bind="newTitle" />
                <textarea class="border border-slate-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-blue"
                          rows="3" placeholder="Description" @bind="newDescription"></textarea>
                <input class="border border-slate-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-blue"
                       placeholder="External URL (optional)" @bind="newUrl" />
            </div>
            <div class="flex gap-3 mt-4">
                <button @onclick="SaveOpp" class="bg-spe-blue text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-800 transition-colors">Save</button>
                <button @onclick="() => showForm = false" class="border border-slate-300 text-slate-600 px-5 py-2 rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
            </div>
        </div>
    }

    @if (opportunities is null)
    {
        <p class="text-slate-500 text-center py-20">Loading...</p>
    }
    else if (opportunities.Count == 0)
    {
        <div class="text-center py-20 bg-white rounded-xl border border-slate-200">
            <p class="text-slate-400 text-xl font-medium">No opportunities posted yet.</p>
            <p class="text-slate-400 mt-2 text-sm">Check back soon for SPE opportunities.</p>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var opp in opportunities)
            {
                <div class="bg-white rounded-xl border border-slate-200 p-6 hover:shadow-sm transition-shadow">
                    <div class="flex justify-between items-start gap-4">
                        <div class="flex-1">
                            <h3 class="text-lg font-bold text-slate-800 mb-1">@opp.Title</h3>
                            <p class="text-slate-600 mb-3">@opp.Description</p>
                            @if (!string.IsNullOrEmpty(opp.ExternalUrl))
                            {
                                <a href="@opp.ExternalUrl" target="_blank" rel="noopener"
                                   class="text-spe-blue font-semibold text-sm hover:underline">
                                    Learn more →
                                </a>
                            }
                        </div>
                        <AuthorizeView Roles="CommitteeMember,President">
                            <Authorized>
                                <button @onclick="() => DeleteOpp(opp.Id)"
                                        class="text-red-400 hover:text-red-600 text-sm font-medium transition-colors shrink-0">
                                    Delete
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Opportunity>? opportunities;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newUrl = "";

    protected override async Task OnInitializedAsync() =>
        opportunities = await OppSvc.GetAllAsync();

    private async Task SaveOpp()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await OppSvc.CreateAsync(new Opportunity
        {
            Title = newTitle,
            Description = newDescription,
            ExternalUrl = string.IsNullOrWhiteSpace(newUrl) ? null : newUrl
        });
        showForm = false;
        newTitle = newDescription = newUrl = "";
        opportunities = await OppSvc.GetAllAsync();
    }

    private async Task DeleteOpp(int id)
    {
        await OppSvc.DeleteAsync(id);
        opportunities = await OppSvc.GetAllAsync();
    }
}
