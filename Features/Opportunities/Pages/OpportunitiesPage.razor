@page "/opportunities"
@rendermode InteractiveServer
@inject OpportunityService OppSvc
@inject NavigationManager Nav

<PageTitle>Opportunities — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-[1200px]">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="spe-page-kicker">Opportunities</p>
            <h1 class="spe-page-title">Jobs & Internships</h1>
            <p class="mt-2 text-sm text-slate-600">Curated opportunities from leading energy companies.</p>
        </div>
        <AuthorizeView Roles="CommitteeMember,President">
            <Authorized>
                <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <section class="spe-card mb-8 p-6">
            <h2 class="mb-4 text-xl font-semibold text-spe-cobalt" style="font-family:Montserrat, sans-serif;">New Opportunity</h2>
            <div class="flex flex-col gap-3">
                <input class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                       placeholder="Title" @bind="newTitle" />
                <textarea class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                          rows="3" placeholder="Description" @bind="newDescription"></textarea>
                <input class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                       placeholder="External URL (optional)" @bind="newUrl" />
            </div>
            <div class="mt-4 flex gap-3">
                <button @onclick="SaveOpp" class="spe-primary-btn">Save</button>
                <button @onclick="() => showForm = false" class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
            </div>
        </section>
    }

    @if (opportunities is null)
    {
        <p class="py-20 text-center text-slate-500">Loading...</p>
    }
    else if (opportunities.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl font-medium text-slate-400">No opportunities posted yet.</p>
            <p class="mt-2 text-sm text-slate-400">Check back soon for SPE opportunities.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var opp in opportunities)
            {
                <article class="spe-card cursor-pointer border-slate-200 p-6 transition-shadow hover:shadow-md" @onclick="() => GoToDetail(opp.Id)">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <h3 class="mb-1 text-lg font-bold text-spe-cobalt transition-colors hover:text-spe-endeavor" style="font-family:Montserrat, sans-serif;">@opp.Title</h3>
                            <p class="mb-3 line-clamp-3 text-slate-600">@opp.Description</p>
                            <span class="text-sm font-semibold text-spe-cobalt">View Details →</span>
                        </div>
                        <AuthorizeView Roles="CommitteeMember,President">
                            <Authorized>
                                <button @onclick:stopPropagation="true" @onclick="() => DeleteOpp(opp.Id)"
                                        class="shrink-0 text-sm font-medium text-red-400 transition-colors hover:text-red-600">
                                    Delete
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<Opportunity>? opportunities;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newUrl = "";

    protected override async Task OnInitializedAsync() =>
        opportunities = await OppSvc.GetAllAsync();

    private async Task SaveOpp()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await OppSvc.CreateAsync(new Opportunity
        {
            Title = newTitle,
            Description = newDescription,
            ExternalUrl = string.IsNullOrWhiteSpace(newUrl) ? null : newUrl
        });
        showForm = false;
        newTitle = newDescription = newUrl = "";
        opportunities = await OppSvc.GetAllAsync();
    }

    private async Task DeleteOpp(int id)
    {
        await OppSvc.DeleteAsync(id);
        opportunities = await OppSvc.GetAllAsync();
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"/opportunities/{id}");
}
