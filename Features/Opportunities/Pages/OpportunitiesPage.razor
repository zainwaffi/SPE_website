@page "/opportunities"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject OpportunityService OppSvc
@inject NavigationManager Nav

<PageTitle>Opportunities & Development — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-[1200px]">
    <div class="mb-10">
        <p class="spe-page-kicker">Opportunities And Development</p>
        <h1 class="spe-page-title">Get Involved</h1>
        <p class="mt-2 text-sm text-slate-600">
            Volunteer with the chapter, plan a route into the industry, and browse the current opportunity board.
        </p>
    </div>
</div>
    @* #UpdateContent: every string in this section is placeholder copy awaiting the real text.

       Photo flanked by two tiles, over a text block. The three-column row collapses to a single
       centred column below lg — each item carries mx-auto so it centres rather than stretching
       once the columns are gone. *@
    <div class="spe-page-shell bg-white/15 backdrop-blur-none md:max-w-[1200px]">
    <section class="mb-12  p-6 lg:p-8 ">
        <div class="rounded-2xl bg-white p-6 shadow-lg lg:p-8">
            <h2 class="mb-6 text-center font-heading text-2xl font-bold text-spe-cobalt lg:text-left">Volunteering</h2>

            <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-[1fr_2fr_1fr]">
                @* Two empty tiles from the layout sketch — no content decided yet. *@
                <div aria-hidden="true" class="h-40 w-full rounded-xl bg-spe-blue lg:h-56"></div>

                @* A CSS background rather than an <img>: decorative, so it needs no alt text, and
                   a missing file degrades to a plain tile instead of a broken-image icon. *@
                <div aria-hidden="true" class="spe-volunteering-photo mx-auto aspect-4/3 w-full rounded-lg"></div>

                <div aria-hidden="true" class="h-40 w-full rounded-xl bg-spe-blue lg:h-56"></div>
            </div>

            <div class="mt-6 rounded-lg bg-slate-200 px-6 py-8">
                <p class="text-center leading-relaxed text-slate-600 lg:text-left">@PlaceholderBody</p>
            </div>
        </div>
    </section>



    @* #UpdateContent: every string in this section is placeholder copy awaiting the real text.

       Copy on the left, feature card on the right; below lg the grid collapses to one column
       and both halves centre — hence text-center / lg:text-left and the mx-auto on the card. *@
    <section class="mb-12 rounded-2xl bg-spe-blue px-6 py-10 lg:px-12">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
            <div class="text-center lg:text-left">
                <h2 class="mb-4 font-heading text-3xl font-extrabold text-spe-gold">Careers</h2>
                <p class="mb-6 leading-relaxed text-white/85">@PlaceholderBody</p>

                @* Three empty tiles from the layout sketch — no content decided yet. *@
                <div class="grid grid-cols-3 gap-4">
                    @for (var tile = 0; tile < 3; tile++)
                    {
                        <div @key="tile" aria-hidden="true" class="aspect-square rounded-lg bg-spe-endeavor/50"></div>
                    }
                </div>
            </div>

            <div class="mx-auto w-full max-w-sm overflow-hidden rounded-2xl bg-white p-3 shadow-xl">
                @* A CSS background rather than an <img>: decorative, so it needs no alt text, and
                   a missing file degrades to a plain tile instead of a broken-image icon. *@
                <div aria-hidden="true" class="spe-careers-photo aspect-video w-full rounded-xl"></div>
                <div class="px-3 pb-2 pt-4">
                    <h3 class="mb-2 font-heading text-xl font-bold text-spe-cobalt">Title</h3>
                    <p class="mb-5 text-sm leading-relaxed text-slate-600">@PlaceholderBody</p>
                    @* #UpdateLinks — Careers feature card: replace "#" with the real destination *@
                    <a href="#"
                       class="block rounded-full bg-spe-endeavor px-5 py-2.5 text-center font-heading text-sm font-bold text-white transition-colors hover:bg-spe-cobalt">
                        Find out more
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>


<div class="spe-page-shell md:max-w-[1200px]">
    @* Volunteering and Careers above are public; the live opportunity board is not. Guests get
       a sign-in prompt in its place rather than an empty search box over nothing. *@
    <AuthorizeView>
        <Authorized Context="board">
    <section class=" border-slate-200 pt-10">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
                <h2 class="font-heading text-2xl font-bold text-black">Available Opportunities</h2>
                <p class="mt-2 text-sm text-slate-600">Curated opportunities from leading energy companies.</p>
            </div>
            <AuthorizeView Roles="CommitteeMember,TeamLeader">
                <Authorized>
                    <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add</button>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="mb-6">
            <input class="w-full spe-input"
                   placeholder="Search opportunities by title or description..."
                   @bind="searchQuery" @bind:event="oninput" />
        </div>

        @if (showForm)
        {
            <div class="spe-card mb-8 p-6">
                <h3 class="mb-4 text-xl font-semibold text-spe-cobalt font-heading">New Opportunity</h3>
                @* Blog-style authoring, matching tutorial articles: the body is markdown and is
                   rendered with headings, bullets and links on the detail page. *@
                <div class="flex flex-col gap-3">
                    <input class="spe-input" placeholder="Title" @bind="newTitle" />
                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-600" for="opportunity-body">
                            Details
                        </label>
                        <textarea id="opportunity-body" class="spe-input w-full font-mono text-sm" rows="12"
                                  placeholder="@MarkdownPlaceholder" @bind="newDescription"></textarea>
                        <p class="mt-1.5 text-xs text-slate-500">
                            Markdown supported — <code>## Heading</code>, <code>- bullet</code>,
                            <code>[link](https://example.com)</code>, <code>**bold**</code>.
                        </p>
                    </div>
                    <input class="spe-input" placeholder="External URL (optional)" @bind="newUrl" />
                </div>
                <div class="mt-4 flex gap-3">
                    <button @onclick="SaveOpp" class="spe-primary-btn">Save</button>
                    <button @onclick="() => showForm = false" class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
                </div>
            </div>
        }

        @if (opportunities is null)
        {
            <p class="py-20 text-center text-slate-500">Loading...</p>
        }
        else if (!FilteredOpportunities.Any())
        {
            <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
                <p class="text-xl font-medium text-slate-400">No opportunities match your search.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var opp in FilteredOpportunities)
                {
                    <article @key="opp.Id" class="spe-card cursor-pointer border-slate-200 p-6 transition-shadow hover:shadow-md" @onclick="() => GoToDetail(opp.Id)">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <h3 class="mb-1 text-lg font-bold text-spe-cobalt transition-colors hover:text-spe-endeavor font-heading">@opp.Title</h3>
                                <p class="mb-3 line-clamp-3 text-slate-600">@Excerpt(opp.Description)</p>
                                <span class="text-sm font-semibold text-spe-cobalt">View Details</span>
                            </div>
                            <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                <Authorized>
                                    <button @onclick:stopPropagation="true" @onclick="() => DeleteOpp(opp.Id)"
                                            class="shrink-0 text-sm font-medium text-red-400 transition-colors hover:text-red-600">
                                        Delete
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

        </Authorized>
        <NotAuthorized Context="guest">
            <section class="border-t border-slate-200 pt-10">
                <div class="rounded-xl border border-slate-200 bg-slate-50 py-16 text-center">
                    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-spe-cobalt/10 text-spe-cobalt">
                        <Icon Name="list-check" Class="h-6 w-6" />
                    </div>
                    <h2 class="font-heading text-xl font-bold text-black">Members-only opportunity board</h2>
                    <p class="mx-auto mt-2 max-w-md text-sm text-slate-600">
                        Sign in with your SPE membership email to search the jobs, internships and
                        graduate vacancies shared with the chapter.
                    </p>
                    <a href="/login" class="spe-primary-btn mt-6 inline-block">Sign in</a>
                </div>
            </section>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    // #UpdateContent: Volunteering and Careers copy. Edit the text here rather than in the
    // markup above — the two sections are rendered by looping over these.
    // #UpdateContent: placeholder body copy for the Volunteering and Careers sections.
    // One constant so replacing it updates every placeholder at once.
    private const string PlaceholderBody =
        "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec et volutpat tortor, " +
        "vel euismod ante. Curabitur pellentesque, libero eget sagittis ultrices.";

    /// <summary>A volunteering route. <paramref name="Details"/> is rendered as a labelled list,
    /// so pathways with no stated commitment simply omit that pair.</summary>
    private sealed record VolunteerPathway(string Icon, string Title, (string Label, string Text)[] Details);


    private const string MarkdownPlaceholder = """
        ## About the role

        A short intro paragraph.

        - Requirement one
        - Requirement two

        Apply via the [company site](https://example.com).
        """;

    /// <summary>
    /// Plain-text preview for the list card. The body is markdown now, so showing it raw
    /// would leak "##" and "- " into the summary. This strips only the common inline and
    /// block markers — it is a preview, not a renderer.
    /// </summary>
    private static string Excerpt(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"^#{1,6}\s*", "",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^\s*[-*+]\s+", "",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"^\s*>\s?", "",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\[([^\]]*)\]\([^)]*\)", "$1");
        text = text.Replace("**", "").Replace("__", "").Replace("`", "");

        return string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
    }

    private List<Opportunity>? opportunities;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newUrl = "";
    private string searchQuery = "";

    private IEnumerable<Opportunity> FilteredOpportunities =>
        opportunities?.Where(opp =>
            string.IsNullOrWhiteSpace(searchQuery) ||
            opp.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            opp.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Opportunity>();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    /// <summary>
    /// Guests see only the public Volunteering and Careers sections, so they never trigger the
    /// board query — this mirrors the &lt;AuthorizeView&gt; in the markup rather than loading
    /// rows nobody renders.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var authState = AuthStateTask is null ? null : await AuthStateTask;
        if (authState?.User.Identity?.IsAuthenticated == true)
            opportunities = await OppSvc.GetAllAsync();
    }

    private async Task SaveOpp()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await OppSvc.CreateAsync(new Opportunity
        {
            Title = newTitle,
            Description = newDescription,
            ExternalUrl = string.IsNullOrWhiteSpace(newUrl) ? null : newUrl
        });
        showForm = false;
        newTitle = newDescription = newUrl = "";
        opportunities = await OppSvc.GetAllAsync();
    }

    private async Task DeleteOpp(int id)
    {
        await OppSvc.DeleteAsync(id);
        opportunities = await OppSvc.GetAllAsync();
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"/opportunities/{id}");
}
