@page "/opportunities/{id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OpportunityService OppSvc
@inject NavigationManager Nav

<PageTitle>@(opportunity?.Title ?? "Opportunity") — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-4xl">
    @if (opportunity is null)
    {
        <p class="py-20 text-center text-slate-500">Loading...</p>
    }
    else
    {
        <button @onclick="GoBack" class="mb-6 text-sm font-semibold text-spe-cobalt hover:underline">
            ← Back to Opportunities
        </button>

        <article class="spe-card border-slate-200 p-8">
            <p class="spe-page-kicker">Opportunity</p>
            <h1 class="mb-4 text-4xl font-bold text-spe-cobalt font-heading">@opportunity.Title</h1>
            <p class="mb-6 text-sm text-slate-500">Posted on @opportunity.CreatedAt.ToString("MMMM d, yyyy")</p>

            <Markdown Content="@opportunity.Description" Class="mb-8" />

            @if (!string.IsNullOrEmpty(opportunity.ExternalUrl))
            {
                <a href="@opportunity.ExternalUrl" target="_blank" rel="noopener noreferrer" class="spe-primary-btn inline-block">
                    Visit External Link →
                </a>
            }
        </article>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Opportunity? opportunity;

    protected override async Task OnInitializedAsync() =>
        opportunity = await OppSvc.GetByIdAsync(Id);

    private void GoBack() => Nav.NavigateTo("/opportunities");
}
