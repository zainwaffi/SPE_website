@page "/change-password"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Change Password — SPE Chapter</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <span class="text-spe-blue font-extrabold text-4xl">SPE</span>
            <p class="text-slate-500 mt-2">Change your password</p>
        </div>

        <div class="bg-white rounded-2xl shadow-md p-8 border border-slate-200">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-6">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-6">
                    @successMessage
                </div>
            }

            <EditForm Model="input" method="post" OnValidSubmit="HandleChangePassword" FormName="changepassword">
                <DataAnnotationsValidator />
                <div class="flex flex-col gap-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Current Password</label>
                        <InputText @bind-Value="input.CurrentPassword" type="password"
                                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-spe-blue text-slate-800"
                                   placeholder="••••••••" autocomplete="current-password" />
                        <ValidationMessage For="() => input.CurrentPassword" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">New Password</label>
                        <InputText @bind-Value="input.NewPassword" type="password"
                                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-spe-blue text-slate-800"
                                   placeholder="••••••••" autocomplete="new-password" />
                        <ValidationMessage For="() => input.NewPassword" class="text-red-500 text-xs mt-1" />
                        <p class="text-xs text-slate-500 mt-1">At least 8 characters with at least one digit.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Confirm New Password</label>
                        <InputText @bind-Value="input.ConfirmPassword" type="password"
                                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-spe-blue text-slate-800"
                                   placeholder="••••••••" autocomplete="new-password" />
                        <ValidationMessage For="() => input.ConfirmPassword" class="text-red-500 text-xs mt-1" />
                    </div>
                    <button type="submit"
                            class="w-full bg-spe-blue text-white font-bold py-3 rounded-lg hover:bg-blue-800 transition-colors mt-1">
                        Update Password
                    </button>
                </div>
            </EditForm>

            <hr class="my-6 border-slate-200" />
            <p class="text-center text-sm text-slate-600">
                <a href="/" class="text-spe-blue hover:underline">Back to home</a>
            </p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "changepassword")]
    private ChangePasswordInput? input { get; set; }

    private string? errorMessage;
    private string? successMessage;
    private ApplicationUser? currentUser;

    protected override void OnInitialized() => input ??= new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdClaim is not null)
            currentUser = await UserManager.FindByIdAsync(userIdClaim);
    }

    private async Task HandleChangePassword()
    {
        errorMessage = null;
        successMessage = null;

        if (input.NewPassword != input.ConfirmPassword)
        {
            errorMessage = "New password and confirmation do not match.";
            return;
        }

        if (currentUser is null)
        {
            errorMessage = "User not found.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(currentUser, input.CurrentPassword, input.NewPassword);
        if (result.Succeeded)
        {
            successMessage = "Password changed successfully. Redirecting...";
            await Task.Delay(1500);
            NavigationManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    private sealed class ChangePasswordInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CurrentPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = "";
    }
}
