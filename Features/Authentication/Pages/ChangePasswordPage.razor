@page "/change-password"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Change Password — SPE Chapter</PageTitle>

<div class="flex min-h-[70vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-xl">
        <h1 class="mb-1 text-center text-2xl font-extrabold text-black" style="font-family:Montserrat, sans-serif;">Change Password</h1>
        <p class="mb-8 text-center text-sm text-slate-500">Update your account credentials.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
                @successMessage
            </div>
        }

        <EditForm Model="FormInput" method="post" OnValidSubmit="HandleChangePassword" FormName="changepassword">
            <DataAnnotationsValidator />
            <div class="space-y-4">
                <div>
                    <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black" style="font-family:Montserrat, sans-serif;">Current Password</label>
                    <InputText @bind-Value="FormInput.CurrentPassword" type="password"
                               class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                               placeholder="••••••••" autocomplete="current-password" />
                    <ValidationMessage For="() => FormInput.CurrentPassword" class="mt-1 text-xs text-red-500" />
                </div>
                <div>
                    <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black" style="font-family:Montserrat, sans-serif;">New Password</label>
                    <InputText @bind-Value="FormInput.NewPassword" type="password"
                               class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                               placeholder="••••••••" autocomplete="new-password" />
                    <ValidationMessage For="() => FormInput.NewPassword" class="mt-1 text-xs text-red-500" />
                </div>
                <div>
                    <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black" style="font-family:Montserrat, sans-serif;">Confirm New Password</label>
                    <InputText @bind-Value="FormInput.ConfirmPassword" type="password"
                               class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                               placeholder="••••••••" autocomplete="new-password" />
                    <ValidationMessage For="() => FormInput.ConfirmPassword" class="mt-1 text-xs text-red-500" />
                </div>
                <button type="submit" class="spe-primary-btn w-full py-3">Update Password</button>
            </div>
        </EditForm>

        <p class="mt-6 text-center text-sm text-slate-600">
            <a href="/" class="font-semibold text-spe-cobalt hover:underline">Back to home</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "changepassword")]
    private ChangePasswordInput? input { get; set; }

    private string? errorMessage;
    private string? successMessage;
    private ApplicationUser? currentUser;
    private ChangePasswordInput FormInput => input ??= new();

    protected override void OnInitialized() => input ??= new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdClaim is not null)
            currentUser = await UserManager.FindByIdAsync(userIdClaim);
    }

    private async Task HandleChangePassword()
    {
        errorMessage = null;
        successMessage = null;

        if (FormInput.NewPassword != FormInput.ConfirmPassword)
        {
            errorMessage = "New password and confirmation do not match.";
            return;
        }

        if (currentUser is null)
        {
            errorMessage = "User not found.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(currentUser, FormInput.CurrentPassword, FormInput.NewPassword);
        if (result.Succeeded)
        {
            successMessage = "Password changed successfully. Redirecting...";
            await Task.Delay(1500);
            NavigationManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    private sealed class ChangePasswordInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CurrentPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = "";
    }
}
