@page "/login"
@using SPE_website.Features.Authentication.Services
@inject OpenWaterAuthService OpenWaterAuthService
@inject NavigationManager NavigationManager

<PageTitle>Login — SPE Chapter</PageTitle>

<div class="flex min-h-[70vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-xl">
        <div class="mb-6 flex justify-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-spe-cobalt">
                <Icon Name="globe" Class="h-7 w-7 text-white" />
            </div>
        </div>
        <h1 class="mb-1 text-center text-2xl font-extrabold text-black font-heading">Welcome Back</h1>
        <p class="mb-8 text-center text-sm text-slate-500">Sign in with your SPE email</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                @errorMessage
            </div>
        }
        @if (showJoinSpeOption)
        {
            <a href="@OpenWaterAuthService.JoinSpeUrl" target="_blank" rel="noopener noreferrer"
               class="mb-6 block rounded-lg border border-spe-cobalt/30 bg-spe-cobalt/5 px-4 py-3 text-center text-sm font-semibold text-spe-cobalt hover:bg-spe-cobalt/10">
                Join SPE Membership
            </a>
        }

        <EditForm Model="FormInput" method="post" OnValidSubmit="HandleLogin" FormName="login">
            <DataAnnotationsValidator />
            <div class="space-y-4">
                <div>
                    <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black font-heading">Email Address</label>
                    <InputText @bind-Value="FormInput.Email" type="email"
                               class="spe-input w-full py-3 text-sm text-slate-800"
                               placeholder="you@example.com" autocomplete="email" />
                    <ValidationMessage For="() => FormInput.Email" class="mt-1 text-xs text-red-500" />
                </div>
                <button type="submit" class="spe-primary-btn w-full py-3">
                    Sign In
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "login", Name = nameof(FormInput))]
    private LoginInput? postedFormInput { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? errorMessage;
    private bool showJoinSpeOption;
    private LoginInput FormInput { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (postedFormInput is not null)
            FormInput = postedFormInput;
    }

    private async Task HandleLogin()
    {
        showJoinSpeOption = false;
        var result = await OpenWaterAuthService.LoginWithEmailAsync(FormInput.Email);
        if (result.Succeeded)
            NavigationManager.NavigateTo(SafeReturnUrl(), true);
        else
        {
            errorMessage = result.Error ?? "Unable to sign in with this email.";
            showJoinSpeOption = result.ShowJoinSpeOption;
        }
    }

    // Only ever return to a path on this site, never to an absolute/external URL.
    private string SafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
            return "/";

        if (!ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//") || ReturnUrl.StartsWith("/\\"))
            return "/";

        return ReturnUrl;
    }

    private sealed class LoginInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

    }
}
