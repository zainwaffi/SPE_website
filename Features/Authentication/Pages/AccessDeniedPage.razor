@page "/access-denied"

<PageTitle>Access Denied — SPE Chapter</PageTitle>

<div class="flex min-h-[70vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xl">
        <div class="mb-5 text-6xl text-spe-cobalt"><i class="fa fa-lock"></i></div>
        <h1 class="mb-3 text-3xl font-bold text-spe-cobalt" style="font-family:Montserrat, sans-serif;">Access Denied</h1>
        <p class="mb-8 text-slate-500">You don't have permission to view this page. Please sign in with an authorized account.</p>
        <div class="flex justify-center gap-3">
            <a href="/login" class="spe-primary-btn">Sign In</a>
            <a href="/" class="rounded-lg border border-slate-300 px-6 py-2.5 font-semibold text-slate-600 transition-colors hover:bg-slate-50">Go Home</a>
        </div>
    </div>
</div>
