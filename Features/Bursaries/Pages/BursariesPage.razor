@page "/Scholarships"
@attribute [AllowAnonymous]

@* Public page, like Home and Events — [AllowAnonymous] is stated rather than left implied so
   the intent survives anyone adding a fallback authorization policy later.

   Static SSR: the content is fixed copy with no state or event handlers, so this must not
   open a SignalR circuit.

   Scope: scholarships and bursaries only. Membership dues waivers and the graduate dues
   discount used to sit here too — they are membership pricing, not funding for study, and were
   removed so this page answers one question. *@

@* #UpdateLink — tab title, the description used in search results and link previews,
   and the preview image. *@
<PageMeta Title="Scholarships and Bursaries — SPE Chapter"
          Description="Funding for students on energy and engineering degrees: the SPE Aberdeen student bursary of £500–£5,000, and the SPE Foundation's international scholarships and fellowships."
          Image="/images/bursaries-1280.webp"
          ImageAlt="Students and staff from the SPE student chapter at a lecture on the energy transition." />

@* Cobalt band matching the home page's "Why Join Us" and the Technical & Academic Development
   panel. All copy is written directly in the markup below — this page has no @@code block, so
   editing the text means editing the HTML you can see. *@
<FadeUp class="mx-4 my-6 rounded-2xl bg-spe-cobalt/90 py-16 backdrop-blur md:mx-auto md:max-w-300">
    <div class="px-6 lg:px-8">

        @* ---------- Heading ---------- *@

        @* #UpdateLink — page heading and intro copy. *@
        <div class="mb-10 text-center">
            <p class="spe-page-kicker text-spe-gold">—Scholarships &amp; Bursaries—</p>
            <h1 class="mb-3 font-heading text-3xl font-extrabold text-white">Financial Support</h1>
            <p class="mx-auto max-w-2xl text-sm text-white/75">
                SPE is committed to lowering financial barriers for students pursuing degrees
                related to energy and engineering. There is money available locally through our
                own section, and internationally through the SPE Foundation.
            </p>
        </div>

        @* #UpdateLink — the group photo below: replace assets/bursaries.jpg and re-run
           `npm run build:images`, then update the alt text to describe the new picture. *@

        @* Chapter group photo. This is content rather than decoration — it shows who the funding
           is for — so it is an <img> with alt text instead of one of the .spe-*-photo background
           tiles. It sits high enough to be above the fold on desktop, hence no loading="lazy". *@
        <img src="/images/bursaries-1280.webp"
             srcset="/images/bursaries-1280.webp 1280w, /images/bursaries-1920.webp 1920w"
             sizes="(min-width: 768px) 1200px, 100vw"
             width="1920" height="459" decoding="async"
             alt="Students and staff from the SPE student chapter at a University of Dundee lecture on the energy transition."
             class="mb-10 w-full rounded-xl shadow-lg ring-1 ring-white/15" />

        @* ---------- The local bursary ---------- *@

        @* Given its own panel rather than a card in the grid: it is the one award our students
           are most likely to win, and the only one with an application process we can describe
           end to end. *@
        <section class="mb-12 rounded-xl bg-white/10 p-6 lg:p-8">
            <div class="mb-6 flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-spe-gold text-black">
                    <Icon Name="trophy" Class="h-6 w-6" />
                </div>
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">Our Section Bursary</p>
                    <h2 class="font-heading text-xl font-bold text-white">SPE Aberdeen Student Bursary Programme</h2>
                </div>
            </div>

            @* #UpdateLink — bursary award range and the running total awarded. Both come from
               spe-aberdeen.org/student-bursaries and are worth re-checking each year. *@
            <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="rounded-lg bg-white/10 p-4">
                    <p class="font-heading text-2xl font-extrabold text-spe-gold">£500 - £5,000</p>
                    <p class="mt-1 text-xs text-white/70">Awarded per successful applicant</p>
                </div>
                <div class="rounded-lg bg-white/10 p-4">
                    <p class="font-heading text-2xl font-extrabold text-spe-gold">£200,000+</p>
                    <p class="mt-1 text-xs text-white/70">Given to students across Scotland in the past decade</p>
                </div>
            </div>

            @* #UpdateLink — bursary eligibility and application copy. Source of truth is
               https://www.spe-aberdeen.org/student-bursaries — re-read it when the cycle reopens. *@
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                <dl class="space-y-4">
                    <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">Who runs it</dt>
                        <dd class="mt-0.5 text-sm leading-relaxed text-white/75">
                            The SPE Aberdeen Section. Applications are reviewed by the Student
                            Development Committee, and the Board gives final approval.
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">Eligible institutions</dt>
                        @* A flex row rather than inline spans carrying .spe-gold-btn. Vertical
                           padding on an inline element does not grow the line box, so the pills
                           overlapped the line above and clipped. Flex items are block-level, so
                           the padding counts, and `gap` spaces them without relying on the
                           whitespace between tags. *@
                        <dd class="mt-1.5 flex flex-wrap gap-1.5">
                            <span class="rounded-md bg-spe-gold px-2.5 py-1 font-heading text-xs font-bold text-black">University of Aberdeen</span>
                            <span class="rounded-md bg-spe-gold px-2.5 py-1 font-heading text-xs font-bold text-black">Robert Gordon University (RGU)</span>
                            <span class="rounded-md bg-spe-gold px-2.5 py-1 font-heading text-xs font-bold text-black">Heriot-Watt University</span>
                            <span class="rounded-md bg-spe-gold px-2.5 py-1 font-heading text-xs font-bold text-black">University of Dundee</span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">Who can apply</dt>
                        <dd class="mt-0.5 text-sm leading-relaxed text-white/75">
                            Undergraduates, full-time postgraduates and PhD students currently
                            enrolled on a course directly relevant to the energy industry.
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">What they look for</dt>
                        <dd class="mt-0.5 text-sm leading-relaxed text-white/75">
                            Academic merit, a demonstrated commitment to working in the energy
                            sector, SPE membership, and active involvement in SPE.
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">How to apply</dt>
                        <dd class="mt-0.5 text-sm leading-relaxed text-white/75">
                            Download the application form from the SPE Aberdeen site, complete it
                            digitally, and email it with your answers to the additional questions.
                            Do not attach anything else.
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wider text-spe-gold">Shortlisting</dt>
                        <dd class="mt-0.5 text-sm leading-relaxed text-white/75">
                            Shortlisted candidates present to a judging panel, in person or
                            remotely, before awards are confirmed.
                        </dd>
                    </div>
                </dl>

                <div>
                    @* #UpdateLink — the cycle runs to roughly these months each year. Replace with
                       the exact dates once SPE Aberdeen publishes them for the current cycle. *@
                    <p class="mb-2 text-[11px] font-bold uppercase tracking-wider text-spe-gold">Timeline</p>
                    <ul class="mb-6 space-y-2">
                        <li class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="text-white/75">Applications open</span>
                            <span class="shrink-0 rounded-md bg-white/15 px-2 py-0.5 text-[11px] font-semibold text-white">Early November</span>
                        </li>
                        <li class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="text-white/75">Deadline</span>
                            <span class="shrink-0 rounded-md bg-white/15 px-2 py-0.5 text-[11px] font-semibold text-white">Mid-December</span>
                        </li>
                        <li class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="text-white/75">Judging</span>
                            <span class="shrink-0 rounded-md bg-white/15 px-2 py-0.5 text-[11px] font-semibold text-white">January</span>
                        </li>
                        <li class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="text-white/75">Winners announced</span>
                            <span class="shrink-0 rounded-md bg-white/15 px-2 py-0.5 text-[11px] font-semibold text-white">February</span>
                        </li>
                    </ul>

                    @* #UpdateLink — bursary links and the section's contact address. The
                       application form is a Word file whose URL changes every year, so this
                       points at the page that always carries the current one rather than at the
                       file itself. *@
                    <div class="flex flex-wrap gap-3">
                        <a href="https://www.spe-aberdeen.org/student-bursaries" target="_blank"
                           rel="noopener noreferrer" class="spe-gold-btn">
                            Apply on spe-aberdeen.org
                        </a>
                        <a href="https://www.spe-aberdeen.org/student-bursaries/2025-26-results" target="_blank"
                           rel="noopener noreferrer" class="spe-ghost-btn px-5">
                            <Icon Name="users" Class="h-4 w-4" />
                            See who won last year
                        </a>
                    </div>

                    <p class="mt-4 text-xs leading-relaxed text-white/60">
                        Questions about the section bursary go to Diane Wood at
                        <a href="mailto:aberdeen.manager@spe-uk.org"
                           class="font-semibold text-white underline underline-offset-2 hover:text-spe-gold">aberdeen.manager@spe-uk.org</a>.
                    </p>
                </div>
            </div>
        </section>

        @* ---------- SPE Foundation awards ---------- *@

        <section>
