@page "/admin/members"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "TeamLeader")]
@inject AdminService AdminSvc

@* Access control is the [Authorize] attribute above. Routes.razor renders the shared
   access-denied panel (or redirects to login) for anyone who fails it, so this page does
   not repeat the check in markup or at runtime. *@

<PageTitle>Member Dashboard — SPE Admin</PageTitle>

<DesktopOnly Title="Member Dashboard">
<div class="max-w-6xl mx-auto px-6 py-12">
    @* ---------- Heading and admin tool links ---------- *@

    <div class="flex items-start justify-between gap-4 mb-10">
        <div>
            <h1 class="text-3xl font-bold text-spe-gold mb-2">Member Dashboard</h1>
            <p class="text-white text-lg">Oversee all committee members, their tasks, and strike records.</p>
        </div>
        <div class="flex shrink-0 items-center gap-3">
            @* A plain link, not a button: the browser downloads it directly instead of
               streaming the workbook back over the SignalR circuit. *@
            <a href="/admin/export/attendance.xlsx"
               class="spe-ghost-btn px-5">
                <Icon Name="download" Class="h-4 w-4" />
                Export Attendance
            </a>
            <a href="/tasks/assigned"
               class="spe-ghost-btn px-5">
                <Icon Name="list-check" Class="h-4 w-4" />
                Assigned Tasks
            </a>
            <a href="/admin/calendar"
               class="inline-flex items-center gap-2 bg-spe-blue text-white px-5 py-2.5 rounded-lg hover:bg-blue-800 transition-colors font-semibold text-sm">
                Task Calendar
            </a>
        </div>
    </div>

    @* ---------- Last-action notification banner ---------- *@

    @if (notification is not null)
    {
        <div class="mb-6 rounded-lg border px-4 py-3 text-sm @(notification.Sent ? "bg-green-50 border-green-200 text-green-800" : "bg-amber-50 border-amber-200 text-amber-800")">
            <p class="font-semibold">@notificationAction</p>
            @if (notification.Sent)
            {
                <p>A notification email was sent to the member.</p>
            }
            else
            {
                <p>The member was <strong>not</strong> notified by email: @notification.Error</p>
            }
        </div>
    }

    @* ---------- Member table ---------- *@

    @if (members is null)
    {
        <p class="text-slate-500 text-center py-20">Loading members...</p>
    }
    else if (members.Count == 0)
    {
        <div class="text-center py-20 bg-white rounded-xl border border-slate-200">
            <p class="text-slate-400 text-xl">No committee members found.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-slate-500 uppercase text-xs tracking-wider">
                    <tr>
                        <th class="px-6 py-4 text-left font-semibold">Member</th>
                        <th class="px-6 py-4 text-left font-semibold">Role</th>
                        <th class="px-6 py-4 text-center font-semibold">Tasks</th>
                        <th class="px-6 py-4 text-center font-semibold">Strikes</th>
                        <th class="px-6 py-4 text-center font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var member in members)
                    {
                        var tasks = CountTasks(member);
                        <tr @key="member.Id" class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-spe-blue flex items-center justify-center text-white font-bold text-sm shrink-0">
                                        @(member.FullName.Length > 0 ? char.ToUpperInvariant(member.FullName[0]).ToString() : "?")
                                    </div>
                                    <div>
                                        <p class="font-semibold text-slate-800">@member.FullName</p>
                                        <p class="text-slate-400 text-xs">@member.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (string.IsNullOrWhiteSpace(member.CommitteeTitle))
                                {
                                    <span class="text-slate-400 text-xs">None</span>
                                }
                                else
                                {
                                    <span class="inline-block whitespace-nowrap bg-spe-blue/10 text-spe-blue text-xs font-semibold px-2.5 py-1 rounded-full">
                                        @member.CommitteeTitle
                                    </span>
                                }
                                @* Team allocation drives tutorial access, so it belongs on the
                                   table rather than only behind the edit form. *@
                                @if (member.Teams.Count == 0)
                                {
                                    <p class="mt-1.5 text-xs text-slate-400">No team</p>
                                }
                                else
                                {
                                    <div class="mt-1.5 flex flex-col gap-1">
                                        @foreach (var membership in member.Teams.OrderBy(m => m.Team))
                                        {
                                            <span @key="membership.Team" class="inline-block whitespace-nowrap rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">
                                                @membership.Team.DisplayName()
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex justify-center gap-3 text-xs">
                                    <span class="text-amber-600 font-semibold">@tasks.Active active</span>
                                    <span class="text-green-600 font-semibold">@tasks.Completed done</span>
                                    <span class="text-red-500 font-semibold">@tasks.Failed failed</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="text-xl font-extrabold @(member.StrikeCount >= 3 ? "text-red-500" : member.StrikeCount >= 1 ? "text-amber-500" : "text-green-500")">
                                    @member.StrikeCount
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex justify-center gap-2">
                                    <button @onclick="() => AddStrike(member)"
                                            title="Add strike" aria-label="Add strike"
                                            class="text-xs bg-amber-100 text-amber-700 hover:bg-amber-200 px-2.5 py-1.5 rounded-lg transition-colors font-semibold">
                                        <Icon Name="triangle-exclamation" Class="h-4 w-4" />
                                    </button>
                                    <button @onclick="() => RemoveStrike(member)"
                                            disabled="@(member.StrikeCount == 0)"
                                            title="@(member.StrikeCount == 0 ? "This member has no strikes to remove" : "Remove strike")"
                                            aria-label="Remove strike"
                                            class="text-xs bg-green-100 text-green-700 hover:bg-green-200 px-2.5 py-1.5 rounded-lg transition-colors font-semibold disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-green-100">
                                        <Icon Name="rotate" Class="h-4 w-4" />
                                    </button>
                                    <button @onclick="() => OpenAssignTask(member)"
                                            title="Assign task" aria-label="Assign task"
                                            class="text-xs bg-blue-100 text-spe-blue hover:bg-blue-200 px-2.5 py-1.5 rounded-lg transition-colors font-semibold">
                                        <Icon Name="list-check" Class="h-4 w-4" />
                                    </button>
                                    <button @onclick="() => OpenEditMember(member)"
                                            title="Edit member" aria-label="Edit member"
                                            class="text-xs bg-slate-100 text-slate-700 hover:bg-slate-200 px-2.5 py-1.5 rounded-lg transition-colors font-semibold">
                                        <Icon Name="pen-to-square" Class="h-4 w-4" />
                                    </button>
                                    @if (member.Id != currentUserId)
                                    {
                                        <button @onclick="() => deleteTarget = member"
                                                title="Remove member" aria-label="Remove member"
                                                class="text-xs bg-red-100 text-red-700 hover:bg-red-200 px-2.5 py-1.5 rounded-lg transition-colors font-semibold">
                                            <Icon Name="user-minus" Class="h-4 w-4" />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ---------- Modal: assign task ---------- *@

@if (assignTaskMember is not null)
{
    <div class="spe-modal-backdrop">
        <div class="spe-modal-card">
            <h2 class="text-xl font-bold text-spe-blue mb-6">Assign Task</h2>
            <div class="flex flex-col gap-4">
                <input class="spe-input" placeholder="Task title" @bind="taskTitle" />
                <textarea class="spe-input" rows="3" placeholder="Description" @bind="taskDescription"></textarea>
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Deadline</label>
                    <input type="text" class="spe-input w-full" placeholder="DD/MM/YYYY"
                           value="@taskDeadlineString" @oninput="HandleDeadlineInput" maxlength="10" />
                    @if (deadlineParseError)
                    {
                        <p class="text-red-500 text-xs mt-1">Invalid date. Use DD/MM/YYYY (e.g. 25/07/2025)</p>
                    }
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button @onclick="ConfirmAssignTask"
                        class="flex-1 bg-spe-blue text-white font-bold py-2.5 rounded-lg hover:bg-blue-800 transition-colors">
                    Assign
                </button>
                <button @onclick="() => assignTaskMember = null"
                        class="flex-1 border border-slate-300 text-slate-600 font-semibold py-2.5 rounded-lg hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@* ---------- Modal: edit member ---------- *@

@if (editMember is not null)
{
    <div class="spe-modal-backdrop">
        <div class="spe-modal-card">
            <h2 class="text-xl font-bold text-spe-blue mb-6">Edit Member</h2>

            @if (!string.IsNullOrEmpty(editError))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
                    @editError
                </div>
            }

            @* Name and email are read-only: both come from the member's OpenWater record and
               are re-synced on every login, so editing them here would just be overwritten. *@
            <div class="mb-4 rounded-lg bg-slate-50 px-4 py-3">
                <p class="font-semibold text-slate-800">@editMember.FullName</p>
                <p class="text-xs text-slate-500">@editMember.Email</p>
                <p class="mt-2 text-xs text-slate-400">Name and email are synced from SPE membership records.</p>
            </div>

            <div class="flex flex-col gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Identity Role</label>
                    <select class="spe-input w-full" @bind="editIdentityRole">
                        <option value="Member">Member</option>
                        <option value="CommitteeMember">Committee Member</option>
                        <option value="TeamLeader">Team Leader</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Committee Title</label>
                    <input class="spe-input w-full" placeholder="e.g. Vice President, Secretary..."
                           @bind="editCommitteeTitle" />
                </div>
                <div>
                    <span class="block text-sm font-medium text-slate-600 mb-1">Teams</span>
                    <div class="space-y-1 rounded-lg border border-slate-300 p-3">
                        @foreach (var team in Data.Models.Teams.All)
                        {
                            <label @key="team" class="flex cursor-pointer items-center gap-2.5 rounded px-1 py-1 text-sm text-slate-700 hover:bg-slate-50">
                                <input type="checkbox" class="h-4 w-4 accent-spe-cobalt"
                                       checked="@editTeams.Contains(team)"
                                       @onchange="e => ToggleTeam(team, e)" />
                                @team.DisplayName()
                            </label>
                        }
                    </div>
                    <p class="mt-1 text-xs text-slate-500">
                        Tutorials are filed by team — a member with no team sees none of them.
                    </p>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button @onclick="ConfirmEditMember"
                        class="flex-1 bg-spe-blue text-white font-bold py-2.5 rounded-lg hover:bg-blue-800 transition-colors">
                    Save
                </button>
                <button @onclick="() => editMember = null"
                        class="flex-1 border border-slate-300 text-slate-600 font-semibold py-2.5 rounded-lg hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@* ---------- Modal: remove member ---------- *@

@if (deleteTarget is not null)
{
    <div class="spe-modal-backdrop">
        <div class="spe-modal-card">
            <h2 class="text-xl font-bold text-red-600 mb-4">Remove Member</h2>
            <p class="text-slate-600 mb-6">
                Are you sure you want to permanently remove <strong>@deleteTarget.FullName</strong> (@deleteTarget.Email)?
                This cannot be undone.
            </p>
            <div class="flex gap-3">
                <button @onclick="ConfirmDeleteMember"
                        class="flex-1 bg-red-600 text-white font-bold py-2.5 rounded-lg hover:bg-red-700 transition-colors">
                    Remove
                </button>
                <button @onclick="() => deleteTarget = null"
                        class="flex-1 border border-slate-300 text-slate-600 font-semibold py-2.5 rounded-lg hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}
</DesktopOnly>

@code {
    /* ---------- Page state ---------- */

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ApplicationUser>? members;
    private string? currentUserId;

    // Result of the last strike/task action, so the admin can see whether the member was actually emailed.
    private EmailResult? notification;
    private string notificationAction = "";

    /* ---------- Assign-task modal ---------- */

    private ApplicationUser? assignTaskMember;
    private string taskTitle = "";
    private string taskDescription = "";
    private string taskDeadlineString = "";
    private bool deadlineParseError;

    /* ---------- Edit-member modal ---------- */

    private ApplicationUser? editMember;
    private string editIdentityRole = "CommitteeMember";
    private string? editCommitteeTitle;
    private readonly HashSet<Team> editTeams = [];
    private string? editError;

    /* ---------- Remove-member modal ---------- */

    private ApplicationUser? deleteTarget;

    /* ---------- Lifecycle and actions ---------- */

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await AuthStateTask.GetUserIdAsync();
        members = await AdminSvc.GetAllMembersAsync();
    }

    /// <summary>One pass over a member's tasks instead of three separate LINQ Count() calls per render.</summary>
    private static (int Active, int Completed, int Failed) CountTasks(ApplicationUser member)
    {
        int active = 0, completed = 0, failed = 0;
        foreach (var task in member.AssignedTasks)
        {
            switch (task.Status)
            {
                case AssignmentStatus.Processing: active++; break;
                case AssignmentStatus.Completed: completed++; break;
                case AssignmentStatus.Failed: failed++; break;
            }
        }
        return (active, completed, failed);
    }

    private async Task AddStrike(ApplicationUser member)
    {
        notificationAction = "Strike added.";
        var (strikeCount, result) = await AdminSvc.AddStrikeAsync(member.Id);
        notification = result;
        if (strikeCount is int count) member.StrikeCount = count;
    }

    private async Task RemoveStrike(ApplicationUser member)
    {
        notificationAction = "Strike removed.";
        var (strikeCount, result) = await AdminSvc.RemoveStrikeAsync(member.Id);
        notification = result;
        if (strikeCount is int count) member.StrikeCount = count;
    }

    private void OpenAssignTask(ApplicationUser member)
    {
        notification = null;
        assignTaskMember = member;
        taskTitle = taskDescription = "";
        taskDeadlineString = UkTime.Now.AddDays(7).ToString("dd/MM/yyyy");
        deadlineParseError = false;
    }

    /// <summary>Reformats free typing into DD/MM/YYYY as the admin types.</summary>
    private void HandleDeadlineInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 8) digits = digits[..8];

        var formatted = new System.Text.StringBuilder(10);
        for (var i = 0; i < digits.Length; i++)
        {
            if (i == 2 || i == 4) formatted.Append('/');
            formatted.Append(digits[i]);
        }
        taskDeadlineString = formatted.ToString();
    }

    private async Task ConfirmAssignTask()
    {
        deadlineParseError = false;
        if (!DateTime.TryParseExact(taskDeadlineString, "dd/MM/yyyy",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var deadline))
        {
            deadlineParseError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(taskTitle) || assignTaskMember is null) return;

        var member = assignTaskMember;
        var (task, emailResult) = await AdminSvc.AssignTaskAsync(member.Id, taskTitle, taskDescription, deadline, currentUserId);

        // Keep the table's task counts current without re-reading every member.
        member.AssignedTasks.Add(task);

        notificationAction = $"Task \"{taskTitle}\" assigned.";
        notification = emailResult;
        assignTaskMember = null;
    }

    private async Task OpenEditMember(ApplicationUser member)
    {
        editMember = member;
        editCommitteeTitle = member.CommitteeTitle;
        editIdentityRole = await AdminSvc.GetPrimaryRoleAsync(member.Id);

        // Seeded from the row already loaded with the table, so opening the form costs no query.
        editTeams.Clear();
        foreach (var membership in member.Teams) editTeams.Add(membership.Team);

        editError = null;
    }

    private void ToggleTeam(Team team, ChangeEventArgs e)
    {
        if (e.Value is bool ticked && ticked) editTeams.Add(team);
        else editTeams.Remove(team);
    }

    private async Task ConfirmEditMember()
    {
        if (editMember is null) return;

        if (string.IsNullOrEmpty(currentUserId))
        {
            editError = "Current user context was not found.";
            return;
        }

        var member = editMember;
        var result = await AdminSvc.UpdateMemberDetailsAsync(
            currentUserId, member.Id, editIdentityRole, editCommitteeTitle, editTeams);

        if (!result.Succeeded)
        {
            editError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Only the title and teams are editable, so the alphabetical-by-name ordering can't change.
        member.CommitteeTitle = editCommitteeTitle;
        member.Teams = [.. editTeams.Select(t => new MemberTeam { UserId = member.Id, Team = t })];

        editMember = null;
    }

    private async Task ConfirmDeleteMember()
    {
        if (deleteTarget is null) return;

        var result = await AdminSvc.DeleteMemberAsync(deleteTarget.Id);
        if (result.Succeeded) members?.Remove(deleteTarget);

        deleteTarget = null;
    }
}
