@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,TeamLeader")]
@inject ProfileService ProfileSvc

<PageTitle>My Profile — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-[1200px]">
    @if (user is null)
    {
        <p class="text-slate-500">Loading profile...</p>
    }
    else
    {
        var total = user.AssignedTasks.Count;
        var done = user.AssignedTasks.Count(t => t.Status == AssignmentStatus.Completed);
        var failed = user.AssignedTasks.Count(t => t.Status == AssignmentStatus.Failed);
        var active = user.AssignedTasks.Count(t => t.Status == AssignmentStatus.Processing);

        <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
            <aside class="md:col-span-1">
                <section class="spe-card overflow-hidden border-slate-200">
                    <div class="p-6 text-center bg-spe-cobalt">
                        <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-full border-4 border-white/30 bg-white/20 text-xl font-bold text-white">
                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                        </div>
                        <p class="text-sm font-bold text-white font-heading">@user.FullName</p>
                        <p class="mt-0.5 text-xs text-white/70">@user.Email</p>
                    </div>
                    <div class="space-y-4 p-4">
                        <div>
                            <p class="mb-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-400">Committee Title</p>
                            @* Guarded: an unset title used to render as an empty coloured pill. *@
                            @if (string.IsNullOrWhiteSpace(user.CommitteeTitle))
                            {
                                <p class="text-sm text-slate-400">Not set</p>
                            }
                            else
                            {
                                <span class="inline-block rounded-full bg-spe-cobalt/10 px-3 py-1 text-xs font-semibold text-spe-cobalt">@user.CommitteeTitle</span>
                            }
                        </div>

                        <div>
                            <p class="mb-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-400">Identity Role</p>
                            <span class="inline-block rounded-full bg-spe-gold/15 px-3 py-1 text-xs font-semibold text-amber-700">@identityRole</span>
                        </div>

                        <div>
                            <p class="mb-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-400">Teams</p>
                            @if (user.Teams.Count == 0)
                            {
                                <p class="text-sm text-slate-400">No team assigned</p>
                            }
                            else
                            {
                                <div class="flex flex-col gap-1.5">
                                    @foreach (var membership in user.Teams.OrderBy(m => m.Team))
                                    {
                                        <span @key="membership.Team" class="inline-block rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">
                                            @membership.Team.DisplayName()
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(user.OpenWaterMemberId) || !string.IsNullOrWhiteSpace(user.OpenWaterOrganization))
                        {
                            <div class="space-y-1 border-t border-slate-100 pt-3">
                                @if (!string.IsNullOrWhiteSpace(user.OpenWaterMemberId))
                                {
                                    <p class="text-xs text-slate-500">Member ID: @user.OpenWaterMemberId</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(user.OpenWaterOrganization))
                                {
                                    <p class="text-xs text-slate-500">@user.OpenWaterOrganization</p>
                                }
                            </div>
                        }
                    </div>
                </section>
            </aside>

            <div class="space-y-6 md:col-span-3">
                <section class="spe-card border-slate-200 p-6">
                    <h1 class="mb-1 text-2xl font-extrabold text-black font-heading">Welcome back, @user.FullName.Split(" ").FirstOrDefault()</h1>
                    <p class="mb-6 text-sm text-slate-500">Member dashboard overview</p>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                        <div class="rounded-lg bg-slate-100 p-4 text-center">
                            <p class="text-2xl font-extrabold text-spe-cobalt font-heading">@active</p>
                            <p class="mt-1 text-xs text-slate-500">Active Tasks</p>
                        </div>
                        <div class="rounded-lg bg-slate-100 p-4 text-center">
                            <p class="text-2xl font-extrabold text-green-600 font-heading">@done</p>
                            <p class="mt-1 text-xs text-slate-500">Completed</p>
                        </div>
                        <div class="rounded-lg bg-slate-100 p-4 text-center">
                            <p class="text-2xl font-extrabold text-red-500 font-heading">@failed</p>
                            <p class="mt-1 text-xs text-slate-500">Failed</p>
                        </div>
                    </div>
                </section>

                <section class="spe-card border-slate-200 p-6">
                    <h2 class="mb-3 text-lg font-bold text-black font-heading">Strike Status</h2>
                    <div class="flex items-center justify-between rounded-lg bg-slate-50 p-4">
                        <div>
                            <p class="text-xs uppercase tracking-wider text-slate-500">Current count</p>
                            <p class="text-3xl font-extrabold @(user.StrikeCount >= 3 ? "text-red-500" : user.StrikeCount >= 1 ? "text-amber-500" : "text-green-500")">
                                @user.StrikeCount
                            </p>
                        </div>
                        <p class="text-sm @(user.StrikeCount >= 3 ? "text-red-500" : "text-slate-500")">
                            @(user.StrikeCount >= 3 ? "Action required" : "Good standing")
                        </p>
                    </div>
                    <p class="mt-3 text-xs text-slate-500">Total assigned tasks: @total</p>
                </section>

                <section class="spe-card border-slate-200 p-6">
                    <h2 class="mb-3 text-lg font-bold text-black font-heading">Email Notifications</h2>
                    <label class="flex cursor-pointer items-start justify-between gap-4 rounded-lg bg-slate-50 p-4">
                        <span>
                            <span class="block text-sm font-semibold text-slate-800">Send me notification emails</span>
                            <span class="mt-0.5 block text-xs text-slate-500">
                                Covers strikes, strike removals and task assignments. Turn this off and the
                                chapter will still record everything — you just won't be emailed about it.
                            </span>
                        </span>
                        @* sr-only checkbox + styled track: a real checkbox keeps keyboard focus and
                           the label association that a div-based switch would throw away. *@
                        <input type="checkbox" class="peer sr-only"
                               checked="@user.EmailNotificationsEnabled"
                               @onchange="ToggleEmailNotifications" />
                        <span class="relative mt-0.5 h-6 w-11 shrink-0 rounded-full bg-slate-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:bg-spe-cobalt peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-spe-cobalt peer-focus-visible:ring-offset-2"></span>
                    </label>
                    @if (preferenceError is not null)
                    {
                        <p class="mt-2 text-xs text-red-600">@preferenceError</p>
                    }
                </section>

                <section class="spe-card border-slate-200 p-6">
                    <div class="mb-5 flex items-center justify-between">
                        <h2 class="text-lg font-bold text-black font-heading">My Tasks</h2>
                        <a href="/tasks" class="text-sm font-semibold text-spe-cobalt hover:underline">View all</a>
                    </div>

                    @if (!user.AssignedTasks.Any())
                    {
                        <p class="py-6 text-center text-slate-400">No tasks assigned yet.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100">
                            @foreach (var task in user.AssignedTasks.OrderBy(t => t.Deadline).Take(5))
                            {
                                <div @key="task.Id" class="flex items-center justify-between py-4">
                                    <div>
                                        <p class="font-semibold text-slate-800">@task.Title</p>
                                        <p class="mt-0.5 text-xs text-slate-400">Due @task.Deadline.ToString("MMM d, yyyy")</p>
                                    </div>
                                    <span class="rounded-full px-3 py-1 text-xs font-bold @(task.Status == AssignmentStatus.Completed ? "bg-green-100 text-green-700" : task.Status == AssignmentStatus.Failed ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-700")">
                                        @task.Status
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ApplicationUser? user;
    private string identityRole = "Member";
    private string? preferenceError;

    protected override async Task OnInitializedAsync()
    {
        // Read from the signed-in principal rather than re-querying Identity: the roles are
        // already in the auth cookie, and this is the same source the [Authorize] check used.
        var principal = AuthStateTask is null ? null : (await AuthStateTask).User;
        identityRole = principal?.IsInRole("TeamLeader") == true ? "Team Leader"
            : principal?.IsInRole("CommitteeMember") == true ? "Committee Member"
            : "Member";

        var userId = await AuthStateTask.GetUserIdAsync();
        if (userId is not null)
            user = await ProfileSvc.GetByIdAsync(userId);
    }

    /// <summary>
    /// Saves the notification preference immediately — there is no Save button, so a toggle that
    /// only changed the local copy would look saved and not be. The in-memory user is updated to
    /// match only once the write succeeds, so a failure leaves the switch showing the real state.
    /// </summary>
    private async Task ToggleEmailNotifications(ChangeEventArgs e)
    {
        if (user is null) return;

        var enabled = e.Value is bool value && value;
        preferenceError = null;

        if (await ProfileSvc.SetEmailNotificationsAsync(user.Id, enabled))
            user.EmailNotificationsEnabled = enabled;
        else
            preferenceError = "Could not save that preference. Please reload the page and try again.";
    }
}
