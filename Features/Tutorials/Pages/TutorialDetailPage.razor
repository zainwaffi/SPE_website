@page "/tutorials/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,TeamLeader")]
@inject TutorialService TutorialSvc

<PageTitle>@(tutorial?.Title ?? "Tutorial") — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-4xl">
    <a href="/tutorials" class="spe-back-btn mb-6">
        <Icon Name="circle-chevron-left" Class="h-4 w-4 shrink-0" />
        Back to Tutorials
    </a>

    @if (loading)
    {
        <p class="py-20 text-center text-slate-500">Loading...</p>
    }
    else if (tutorial is null)
    {
        @* Deliberately the same message whether it was deleted or belongs to another team —
           a distinct "no access" page would confirm that a given id exists. *@
        <div class="py-20 text-center">
            <h1 class="spe-page-title">Tutorial not found</h1>
            <p class="mt-2 text-sm text-slate-600">It may have been deleted, or it belongs to a team you're not in.</p>
        </div>
    }
    else
    {
        <article class="spe-card border-slate-200 p-8">
            <p class="spe-page-kicker">
                @(tutorial.Teams.Count == 0
                    ? "Tutorial"
                    : string.Join(" · ", tutorial.Teams.Select(t => t.Team.DisplayName())))
            </p>
            <h1 class="font-heading text-3xl font-extrabold text-black">@tutorial.Title</h1>

            @if (!string.IsNullOrWhiteSpace(tutorial.Description))
            {
                <p class="mt-3 text-lg text-slate-600">@tutorial.Description</p>
            }

            <p class="mt-2 text-sm text-slate-400">
                Added @tutorial.CreatedAt.ToString("d MMMM yyyy")
            </p>

            <hr class="my-8 border-slate-200" />

            @if (tutorial.Format == TutorialFormat.Video)
            {
                @* A video tutorial has no article body, so play it here rather than showing
                   an empty page to anyone who lands on this URL directly. *@
                <div class="aspect-video overflow-hidden rounded-xl">
                    <iframe src="@tutorial.YoutubeEmbedUrl"
                            class="h-full w-full"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            }
            else
            {
                <Markdown Content="@tutorial.ArticleContent" />
            }
        </article>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Parameter]
    public int Id { get; set; }

    private Tutorial? tutorial;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        // The list page filters by team, but this URL is guessable, so the check is repeated
        // here — in the service, where both pages share one definition of "allowed to see".
        var authState = AuthStateTask is null ? null : await AuthStateTask;
        var seesAllTeams = authState?.User.IsInRole("TeamLeader") ?? false;
        var userId = await AuthStateTask.GetUserIdAsync();

        if (userId is not null)
            tutorial = await TutorialSvc.GetByIdForMemberAsync(Id, userId, seesAllTeams);

        loading = false;
    }
}
