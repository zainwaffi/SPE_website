@page "/tutorials"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,TeamLeader")]
@inject TutorialService TutorialSvc

<PageTitle>Tutorials — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-300">
    @* ---------- Heading ---------- *@

    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="spe-page-kicker">Tutorials & Courses</p>
            <h1 class="spe-page-title">Learning Library</h1>
            <p class="mt-2 text-sm text-slate-600">Guides and tutorials for SPE practices and professional development.</p>
        </div>
        <AuthorizeView Roles="TeamLeader">
            <Authorized>
                <button @onclick="OpenForm" class="spe-gold-btn">+ Add Tutorial</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @* ---------- New tutorial form (Team Leader only) ---------- *@

    @if (showForm)
    {
        <section class="spe-card mb-8 p-6">
            <h2 class="mb-4 font-heading text-xl font-semibold text-spe-cobalt">New Tutorial</h2>

            @* Format is chosen first, because it decides which fields below apply. *@
            <div class="mb-5">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Format</p>
                <div class="flex gap-2">
                    @foreach (var format in Formats)
                    {
                        <button type="button" @key="format" @onclick="() => newFormat = format"
                                aria-pressed="@(newFormat == format)"
                                class="inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-semibold transition-colors @(newFormat == format
                                        ? "border-spe-cobalt bg-spe-cobalt text-white"
                                        : "border-slate-300 text-slate-600 hover:bg-slate-50")">
                            <Icon Name="@(format == TutorialFormat.Video ? "globe" : "book")" Class="h-4 w-4" />
                            @(format == TutorialFormat.Video ? "YouTube video" : "Written article")
                        </button>
                    }
                </div>
            </div>

            @* Teams decide who can see this, so the picker sits with the other required fields
               rather than being tucked under the format toggle. *@
            <div class="mb-5">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Teams</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var team in Data.Models.Teams.All)
                    {
                        <button type="button" @key="team" @onclick="() => ToggleTeam(team)"
                                aria-pressed="@newTeams.Contains(team)"
                                class="rounded-lg border px-4 py-2 text-sm font-semibold transition-colors @(newTeams.Contains(team)
                                        ? "border-spe-cobalt bg-spe-cobalt text-white"
                                        : "border-slate-300 text-slate-600 hover:bg-slate-50")">
                            @team.DisplayName()
                        </button>
                    }
                </div>
                <p class="mt-1.5 text-xs text-slate-500">Pick every team that should see this tutorial.</p>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <input class="spe-input sm:col-span-2" placeholder="Title" @bind="newTitle" />

                <textarea class="spe-input sm:col-span-2" rows="2"
                          placeholder="Short summary shown on the card" @bind="newDescription"></textarea>

                @if (newFormat == TutorialFormat.Video)
                {
                    <input class="spe-input sm:col-span-2"
                           placeholder="YouTube URL (watch, youtu.be, Shorts or embed)" @bind="newYoutubeUrl" />
                }
                else
                {
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-600" for="tutorial-body">
                            Article body
                        </label>
                        <textarea id="tutorial-body" class="spe-input w-full font-mono text-sm" rows="14"
                                  placeholder="@MarkdownPlaceholder" @bind="newArticleContent"></textarea>
                        <p class="mt-1.5 text-xs text-slate-500">
                            <a href="https://www.markdownguide.org/cheat-sheet/" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-blue-500">Markdown cheat sheet, Supports:</a><code>## Heading</code>, <code>- bullet</code>,
                            <code>[link](https://example.com)</code>, <code>**bold**</code> .
                        </p>
                    </div>
                }
            </div>

            @if (formError is not null)
            {
                <p class="mt-3 text-sm text-red-500">@formError</p>
            }

            <div class="mt-4 flex gap-3">
                <button @onclick="SaveTutorial" class="spe-primary-btn">Save</button>
                <button @onclick="() => showForm = false"
                        class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">
                    Cancel
                </button>
            </div>
        </section>
    }

    @* ---------- Tutorial list ---------- *@

    @if (!loaded)
    {
        <p class="py-20 text-center text-slate-500">Loading tutorials...</p>
    }
    else if (!seesAllTeams && memberTeams.Count == 0)
    {
        @* Distinct from "no tutorials": nothing is missing, they just haven't been allocated
           to a team yet, and only a Team Leader can fix that. *@
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl text-slate-400">You're not in a team yet.</p>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
                Tutorials are shared with each team separately. Ask a Team Leader to add you to a
                team and they'll appear here.
            </p>
        </div>
    }
    else if (grouped is null || grouped.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl text-slate-400">No tutorials yet.</p>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <section @key="group.Team" class="mb-10">
                <h2 class="mb-4 border-b border-slate-200 pb-2 text-xl font-bold text-slate-700">@group.Team.DisplayName()</h2>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    @foreach (var t in group.Tutorials)
                    {
                        @* A right-click inside the YouTube iframe belongs to YouTube and never
                           reaches this handler; the card body around it is the way in. *@
                        <article @key="t.Id"
                                 @oncontextmenu="e => OpenMenu(e, t)"
                                 @oncontextmenu:preventDefault="canManage"
                                 class="spe-card overflow-hidden border-slate-200 transition-shadow hover:shadow-lg">
                            @if (t.Format == TutorialFormat.Video && !string.IsNullOrEmpty(t.YoutubeEmbedUrl))
                            {
                                <div class="aspect-video">
                                    <iframe src="@t.YoutubeEmbedUrl"
                                            class="h-full w-full"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                </div>
                            }
                            else if (t.Format == TutorialFormat.Article)
                            {
                                @* Articles have no thumbnail, so the banner doubles as the affordance
                                   that this one opens rather than plays. *@
                                <a href="/tutorials/@t.Id" @oncontextmenu:stopPropagation="true"
                                   class="flex aspect-video items-center justify-center bg-gradient-to-br from-spe-cobalt to-spe-endeavor transition-opacity hover:opacity-90">
                                    <span class="flex flex-col items-center gap-2 text-white">
                                        <Icon Name="book" Class="h-8 w-8" />
                                        <span class="text-xs font-bold uppercase tracking-widest">Read article</span>
                                    </span>
                                </a>
                            }

                            <div class="p-5">
                                <div class="mb-1 flex items-start justify-between gap-3">
                                    <h3 class="font-heading text-base font-bold text-black">@t.Title</h3>
                                    <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                        @(t.Format == TutorialFormat.Video ? "Video" : "Article")
                                    </span>
                                </div>
                                <p class="text-sm text-slate-600">@t.Description</p>

                                @if (t.Format == TutorialFormat.Article)
                                {
                                    @* Same reason as the banner above: "open in new tab" on a
                                       tutorial is worth more than Update/Delete, which the rest
                                       of the card still offers. *@
                                    <a href="/tutorials/@t.Id" @oncontextmenu:stopPropagation="true"
                                       class="mt-3 inline-block text-sm font-semibold text-spe-cobalt hover:underline">
                                        Read article
                                    </a>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }

    @* ---------- Team Leader: right-click menu, edit dialog, delete confirmation ---------- *@

    @* The right-click menu is the only route to Update and Delete, and deleting always goes
       through the confirmation below — the inline Delete link that used to sit on each card
       removed a tutorial on a single stray click. Same audience as the Add Tutorial button:
       Team Leaders, who author this content. *@

    @if (menuTutorial is not null)
    {
        <ContextMenu X="menuX" Y="menuY" Label="@menuTutorial.Title"
                     OnUpdate="StartEdit" OnDelete="StartDelete" OnClose="CloseMenu" />
    }

    @if (editTutorial is not null)
    {
        @* The fields repeat the add form above rather than sharing markup with it. Threading a
           dozen two-way bindings through a shared component costs more than the repetition, and
           the two forms are not the same shape anyway: this one is a dialog over a page the
           editor was already reading, and it drops the add form's "pick every team" hint for a
           set that is already chosen. *@
        <div class="spe-modal-backdrop" @onclick="CancelEdit">
            <div class="spe-modal-card max-w-2xl" @onclick:stopPropagation="true">
                <h2 class="mb-6 font-heading text-xl font-bold text-spe-cobalt">Edit Tutorial</h2>

                <div class="mb-5">
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Format</p>
                    <div class="flex gap-2">
                        @foreach (var format in Formats)
                        {
                            <button type="button" @key="format" @onclick="() => editFormat = format"
                                    aria-pressed="@(editFormat == format)"
                                    class="inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-semibold transition-colors @(editFormat == format
                                            ? "border-spe-cobalt bg-spe-cobalt text-white"
                                            : "border-slate-300 text-slate-600 hover:bg-slate-50")">
                                <Icon Name="@(format == TutorialFormat.Video ? "globe" : "book")" Class="h-4 w-4" />
                                @(format == TutorialFormat.Video ? "YouTube video" : "Written article")
                            </button>
                        }
                    </div>
                </div>

                <div class="mb-5">
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Teams</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var team in Data.Models.Teams.All)
                        {
                            <button type="button" @key="team" @onclick="() => ToggleEditTeam(team)"
                                    aria-pressed="@editTeams.Contains(team)"
                                    class="rounded-lg border px-4 py-2 text-sm font-semibold transition-colors @(editTeams.Contains(team)
                                            ? "border-spe-cobalt bg-spe-cobalt text-white"
                                            : "border-slate-300 text-slate-600 hover:bg-slate-50")">
                                @team.DisplayName()
                            </button>
                        }
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    <input class="spe-input" placeholder="Title" @bind="editTitle" />

                    <textarea class="spe-input" rows="2"
                              placeholder="Short summary shown on the card" @bind="editDescription"></textarea>

                    @if (editFormat == TutorialFormat.Video)
                    {
                        <input class="spe-input"
                               placeholder="YouTube URL (watch, youtu.be, Shorts or embed)" @bind="editYoutubeUrl" />
                    }
                    else
                    {
                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-600" for="tutorial-edit-body">
                                Article body
                            </label>
                            <textarea id="tutorial-edit-body" class="spe-input w-full font-mono text-sm" rows="12"
                                      placeholder="@MarkdownPlaceholder" @bind="editArticleContent"></textarea>
                        </div>
                    }
                </div>

                @if (editError is not null)
                {
                    <p class="mt-3 text-sm text-red-500">@editError</p>
                }

                <div class="mt-6 flex gap-3">
                    <button @onclick="SaveEdit" class="spe-primary-btn flex-1">Save changes</button>
                    <button @onclick="CancelEdit"
                            class="flex-1 rounded-lg border border-slate-300 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (deleteTutorial is not null)
    {
        <ConfirmDialog Title="Delete this tutorial?"
                       Message="@($"“{deleteTutorial.Title}” will be removed for every team it is filed under. This cannot be undone.")"
                       OnConfirm="ConfirmDelete" OnCancel="() => deleteTutorial = null" />
    }
</div>

@code {
    private static readonly TutorialFormat[] Formats = Enum.GetValues<TutorialFormat>();

    private const string MarkdownPlaceholder = """
        ## Getting started

        A short intro paragraph.

        - First step
        - Second step

        See the [SPE handbook](https://www.spe.org) for more.
        """;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    // Sections in team order, so the page reads the same way every visit. A tutorial filed under
    // several teams appears under each of them.
    private List<(Team Team, List<Tutorial> Tutorials)>? grouped;
    private List<Team> memberTeams = [];
    private bool seesAllTeams;
    private bool loaded;

    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newYoutubeUrl = "";
    private string newArticleContent = "";
    private readonly HashSet<Team> newTeams = [];
    private TutorialFormat newFormat = TutorialFormat.Video;
    private string? formError;

    /* ---------- Team Leader: right-click update/delete ---------- */

    private bool canManage;

    private Tutorial? menuTutorial;
    private double menuX, menuY;

    private Tutorial? editTutorial;
    private string editTitle = "";
    private string editDescription = "";
    private string editYoutubeUrl = "";
    private string editArticleContent = "";
    private readonly HashSet<Team> editTeams = [];
    private TutorialFormat editFormat = TutorialFormat.Video;
    private string? editError;

    private Tutorial? deleteTutorial;

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthStateTask is null ? null : await AuthStateTask;

        // Both are "is a Team Leader" today, but they answer different questions — one is about
        // which tutorials are visible, the other about who may edit them — so the page keeps them
        // apart rather than reading one flag for both.
        var isTeamLeader = authState?.User.IsInRole("TeamLeader") ?? false;
        seesAllTeams = isTeamLeader;
        canManage = isTeamLeader;

        await LoadTutorials();
    }

    private async Task LoadTutorials()
    {
        var userId = await AuthStateTask.GetUserIdAsync();
        if (userId is null) return;

        var visible = await TutorialSvc.GetVisibleToMemberAsync(userId, seesAllTeams);
        memberTeams = visible.MemberTeams;

        grouped = [.. Data.Models.Teams.All
            .Select(team => (Team: team, Tutorials: visible.Tutorials
                                                          .Where(t => t.Teams.Any(tt => tt.Team == team))
                                                          .ToList()))
            .Where(section => section.Tutorials.Count > 0)];

        loaded = true;
    }

    private void OpenForm()
    {
        showForm = true;
        formError = null;
    }

    private void ToggleTeam(Team team)
    {
        if (!newTeams.Remove(team)) newTeams.Add(team);
    }

    private async Task SaveTutorial()
    {
        formError = null;

        if (string.IsNullOrWhiteSpace(newTitle))
        {
            formError = "Give the tutorial a title.";
            return;
        }

        // A tutorial with no team is invisible to every member, so refuse it rather than
        // silently creating something only Team Leaders will ever see.
        if (newTeams.Count == 0)
        {
            formError = "Pick at least one team that should see this tutorial.";
            return;
        }

        // Each format has its own required field; without this an article could be saved with
        // no body, leaving a card that opens onto an empty page.
        string? embedUrl = null;
        if (newFormat == TutorialFormat.Video)
        {
            if (string.IsNullOrWhiteSpace(newYoutubeUrl))
            {
                formError = "Add the YouTube link, or switch to a written article.";
                return;
            }

            // Whatever they pasted — watch, youtu.be, Shorts or embed — is normalised here, so
            // an unusable link is caught at save time instead of rendering as a blank card.
            embedUrl = YouTubeUrl.ToEmbedUrl(newYoutubeUrl);
            if (embedUrl is null)
            {
                formError = "That doesn't look like a YouTube link. Paste the URL from the address bar or the Share button.";
                return;
            }
        }

        if (newFormat == TutorialFormat.Article && string.IsNullOrWhiteSpace(newArticleContent))
        {
            formError = "Write the article body, or switch to a YouTube video.";
            return;
        }

        await TutorialSvc.CreateAsync(new Tutorial
        {
            Title = newTitle,
            Description = newDescription,
            Format = newFormat,
            YoutubeEmbedUrl = embedUrl ?? "",
            ArticleContent = newFormat == TutorialFormat.Article ? newArticleContent : ""
        }, newTeams);

        showForm = false;
        newTitle = newDescription = newYoutubeUrl = newArticleContent = "";
        newTeams.Clear();
        newFormat = TutorialFormat.Video;
        await LoadTutorials();
    }

    /* ---------- Team Leader: right-click update/delete ---------- */

    /// <summary>
    /// Opens the context menu over the card. Does nothing for a member without edit rights,
    /// whose browser then keeps its own right-click menu — the markup pairs this with
    /// <c>@@oncontextmenu:preventDefault="canManage"</c> so the two agree.
    /// </summary>
    private void OpenMenu(MouseEventArgs e, Tutorial tutorial)
    {
        if (!canManage) return;

        menuTutorial = tutorial;
        (menuX, menuY) = (e.ClientX, e.ClientY);
    }

    private void CloseMenu() => menuTutorial = null;

    private void StartEdit()
    {
        if (menuTutorial is null) return;

        editTutorial = menuTutorial;
        editTitle = editTutorial.Title;
        editDescription = editTutorial.Description;
        editFormat = editTutorial.Format;
        editYoutubeUrl = editTutorial.YoutubeEmbedUrl;
        editArticleContent = editTutorial.ArticleContent;

        editTeams.Clear();
        foreach (var filing in editTutorial.Teams) editTeams.Add(filing.Team);

        editError = null;
        CloseMenu();
    }

    private void ToggleEditTeam(Team team)
    {
        if (!editTeams.Remove(team)) editTeams.Add(team);
    }

    /// <summary>
    /// Saves the edit. The validation deliberately matches <see cref="SaveTutorial"/> field for
    /// field: an edit can leave a tutorial in any of the states the add form refuses to create —
    /// untitled, unfiled, or switched to a format whose content was never filled in.
    /// </summary>
    private async Task SaveEdit()
    {
        if (editTutorial is null) return;

        editError = null;

        if (string.IsNullOrWhiteSpace(editTitle))
        {
            editError = "Give the tutorial a title.";
            return;
        }

        if (editTeams.Count == 0)
        {
            editError = "Pick at least one team that should see this tutorial.";
            return;
        }

        string embedUrl = "";
        if (editFormat == TutorialFormat.Video)
        {
            if (string.IsNullOrWhiteSpace(editYoutubeUrl))
            {
                editError = "Add the YouTube link, or switch to a written article.";
                return;
            }

            var normalised = YouTubeUrl.ToEmbedUrl(editYoutubeUrl);
            if (normalised is null)
            {
                editError = "That doesn't look like a YouTube link. Paste the URL from the address bar or the Share button.";
                return;
            }

            embedUrl = normalised;
        }

        if (editFormat == TutorialFormat.Article && string.IsNullOrWhiteSpace(editArticleContent))
        {
            editError = "Write the article body, or switch to a YouTube video.";
            return;
        }

        await TutorialSvc.UpdateAsync(
            editTutorial.Id, editTitle, editDescription, editFormat,
            embedUrl, editArticleContent, editTeams);

        editTutorial = null;
        await LoadTutorials();
    }

    private void CancelEdit()
    {
        editTutorial = null;
        editError = null;
    }

    private void StartDelete()
    {
        deleteTutorial = menuTutorial;
        CloseMenu();
    }

    private async Task ConfirmDelete()
    {
        if (deleteTutorial is null) return;

        var id = deleteTutorial.Id;
        deleteTutorial = null;

        await TutorialSvc.DeleteAsync(id);
        await LoadTutorials();
    }
}
