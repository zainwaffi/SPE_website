@page "/tutorials"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,TeamLeader")]
@inject TutorialService TutorialSvc

<PageTitle>Tutorials — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-300">
    @* ---------- Heading ---------- *@

    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="spe-page-kicker">Tutorials & Courses</p>
            <h1 class="spe-page-title">Learning Library</h1>
            <p class="mt-2 text-sm text-slate-600">Guides and tutorials for SPE practices and professional development.</p>
        </div>
        <AuthorizeView Roles="TeamLeader">
            <Authorized>
                <button @onclick="OpenForm" class="spe-gold-btn">+ Add Tutorial</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @* ---------- New tutorial form (Team Leader only) ---------- *@

    @if (showForm)
    {
        <section class="spe-card mb-8 p-6">
            <h2 class="mb-4 font-heading text-xl font-semibold text-spe-cobalt">New Tutorial</h2>

            @* Format is chosen first, because it decides which fields below apply. *@
            <div class="mb-5">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Format</p>
                <div class="flex gap-2">
                    @foreach (var format in Formats)
                    {
                        <button type="button" @key="format" @onclick="() => newFormat = format"
                                aria-pressed="@(newFormat == format)"
                                class="inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-semibold transition-colors @(newFormat == format
                                        ? "border-spe-cobalt bg-spe-cobalt text-white"
                                        : "border-slate-300 text-slate-600 hover:bg-slate-50")">
                            <Icon Name="@(format == TutorialFormat.Video ? "globe" : "book")" Class="h-4 w-4" />
                            @(format == TutorialFormat.Video ? "YouTube video" : "Written article")
                        </button>
                    }
                </div>
            </div>

            @* Teams decide who can see this, so the picker sits with the other required fields
               rather than being tucked under the format toggle. *@
            <div class="mb-5">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Teams</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var team in Data.Models.Teams.All)
                    {
                        <button type="button" @key="team" @onclick="() => ToggleTeam(team)"
                                aria-pressed="@newTeams.Contains(team)"
                                class="rounded-lg border px-4 py-2 text-sm font-semibold transition-colors @(newTeams.Contains(team)
                                        ? "border-spe-cobalt bg-spe-cobalt text-white"
                                        : "border-slate-300 text-slate-600 hover:bg-slate-50")">
                            @team.DisplayName()
                        </button>
                    }
                </div>
                <p class="mt-1.5 text-xs text-slate-500">Pick every team that should see this tutorial.</p>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <input class="spe-input sm:col-span-2" placeholder="Title" @bind="newTitle" />

                <textarea class="spe-input sm:col-span-2" rows="2"
                          placeholder="Short summary shown on the card" @bind="newDescription"></textarea>

                @if (newFormat == TutorialFormat.Video)
                {
                    <input class="spe-input sm:col-span-2"
                           placeholder="YouTube URL (watch, youtu.be, Shorts or embed)" @bind="newYoutubeUrl" />
                }
                else
                {
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-slate-600" for="tutorial-body">
                            Article body
                        </label>
                        <textarea id="tutorial-body" class="spe-input w-full font-mono text-sm" rows="14"
                                  placeholder="@MarkdownPlaceholder" @bind="newArticleContent"></textarea>
                        <p class="mt-1.5 text-xs text-slate-500">
                            <a href="https://www.markdownguide.org/cheat-sheet/" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-blue-500">Markdown cheat sheet, Supports:</a><code>## Heading</code>, <code>- bullet</code>,
                            <code>[link](https://example.com)</code>, <code>**bold**</code> .
                        </p>
                    </div>
                }
            </div>

            @if (formError is not null)
            {
                <p class="mt-3 text-sm text-red-500">@formError</p>
            }

            <div class="mt-4 flex gap-3">
                <button @onclick="SaveTutorial" class="spe-primary-btn">Save</button>
                <button @onclick="() => showForm = false"
                        class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">
                    Cancel
                </button>
            </div>
        </section>
    }

    @* ---------- Tutorial list ---------- *@

    @if (!loaded)
    {
        <p class="py-20 text-center text-slate-500">Loading tutorials...</p>
    }
    else if (!seesAllTeams && memberTeams.Count == 0)
    {
        @* Distinct from "no tutorials": nothing is missing, they just haven't been allocated
           to a team yet, and only a Team Leader can fix that. *@
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl text-slate-400">You're not in a team yet.</p>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
                Tutorials are shared with each team separately. Ask a Team Leader to add you to a
                team and they'll appear here.
            </p>
        </div>
    }
    else if (grouped is null || grouped.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl text-slate-400">No tutorials yet.</p>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <section @key="group.Team" class="mb-10">
                <h2 class="mb-4 border-b border-slate-200 pb-2 text-xl font-bold text-slate-700">@group.Team.DisplayName()</h2>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    @foreach (var t in group.Tutorials)
                    {
                        <article @key="t.Id" class="spe-card overflow-hidden border-slate-200 transition-shadow hover:shadow-lg">
                            @if (t.Format == TutorialFormat.Video && !string.IsNullOrEmpty(t.YoutubeEmbedUrl))
                            {
                                <div class="aspect-video">
                                    <iframe src="@t.YoutubeEmbedUrl"
                                            class="h-full w-full"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                </div>
                            }
                            else if (t.Format == TutorialFormat.Article)
                            {
                                @* Articles have no thumbnail, so the banner doubles as the affordance
                                   that this one opens rather than plays. *@
                                <a href="/tutorials/@t.Id"
                                   class="flex aspect-video items-center justify-center bg-gradient-to-br from-spe-cobalt to-spe-endeavor transition-opacity hover:opacity-90">
                                    <span class="flex flex-col items-center gap-2 text-white">
                                        <Icon Name="book" Class="h-8 w-8" />
                                        <span class="text-xs font-bold uppercase tracking-widest">Read article</span>
                                    </span>
                                </a>
                            }

                            <div class="p-5">
                                <div class="mb-1 flex items-start justify-between gap-3">
                                    <h3 class="font-heading text-base font-bold text-black">@t.Title</h3>
                                    <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                        @(t.Format == TutorialFormat.Video ? "Video" : "Article")
                                    </span>
                                </div>
                                <p class="text-sm text-slate-600">@t.Description</p>

                                @if (t.Format == TutorialFormat.Article)
                                {
                                    <a href="/tutorials/@t.Id" class="mt-3 inline-block text-sm font-semibold text-spe-cobalt hover:underline">
                                        Read article
                                    </a>
                                }

                                <AuthorizeView Roles="TeamLeader">
                                    <Authorized>
                                        <button @onclick="() => DeleteTutorial(t.Id)"
                                                class="mt-3 block text-xs font-medium text-red-400 transition-colors hover:text-red-600">
                                            Delete
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private static readonly TutorialFormat[] Formats = Enum.GetValues<TutorialFormat>();

    private const string MarkdownPlaceholder = """
        ## Getting started

        A short intro paragraph.

        - First step
        - Second step

        See the [SPE handbook](https://www.spe.org) for more.
        """;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    // Sections in team order, so the page reads the same way every visit. A tutorial filed under
    // several teams appears under each of them.
    private List<(Team Team, List<Tutorial> Tutorials)>? grouped;
    private List<Team> memberTeams = [];
    private bool seesAllTeams;
    private bool loaded;

    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newYoutubeUrl = "";
    private string newArticleContent = "";
    private readonly HashSet<Team> newTeams = [];
    private TutorialFormat newFormat = TutorialFormat.Video;
    private string? formError;

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthStateTask is null ? null : await AuthStateTask;
        seesAllTeams = authState?.User.IsInRole("TeamLeader") ?? false;
        await LoadTutorials();
    }

    private async Task LoadTutorials()
    {
        var userId = await AuthStateTask.GetUserIdAsync();
        if (userId is null) return;

        var visible = await TutorialSvc.GetVisibleToMemberAsync(userId, seesAllTeams);
        memberTeams = visible.MemberTeams;

        grouped = [.. Data.Models.Teams.All
            .Select(team => (Team: team, Tutorials: visible.Tutorials
                                                          .Where(t => t.Teams.Any(tt => tt.Team == team))
                                                          .ToList()))
            .Where(section => section.Tutorials.Count > 0)];

        loaded = true;
    }

    private void OpenForm()
    {
        showForm = true;
        formError = null;
    }

    private void ToggleTeam(Team team)
    {
        if (!newTeams.Remove(team)) newTeams.Add(team);
    }

    private async Task SaveTutorial()
    {
        formError = null;

        if (string.IsNullOrWhiteSpace(newTitle))
        {
            formError = "Give the tutorial a title.";
            return;
        }

        // A tutorial with no team is invisible to every member, so refuse it rather than
        // silently creating something only Team Leaders will ever see.
        if (newTeams.Count == 0)
        {
            formError = "Pick at least one team that should see this tutorial.";
            return;
        }

        // Each format has its own required field; without this an article could be saved with
        // no body, leaving a card that opens onto an empty page.
        string? embedUrl = null;
        if (newFormat == TutorialFormat.Video)
        {
            if (string.IsNullOrWhiteSpace(newYoutubeUrl))
            {
                formError = "Add the YouTube link, or switch to a written article.";
                return;
            }

            // Whatever they pasted — watch, youtu.be, Shorts or embed — is normalised here, so
            // an unusable link is caught at save time instead of rendering as a blank card.
            embedUrl = YouTubeUrl.ToEmbedUrl(newYoutubeUrl);
            if (embedUrl is null)
            {
                formError = "That doesn't look like a YouTube link. Paste the URL from the address bar or the Share button.";
                return;
            }
        }

        if (newFormat == TutorialFormat.Article && string.IsNullOrWhiteSpace(newArticleContent))
        {
            formError = "Write the article body, or switch to a YouTube video.";
            return;
        }

        await TutorialSvc.CreateAsync(new Tutorial
        {
            Title = newTitle,
            Description = newDescription,
            Format = newFormat,
            YoutubeEmbedUrl = embedUrl ?? "",
            ArticleContent = newFormat == TutorialFormat.Article ? newArticleContent : ""
        }, newTeams);

        showForm = false;
        newTitle = newDescription = newYoutubeUrl = newArticleContent = "";
        newTeams.Clear();
        newFormat = TutorialFormat.Video;
        await LoadTutorials();
    }

    private async Task DeleteTutorial(int id)
    {
        await TutorialSvc.DeleteAsync(id);
        await LoadTutorials();
    }
}
