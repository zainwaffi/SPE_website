@page "/tutorials"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,President")]
@inject TutorialService TutorialSvc

<PageTitle>Tutorials — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-[1200px]">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="spe-page-kicker">Tutorials & Courses</p>
            <h1 class="spe-page-title">Technical Learning Library</h1>
            <p class="mt-2 text-sm text-slate-600">Role-based SOP and learning content for committee members.</p>
        </div>
        <AuthorizeView Roles="President">
            <Authorized>
                <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add Tutorial</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <section class="spe-card mb-8 p-6">
            <h2 class="mb-4 text-xl font-semibold text-spe-cobalt" style="font-family:Montserrat, sans-serif;">New Tutorial</h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <input class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                       placeholder="Title" @bind="newTitle" />
                <select class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt" @bind="newRole">
                    @foreach (var role in Enum.GetValues<CommitteeRole>())
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <input class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt sm:col-span-2"
                       placeholder="YouTube Embed URL (https://www.youtube.com/embed/...)" @bind="newYoutubeUrl" />
                <textarea class="rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt sm:col-span-2"
                          rows="2" placeholder="Description" @bind="newDescription"></textarea>
            </div>
            <div class="mt-4 flex gap-3">
                <button @onclick="SaveTutorial" class="spe-primary-btn">Save</button>
                <button @onclick="() => showForm = false" class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
            </div>
        </section>
    }

    @if (grouped is null)
    {
        <p class="py-20 text-center text-slate-500">Loading tutorials...</p>
    }
    else if (!grouped.Any())
    {
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl text-slate-400">No tutorials yet.</p>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <section class="mb-10">
                <h2 class="mb-4 border-b border-slate-200 pb-2 text-xl font-bold text-slate-700">@group.Key.ToString()</h2>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    @foreach (var t in group.Value)
                    {
                        <article class="spe-card overflow-hidden border-slate-200 transition-shadow hover:shadow-lg">
                            @if (!string.IsNullOrEmpty(t.YoutubeEmbedUrl))
                            {
                                <div class="aspect-video">
                                    <iframe src="@t.YoutubeEmbedUrl"
                                            class="h-full w-full"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                </div>
                            }
                            <div class="p-5">
                                <h3 class="mb-1 text-base font-bold text-black" style="font-family:Montserrat, sans-serif;">@t.Title</h3>
                                <p class="text-sm text-slate-600">@t.Description</p>
                                <AuthorizeView Roles="President">
                                    <Authorized>
                                        <button @onclick="() => DeleteTutorial(t.Id)"
                                                class="mt-3 text-xs font-medium text-red-400 transition-colors hover:text-red-600">
                                            Delete
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private Dictionary<CommitteeRole, List<Tutorial>>? grouped;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newYoutubeUrl = "";
    private CommitteeRole newRole = CommitteeRole.Member;

    protected override async Task OnInitializedAsync() => await LoadTutorials();

    private async Task LoadTutorials()
    {
        var all = await TutorialSvc.GetAllAsync();
        grouped = all.GroupBy(t => t.CategoryRole)
                     .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task SaveTutorial()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await TutorialSvc.CreateAsync(new Tutorial
        {
            Title = newTitle,
            Description = newDescription,
            YoutubeEmbedUrl = newYoutubeUrl,
            CategoryRole = newRole
        });
        showForm = false;
        newTitle = newDescription = newYoutubeUrl = "";
        await LoadTutorials();
    }

    private async Task DeleteTutorial(int id)
    {
        await TutorialSvc.DeleteAsync(id);
        await LoadTutorials();
    }
}
