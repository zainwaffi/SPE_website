@page "/events/{Id:int}/attendees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,TeamLeader")]
@inject EventService EventSvc
@inject NavigationManager Nav

@* Deliberately NOT wrapped in <DesktopOnly>: unlike the admin dashboard, this is the one
   admin-ish screen you genuinely want on a phone — ticking people off at the door. *@

<PageTitle>Attendees — @(chapterEvent?.Title ?? "Event")</PageTitle>

<div class="spe-page-shell md:max-w-4xl">
    <a href="/events" class="spe-back-btn mb-6">
        <Icon Name="circle-chevron-left" Class="h-4 w-4 shrink-0" />
        Back to Events
    </a>

    @if (loading)
    {
        <p class="py-20 text-center text-slate-500">Loading attendees...</p>
    }
    else if (chapterEvent is null)
    {
        <div class="py-20 text-center">
            <h1 class="spe-page-title">Event not found</h1>
            <p class="mt-2 text-sm text-slate-600">This event may have been deleted.</p>
        </div>
    }
    else
    {
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="spe-page-kicker">Attendees</p>
                <h1 class="spe-page-title">@chapterEvent.Title</h1>
                <p class="mt-2 text-sm text-slate-600">
                    @chapterEvent.Date.ToString("dddd, d MMMM yyyy · h:mm tt")
                </p>
            </div>
            @if (!showShareLink)
            {
                <button @onclick="OpenShareLink" class="spe-gold-btn">Guest sign-up link</button>
            }
        </div>

        @* Above the empty-state check on purpose: an event with nobody on it yet is exactly
           when the committee needs the link to send out. *@
        @if (showShareLink)
        {
            <section class="spe-card mt-6 border-slate-200 p-6">
                <h2 class="mb-1 font-heading text-lg font-bold text-spe-cobalt">Guest sign-up link</h2>
                <p class="mb-4 text-sm text-slate-600">
                    Send this to anyone from outside the chapter — a speaker, an industry guest, a
                    student from another university. They sign themselves up through it without an
                    account and appear on this list. Keep it to the people you mean to invite:
                    anyone holding the link can add themselves.
                </p>

                @if (shareLink is null)
                {
                    <p class="text-sm text-slate-500">Preparing the link...</p>
                }
                else
                {
                    <div class="flex flex-col gap-3 sm:flex-row">
                        @* Readonly rather than disabled, so the link can always be selected and
                           copied by hand. The button is convenience on top of that, never the
                           only way out — see the [data-copy] handler in ui.js. *@
                        <input id="guest-link" class="spe-input w-full font-mono text-xs" readonly
                               value="@shareLink" onclick="this.select()" />
                        <button data-copy="guest-link" class="spe-primary-btn shrink-0">Copy link</button>
                    </div>

                    <div class="mt-4 flex flex-wrap gap-3">
                        <button @onclick="CloseShareLink"
                                class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Done</button>
                        <button @onclick="() => confirmingReplace = true"
                                class="rounded-lg px-5 py-2 text-sm font-semibold text-red-600 transition-colors hover:bg-red-50">
                            Replace link
                        </button>
                    </div>
                }
            </section>
        }

        @if (confirmingReplace)
        {
            <ConfirmDialog Title="Replace this link?"
                           Message="Every copy of the current link stops working, including any already sent out. Guests who have already signed up stay on the list."
                           ConfirmLabel="Replace"
                           OnConfirm="ReplaceLink" OnCancel="() => confirmingReplace = false" />
        }

        @if (attendees.Count == 0)
        {
            <div class="mt-10 rounded-xl border border-slate-200 bg-white py-16 text-center">
                <p class="text-xl text-slate-400">Nobody on the list yet.</p>
                <p class="mt-2 text-sm text-slate-500">
                    Members sign up from the events page and appear here as they do. For anyone
                    outside the chapter, send them the guest sign-up link above.
                </p>
            </div>
        }
        else
        {
            <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <p class="text-2xl font-extrabold text-spe-cobalt font-heading">
                        @checkedInCount / @attendees.Count
                    </p>
                    <p class="text-xs uppercase tracking-wider text-slate-500">Checked in</p>
                </div>
                <div class="flex gap-2">
                    <button @onclick="() => SetAll(true)" class="spe-primary-btn px-4 py-2">Mark all present</button>
                    <button @onclick="() => SetAll(false)"
                            class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">
                        Clear all
                    </button>
                </div>
            </div>

            <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-slate-200">
                <div class="h-full rounded-full bg-spe-cobalt transition-all duration-300"
                     style="width:@(ProgressPercent)%"></div>
            </div>

            <div class="mt-6">
                <input class="spe-input w-full" placeholder="Search attendees by name or university..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            @if (!Filtered.Any())
            {
                <p class="py-12 text-center text-slate-400">No attendees match your search.</p>
            }
            else
            {
                <ul class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white">
                    @foreach (var attendee in Filtered)
                    {
                        <li @key="attendee.RegistrationId"
                            class="flex items-center gap-4 px-4 py-3 transition-colors @(attendee.Attended ? "bg-green-50/60" : "hover:bg-slate-50")">
                            @* The whole row is the label, so it's a large tap target on a phone. *@
                            <label class="flex flex-1 cursor-pointer items-center gap-4">
                                <input type="checkbox" checked="@attendee.Attended"
                                       @onchange="e => Toggle(attendee, e)"
                                       class="h-5 w-5 shrink-0 cursor-pointer accent-spe-cobalt" />
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate font-semibold text-slate-800">@attendee.FullName</span>
                                    <span class="block truncate text-xs text-slate-500">
                                        @attendee.University
                                        @if (!string.IsNullOrWhiteSpace(attendee.Email))
                                        {
                                            <span class="text-slate-400"> · @attendee.Email</span>
                                        }
                                    </span>
                                </span>
                            </label>

                            @if (attendee.Attended)
                            {
                                <span class="shrink-0 text-xs font-semibold text-green-700">
                                    @(attendee.CheckedInAt?.ToLocalTime().ToString("HH:mm") ?? "Present")
                                </span>
                            }
                            else
                            {
                                <span class="shrink-0 text-xs text-slate-400">
                                    Signed up @attendee.RegisteredAt.ToLocalTime().ToString("d MMM")
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? chapterEvent;
    private List<Attendee> attendees = [];
    private string searchQuery = "";
    private bool loading = true;

    /* ---------- Guest sign-up link ---------- */

    private bool showShareLink;
    private bool confirmingReplace;

    /// <summary>The absolute URL to hand out. Null until the token has been fetched or minted.</summary>
    private string? shareLink;

    private int checkedInCount => attendees.Count(a => a.Attended);

    private int ProgressPercent =>
        attendees.Count == 0 ? 0 : (int)Math.Round(checkedInCount * 100.0 / attendees.Count);

    private IEnumerable<Attendee> Filtered =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? attendees
            : attendees.Where(a =>
                a.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                a.University.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        chapterEvent = await EventSvc.GetByIdAsync(Id);
        if (chapterEvent is not null)
        {
            attendees = await EventSvc.GetAttendeesAsync(Id);
        }
        loading = false;
    }

    /// <summary>
    /// Updates the row in place rather than re-reading the list, so ticking through a queue of
    /// people at the door stays responsive and doesn't reorder under the committee member's finger.
    /// </summary>
    private async Task Toggle(Attendee attendee, ChangeEventArgs e)
    {
        var attended = e.Value is bool value && value;
        var checkedInAt = await EventSvc.SetAttendanceAsync(attendee.RegistrationId, attended);

        var index = attendees.IndexOf(attendee);
        if (index >= 0)
        {
            attendees[index] = attendee with { Attended = attended, CheckedInAt = checkedInAt };
        }
    }

    /* ---------- Guest sign-up link ---------- */

    /// <summary>
    /// Fetches the event's sign-up token, minting one the first time anyone asks, and builds the
    /// absolute URL from the request's own host so the link is copy-pasteable as-is on localhost
    /// and on the live domain alike.
    /// </summary>
    private async Task OpenShareLink()
    {
        showShareLink = true;

        // Already built on a previous open — the token does not change under us, so re-fetching
        // it would only make the panel flicker back to "Preparing the link...".
        if (shareLink is not null) return;

        var token = await EventSvc.GetOrCreateShareTokenAsync(Id);
        if (token is not null)
        {
            shareLink = Nav.ToAbsoluteUri($"/events/register/{token}").ToString();
        }
    }

    private void CloseShareLink()
    {
        showShareLink = false;
        confirmingReplace = false;
    }

    /// <summary>
    /// Retires the current link and shows the replacement. The only way to withdraw a link once
    /// it has been forwarded further than intended.
    /// </summary>
    private async Task ReplaceLink()
    {
        confirmingReplace = false;

        var token = await EventSvc.RegenerateShareTokenAsync(Id);
        shareLink = token is null ? null : Nav.ToAbsoluteUri($"/events/register/{token}").ToString();
    }

    private async Task SetAll(bool attended)
    {
        var checkedInAt = await EventSvc.SetAllAttendanceAsync(Id, attended);
        attendees = [.. attendees.Select(a => a with { Attended = attended, CheckedInAt = checkedInAt })];
    }
}
