@page "/events/upcoming"
@rendermode InteractiveServer
@inject EventService EventSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Upcoming Events — SPE Chapter</PageTitle>

<div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-spe-blue">Upcoming Events</h1>
            <p class="text-slate-500 mt-1">Stay connected with what's happening in our chapter.</p>
        </div>
        <AuthorizeView Roles="CommitteeMember,President">
            <Authorized>
                <button @onclick="() => showForm = true"
                        class="bg-spe-blue text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-800 transition-colors">
                    + Add Event
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <div class="bg-white rounded-xl shadow-md p-6 mb-8 border border-slate-200">
            <h2 class="text-xl font-semibold text-spe-blue mb-4">New Event</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <input type="text"
                           class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                           placeholder="DD/MM/YYYY HH:MM"
                           value="@newDateString"
                           @oninput="HandleDateInput"
                           maxlength="16" />
                    @if (dateParseError)
                    {
                        <p class="text-red-500 text-xs mt-1">Invalid date. Use DD/MM/YYYY HH:MM (e.g. 25/07/2025 14:30)</p>
                    }
                </div>
                <input
                class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                placeholder="Event Title" @bind="newTitle" />
                <input
                class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                placeholder="Google Maps link" @bind="newLocation" />
                <input
                class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                placeholder="Instagram post URL" @bind="newInstagramEmbedUrl" />
            </div>
            <div class="flex gap-3 mt-4">
                <button @onclick="SaveEvent"
                        class="bg-spe-blue text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-800 transition-colors">Save</button>
                <button @onclick="() => showForm = false"
                        class="border border-slate-300 text-slate-600 px-5 py-2 rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
            </div>
        </div>
    }

    @if (events is null)
    {
        <p class="text-slate-500 text-center py-20">Loading events...</p>
    }
    else if (events.Count == 0)
    {
        <div class="text-center py-20">
            <p class="text-slate-400 text-xl">No upcoming events at the moment.</p>
            <p class="text-slate-400 mt-2">Check back soon!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var evt in events)
            {
                <div
                    class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow">
                    @if (!string.IsNullOrEmpty(evt.InstagramEmbedUrl))
                    {
                        <div class="overflow-hidden flex justify-center bg-slate-50">
                            <blockquote class="instagram-media" data-instgrm-permalink="@evt.InstagramEmbedUrl"
                                        data-instgrm-version="14" style="width:100%; min-width:236px; margin:0;"></blockquote>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(evt.ImageUrl))
                    {
                        <img src="@evt.ImageUrl" alt="@evt.Title" class="w-full h-40 object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-40 bg-gradient-to-br from-spe-blue to-blue-700 flex items-center justify-center">
                            <span class="text-white/40 text-5xl">&#x1F4C5;</span>
                        </div>
                    }
                    <div class="p-5">
                        <div class="flex justify-between items-start mb-2">
                            <div class="text-spe-gold text-xs font-bold uppercase tracking-wider">
                                @evt.Date.ToString("MMM d, yyyy · h:mm tt")
                            </div>
                            <AuthorizeView Roles="CommitteeMember,President">
                                <Authorized>
                                    <button @onclick:stopPropagation="true" @onclick="() => DeleteEvent(evt.Id)"
                                            class="text-red-400 hover:text-red-600 text-sm font-medium transition-colors">
                                        Delete
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1">@evt.Title</h3>
                        @if (!string.IsNullOrEmpty(evt.Location))
                        {
                            <a href="@evt.Location" target="_blank" rel="noopener noreferrer"
                               class="text-spe-blue hover:underline text-sm mb-3 block">📍 View Location</a>
                        }
                        <p class="text-slate-600 text-sm line-clamp-3">@evt.Description</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Event>? events;
    private bool showForm;
    private string newTitle = "";
    private string newLocation = "";
    private string newInstagramEmbedUrl = "";
    private DateTime newDate = DateTime.Now.AddDays(7);
    private string newDateString = DateTime.Now.AddDays(7).ToString("dd/MM/yyyy HH:mm");
    private bool dateParseError;

    private void HandleDateInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (raw.Length > 12) raw = raw[..12];
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < raw.Length; i++)
        {
            if (i == 2 || i == 4) sb.Append('/');
            else if (i == 8) sb.Append(' ');
            else if (i == 10) sb.Append(':');
            sb.Append(raw[i]);
        }
        newDateString = sb.ToString();
    }

    protected override async Task OnInitializedAsync() =>
        events = await EventSvc.GetUpcomingAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JS.InvokeVoidAsync("speSite.processInstagramEmbeds");

    private async Task SaveEvent()
    {
        dateParseError = false;
        if (!DateTime.TryParseExact(newDateString, "dd/MM/yyyy HH:mm",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out newDate))
        {
            dateParseError = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newLocation) ||
string.IsNullOrWhiteSpace(newInstagramEmbedUrl)) return;
        await EventSvc.CreateAsync(new Event
        {
            Title = newTitle,
            Description = "",
            Location = newLocation,
            InstagramEmbedUrl = newInstagramEmbedUrl,
            Date = newDate,
            IsUpcoming = true
        });
        showForm = false;
        newInstagramEmbedUrl = "";
        newLocation = "";
        events = await EventSvc.GetUpcomingAsync();
    }

    private async Task DeleteEvent(int id)
    {
        await EventSvc.DeleteAsync(id);
        events = await EventSvc.GetUpcomingAsync();
    }
}
