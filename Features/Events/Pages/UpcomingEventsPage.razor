@page "/events/upcoming"
@rendermode InteractiveServer
@inject EventService EventSvc
@inject IJSRuntime JS

<PageTitle>Upcoming Events — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-[1200px]">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="spe-page-kicker">Events</p>
            <h1 class="spe-page-title">Upcoming Events</h1>
            <p class="mt-2 text-sm text-slate-600">Stay connected with what's happening in our chapter.</p>
        </div>
        <AuthorizeView Roles="CommitteeMember,President">
            <Authorized>
                <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add Event</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <section class="spe-card mb-8 border-slate-200 p-6">
            <h2 class="mb-4 text-xl font-bold text-spe-cobalt" style="font-family:Montserrat, sans-serif;">New Event</h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <input type="text"
                           class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                           placeholder="DD/MM/YYYY HH:MM"
                           value="@newDateString"
                           @oninput="HandleDateInput"
                           maxlength="16" />
                    @if (dateParseError)
                    {
                        <p class="mt-1 text-xs text-red-500">Invalid date. Use DD/MM/YYYY HH:MM (e.g. 25/07/2025 14:30)</p>
                    }
                </div>
                <input class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                       placeholder="Event Title" @bind="newTitle" />
                <input class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                       placeholder="Google Maps link" @bind="newLocation" />
                <input class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-spe-cobalt"
                       placeholder="Instagram post URL" @bind="newInstagramEmbedUrl" />
            </div>
            <div class="mt-4 flex gap-3">
                <button @onclick="SaveEvent" class="spe-primary-btn">Save</button>
                <button @onclick="() => showForm = false" class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
            </div>
        </section>
    }

    @if (events is null)
    {
        <p class="py-20 text-center text-slate-500">Loading events...</p>
    }
    else if (events.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl text-slate-400">No upcoming events at the moment.</p>
            <p class="mt-2 text-slate-400">Check back soon.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var evt in events)
            {
                <article class="spe-card overflow-hidden border-slate-200 transition-shadow hover:shadow-lg">
                    @if (!string.IsNullOrEmpty(evt.InstagramEmbedUrl))
                    {
                        <div class="flex justify-center overflow-hidden bg-slate-50">
                            <blockquote class="instagram-media" data-instgrm-permalink="@evt.InstagramEmbedUrl"
                                        data-instgrm-version="14" style="width:100%; min-width:236px; margin:0;"></blockquote>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(evt.ImageUrl))
                    {
                        <img src="@evt.ImageUrl" alt="@evt.Title" class="h-40 w-full object-cover" />
                    }
                    else
                    {
                        <div class="flex h-40 w-full items-center justify-center bg-gradient-to-br from-spe-cobalt to-spe-endeavor">
                            <span class="text-5xl text-white/40">&#x1F4C5;</span>
                        </div>
                    }
                    <div class="p-5">
                        <div class="mb-2 flex items-start justify-between">
                            <p class="text-xs font-bold uppercase tracking-wider text-spe-gold" style="font-family:'Roboto Mono', monospace;">
                                @evt.Date.ToString("MMM d, yyyy · h:mm tt")
                            </p>
                            <AuthorizeView Roles="CommitteeMember,President">
                                <Authorized>
                                    <button @onclick:stopPropagation="true" @onclick="() => DeleteEvent(evt.Id)"
                                            class="text-sm font-medium text-red-400 transition-colors hover:text-red-600">
                                        Delete
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                        <h3 class="mb-1 text-lg font-bold text-black" style="font-family:Montserrat, sans-serif;">@evt.Title</h3>
                        @if (!string.IsNullOrEmpty(evt.Location))
                        {
                            <a href="@evt.Location" target="_blank" rel="noopener noreferrer" class="mb-3 block text-sm text-spe-cobalt hover:underline">📍 View Location</a>
                        }
                        <p class="text-sm text-slate-600 line-clamp-3">@evt.Description</p>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<Event>? events;
    private bool showForm;
    private string newTitle = "";
    private string newLocation = "";
    private string newInstagramEmbedUrl = "";
    private DateTime newDate = DateTime.Now.AddDays(7);
    private string newDateString = DateTime.Now.AddDays(7).ToString("dd/MM/yyyy HH:mm");
    private bool dateParseError;

    private void HandleDateInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (raw.Length > 12) raw = raw[..12];
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < raw.Length; i++)
        {
            if (i == 2 || i == 4) sb.Append('/');
            else if (i == 8) sb.Append(' ');
            else if (i == 10) sb.Append(':');
            sb.Append(raw[i]);
        }
        newDateString = sb.ToString();
    }

    protected override async Task OnInitializedAsync() =>
        events = await EventSvc.GetUpcomingAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JS.InvokeVoidAsync("speSite.processInstagramEmbeds");

    private async Task SaveEvent()
    {
        dateParseError = false;
        if (!DateTime.TryParseExact(newDateString, "dd/MM/yyyy HH:mm",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out newDate))
        {
            dateParseError = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newLocation) ||
string.IsNullOrWhiteSpace(newInstagramEmbedUrl)) return;
        await EventSvc.CreateAsync(new Event
        {
            Title = newTitle,
            Description = "",
            Location = newLocation,
            InstagramEmbedUrl = newInstagramEmbedUrl,
            Date = newDate,
            IsUpcoming = true
        });
        showForm = false;
        newInstagramEmbedUrl = "";
        newLocation = "";
        events = await EventSvc.GetUpcomingAsync();
    }

    private async Task DeleteEvent(int id)
    {
        await EventSvc.DeleteAsync(id);
        events = await EventSvc.GetUpcomingAsync();
    }
}
