@page "/events/upcoming"
@rendermode InteractiveServer
@inject EventService EventSvc
@inject NavigationManager Nav

<PageTitle>Upcoming Events — SPE Chapter</PageTitle>

<div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-spe-blue">Upcoming Events</h1>
            <p class="text-slate-500 mt-1">Stay connected with what's happening in our chapter.</p>
        </div>
        <AuthorizeView Roles="CommitteeMember,President">
            <Authorized>
                <button @onclick="() => showForm = true"
                        class="bg-spe-blue text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-800 transition-colors">
                    + Add Event
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <div class="bg-white rounded-xl shadow-md p-6 mb-8 border border-slate-200">
            <h2 class="text-xl font-semibold text-spe-blue mb-4">New Event</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <input class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                       placeholder="Event title" @bind="newTitle" />
                <input type="datetime-local" class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                       @bind="newDate" />
                <input class="border border-slate-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-spe-blue"
                       placeholder="Location" @bind="newLocation" />
                <div></div>
                <textarea class="border border-slate-300 rounded-lg px-4 py-2 w-full sm:col-span-2 focus:outline-none focus:ring-2 focus:ring-spe-blue"
                          rows="3" placeholder="Description" @bind="newDescription"></textarea>
            </div>
            <div class="flex gap-3 mt-4">
                <button @onclick="SaveEvent" class="bg-spe-blue text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-800 transition-colors">Save</button>
                <button @onclick="() => showForm = false" class="border border-slate-300 text-slate-600 px-5 py-2 rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
            </div>
        </div>
    }

    @if (events is null)
    {
        <p class="text-slate-500 text-center py-20">Loading events...</p>
    }
    else if (events.Count == 0)
    {
        <div class="text-center py-20">
            <p class="text-slate-400 text-xl">No upcoming events at the moment.</p>
            <p class="text-slate-400 mt-2">Check back soon!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var evt in events)
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow">
                    @if (!string.IsNullOrEmpty(evt.ImageUrl))
                    {
                        <img src="@evt.ImageUrl" alt="@evt.Title" class="w-full h-40 object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-40 bg-gradient-to-br from-spe-blue to-blue-700 flex items-center justify-center">
                            <span class="text-white/40 text-5xl">&#x1F4C5;</span>
                        </div>
                    }
                    <div class="p-5">
                        <div class="text-spe-gold text-xs font-bold uppercase tracking-wider mb-1">
                            @evt.Date.ToString("MMM d, yyyy · h:mm tt")
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1">@evt.Title</h3>
                        <p class="text-slate-500 text-sm mb-3">@evt.Location</p>
                        <p class="text-slate-600 text-sm line-clamp-3">@evt.Description</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Event>? events;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newLocation = "";
    private DateTime newDate = DateTime.Now.AddDays(7);

    protected override async Task OnInitializedAsync() =>
        events = await EventSvc.GetUpcomingAsync();

    private async Task SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await EventSvc.CreateAsync(new Event
        {
            Title = newTitle,
            Description = newDescription,
            Location = newLocation,
            Date = newDate,
            IsUpcoming = true
        });
        showForm = false;
        newTitle = newDescription = newLocation = "";
        events = await EventSvc.GetUpcomingAsync();
    }
}
