@page "/events"
@page "/events/upcoming"
@page "/events/past"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@implements IAsyncDisposable
@inject EventService EventSvc
@inject IJSRuntime JS

<PageTitle>Events — SPE Chapter</PageTitle>

@* Instagram is only embedded here, so the connection warm-up belongs on this page rather
   than in App.razor where every route paid for it. *@
<HeadContent>
    <link rel="preconnect" href="https://www.instagram.com" />
    <link rel="preconnect" href="https://scontent.cdninstagram.com" crossorigin />
</HeadContent>

<div class="spe-page-shell  bg-white/20 backdrop-blur-none md:max-w-300">
    <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="spe-page-title text-white text-3xl">Events</h1>
            <p class="mt-2 text-sm text-slate-300" >SPE events serve as dynamic platforms for global collaboration, professional development, and technical innovation across the energy sector. Whether you are attending technical conferences, presenting academic research, or organizing local chapter workshops, these gatherings connect you directly with world-class industry experts and a global peer network. Participating in these events provides firsthand exposure to cutting-edge industry solutions, sharpens your professional competence, and empowers you to stay ahead of evolving energy trends while making a meaningful impact in the field.</p>
            <p class="mt-2 text-xl text-spe-gold ">Explore upcoming events and revisit our past highlights.</p>
        </div>
        <AuthorizeView Roles="CommitteeMember,TeamLeader">
            <Authorized>
                <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add Event</button>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-3">
        <button type="button" @onclick="() => showCalendarOptions = true"
                class="inline-flex items-center gap-2 rounded-lg border border-white/40 bg-white/15 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/25">
            <Icon Name="calendar" Class="h-4 w-4" />
            Add SPE Event Calendar
        </button>

        @* #Updates: point this at the SPE Aberdeen Section events page when the URL is confirmed. *@
        <a href="https://www.spe-aberdeen.org/events" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            <Icon Name="globe" Class="h-4 w-4" />
            Find more events from Aberdeen Section
        </a>
    </div>

    @* Search bar across the full width, category chips on the row beneath it. Chips toggle
       independently and can be combined; with none selected every category shows, so there is
       no separate "All" chip to keep in sync. *@
    <div class="mb-6">
        <input class="w-full  bg-white spe-input"
               placeholder="Search events by title, location, category, or description..."
               @bind="searchQuery" @bind:event="oninput" />

        <div class="mt-3 flex flex-wrap items-center gap-3">
            @foreach (var category in AllCategories)
            {
                var isActive = selectedCategories.Contains(category);
                <button type="button" @key="category" @onclick="() => ToggleCategory(category)"
                        aria-pressed="@isActive"
                        class="rounded-md px-5 py-2 text-sm font-semibold transition-colors @(isActive
                                ? "bg-spe-gold text-spe-ink"
                                : "bg-spe-blue text-white hover:bg-spe-endeavor")">
                    @GetCategoryLabel(category)
                </button>
            }

            @if (selectedCategories.Count > 0)
            {
                <button type="button" @onclick="() => selectedCategories.Clear()"
                        class="text-sm font-semibold text-white/70 underline-offset-2 transition-colors hover:text-white hover:underline">
                    Clear filters
                </button>
            }
        </div>
    </div>

    @if (showForm)
    {
        <section class="spe-card mb-8 border-slate-200/70 bg-white p-6">
            <h2 class="mb-4 text-xl font-bold text-white font-heading">New Event</h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Date</p>
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                        <div class="mb-4 flex items-center justify-between">
                            <button type="button" @onclick="PrevCalendarMonth" aria-label="Previous month"
                                    class="rounded-lg p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600">
                                <Icon Name="chevron-left" Class="h-5 w-5" />
                            </button>
                            <div class="relative">
                                <div class="flex items-center gap-1 text-base font-semibold text-slate-700">
                                    <span>@calendarMonth.ToString("MMMM")</span>
                                    <button type="button"
                                            @onclick="ToggleYearPicker"
                                            class="rounded-md px-1.5 py-0.5 text-slate-700 transition-colors hover:bg-slate-100">
                                        @calendarMonth.Year
                                    </button>
                                </div>
                                @if (isYearPickerOpen)
                                {
                                    <div class="absolute left-1/2 top-full z-20 mt-2 w-56 -translate-x-1/2 rounded-xl border border-slate-200 bg-white p-3 shadow-lg">
                                        <div class="mb-2 flex items-center justify-between">
                                            <button type="button" @onclick='() => ShiftYearRange(-12)' aria-label="Earlier years"
                                                    class="rounded p-1 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700">
                                                <Icon Name="chevron-left" Class="h-4 w-4" />
                                            </button>
                                            <span class="text-xs font-semibold text-slate-500">@yearPickerStart - @(yearPickerStart + 11)</span>
                                            <button type="button" @onclick='() => ShiftYearRange(12)' aria-label="Later years"
                                                    class="rounded p-1 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700">
                                                <Icon Name="chevron-right" Class="h-4 w-4" />
                                            </button>
                                        </div>
                                        <div class="grid grid-cols-3 gap-1">
                                            @for (int year = yearPickerStart; year <= yearPickerStart + 11; year++)
                                            {
                                                var displayYear = year;
                                                var isActiveYear = displayYear == calendarMonth.Year;
                                                <button type="button"
                                                        @onclick="() => SelectCalendarYear(displayYear)"
                                                        class="rounded-md px-2 py-1.5 text-sm font-semibold transition-colors @(isActiveYear ? "bg-spe-cobalt text-white" : "text-slate-600 hover:bg-slate-100")">
                                                    @displayYear
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <button type="button" @onclick="NextCalendarMonth" aria-label="Next month"
                                    class="rounded-lg p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600">
                                <Icon Name="chevron-right" Class="h-5 w-5" />
                            </button>
                        </div>
                        <div class="mb-2 grid grid-cols-7 text-center text-[11px] font-semibold uppercase tracking-widest text-slate-400">
                            @foreach (var dayName in weekDayNames)
                            {
                                <span class="py-1">@dayName</span>
                            }
                        </div>
                        <div class="grid grid-cols-7 gap-y-1 text-center">
                            @for (int i = 0; i < firstDayOffset; i++)
                            {
                                <span></span>
                            }
                            @for (int day = 1; day <= daysInMonth; day++)
                            {
                                var currentDay = new DateTime(calendarMonth.Year, calendarMonth.Month, day);
                                var isSelected = currentDay.Date == selectedEventDate.Date;
                                var isToday = currentDay.Date == UkTime.Today;

                                <button type="button"
                                        @onclick="() => SelectEventDate(currentDay)"
                                        class="mx-auto flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold transition-colors @(isSelected ? "bg-orange-500 text-white" : isToday ? "bg-orange-100 text-orange-600" : "text-slate-600 hover:bg-slate-100")">
                                    @day
                                </button>
                            }
                        </div>
                    </div>

                </div>
                <div class="space-y-4">
                    <div>
                        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Selected Date</p>
                        <p class="rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-sm text-slate-700">
                            @selectedEventDate.ToString("dddd, dd MMMM yyyy")
                        </p>
                    </div>
                    <div>
                        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600">Time</p>
                        @* Bound to a TimeOnly, not a string. The browser reports a time input's
                           value as 24-hour text and reports "" while it is mid-edit, so the old
                           hand-rolled string + TryParseExact could fail on perfectly valid input. *@
                        <input type="time" class="w-full spe-input" @bind="newTime" />
                    </div>
                </div>
                <input class="w-full spe-input"
                       placeholder="Event Title" @bind="newTitle" />
                <select class="w-full spe-input"
                        @bind="selectedCategory">
                    <option value="@EventCategory.Talk">Talk</option>
                    <option value="@EventCategory.SiteVisit">Site Visit</option>
                    <option value="@EventCategory.Workshop">Workshop</option>
                    <option value="@EventCategory.Other">Other</option>
                </select>
                <input class="w-full spe-input"
                       placeholder="Google Maps link (optional)" @bind="newLocation" />
                <input class="w-full spe-input"
                       placeholder="Instagram post URL (optional)" @bind="newInstagramEmbedUrl" />
            </div>

            @if (formError is not null)
            {
                <p class="mt-3 text-sm text-red-500">@formError</p>
            }

            <div class="mt-4 flex gap-3">
                <button @onclick="SaveEvent" class="spe-primary-btn">Save</button>
                <button @onclick="() => showForm = false" class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
            </div>
        </section>
    }

    @if (upcomingEvents is null || pastEvents is null)
    {
        <p class="py-20 text-center text-slate-500">Loading events...</p>
    }
    else
    {
        <section>
            <h2 class="mb-4 text-2xl font-bold text-white font-heading">Upcoming Events</h2>
            @if (!FilteredUpcomingEvents.Any())
            {
                <div class="rounded-xl border border-slate-200/70 bg-white py-12 text-center">
                    <p class="text-xl text-slate-400">No upcoming events match your search.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var evt in FilteredUpcomingEvents)
                    {
                        @* @key matters most here: each card holds a JS-hydrated Instagram
                           blockquote, which mis-keyed diffing would destroy and rebuild. *@
                        <article @key="evt.Id" class="spe-card overflow-hidden border-slate-200/70 bg-white transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
                            @if (!string.IsNullOrEmpty(evt.InstagramEmbedUrl))
                            {
                                <div class="ig-embed-slot flex justify-center overflow-hidden bg-slate-50">
                                    <blockquote class="ig-lazy" data-instgrm-permalink="@evt.InstagramEmbedUrl"
                                                data-instgrm-version="14" style="width:100%; min-width:236px; margin:0;"></blockquote>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(evt.ImageUrl))
                            {
                                <img src="@evt.ImageUrl" alt="@evt.Title" class="h-40 w-full object-cover" />
                            }
                            else
                            {
                                <div class="flex h-40 w-full items-center justify-center bg-gradient-to-br from-spe-cobalt to-spe-endeavor">
                                    <Icon Name="calendar" Class="h-14 w-14 text-white/40" />
                                </div>
                            }
                            <div class="p-5">
                                <h3 class="mb-1 text-lg font-bold text-spe-endeavor font-heading">@evt.Title</h3>
                                <span class="mb-3 inline-block rounded-full bg-spe-cobalt/10 px-3 py-1 text-xs font-semibold text-spe-cobalt">
                                    @GetCategoryLabel(evt.Category)
                                </span>
                                <div class="mb-3 space-y-2">
                                    <div class="flex items-center justify-between gap-3">
                                        <p class="text-xs font-bold uppercase tracking-wider text-spe-gold font-kicker">
                                            @evt.Date.ToString("MMM d, yyyy · h:mm tt")
                                        </p>
                                        <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                            <Authorized>
                                                <a href="/events/@evt.Id/attendees" @onclick:stopPropagation="true"
                                                   class="shrink-0 rounded-md bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-200">
                                                    Attendees@(registrationCounts.TryGetValue(evt.Id, out var signedUp) && signedUp > 0 ? $" ({signedUp})" : "")
                                                </a>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>

                                    <div class="flex items-center justify-between gap-3">
                                        @if (!string.IsNullOrEmpty(evt.Location))
                                        {
                                            <a href="@evt.Location" target="_blank" rel="noopener noreferrer"
                                               @onclick:stopPropagation="true"
                                               class="inline-flex min-w-0 items-center gap-1.5 text-sm text-spe-cobalt hover:underline">
                                                <Icon Name="location-dot" Class="h-4 w-4 shrink-0" />
                                                <span class="truncate">View Location</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-slate-300">No location</span>
                                        }
                                        <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                            <Authorized>
                                                <button @onclick:stopPropagation="true" @onclick="() => DeleteEvent(evt.Id)"
                                                        class="shrink-0 rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-red-700">
                                                    Delete
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </div>
                                <p class="text-sm text-slate-600 line-clamp-3">@evt.Description</p>

                                @* Attendance sign-up. Only signed-in members see it, because a
                                   registration has to be attributable to a person. *@
                                <AuthorizeView>
                                    <Authorized Context="signUp">
                                        <div class="mt-4 border-t border-slate-200 pt-4">
                                            @if (registrationCounts.TryGetValue(evt.Id, out var attending) && attending > 0)
                                            {
                                                <p class="mb-2 text-xs text-slate-500">
                                                    @attending @(attending == 1 ? "member is" : "members are") attending
                                                </p>
                                            }

                                            @if (registeredEventIds.Contains(evt.Id))
                                            {
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-green-700">
                                                        <Icon Name="check" Class="h-4 w-4" /> You're signed up
                                                    </span>
                                                    <button @onclick="() => CancelSignUp(evt.Id)"
                                                            class="text-xs font-medium text-slate-700 transition-colors hover:text-red-600 bg-red-100 rounded-lg px-3 py-1.5">
                                                        Cancel
                                                    </button>
                                                </div>
                                            }
                                            else if (signUpEventId == evt.Id)
                                            {
                                                <p class="mb-2 text-sm font-semibold text-slate-700">Sign up to attend</p>
                                                <div class="flex flex-col gap-2">
                                                    <input class="spe-input px-3 py-1.5 text-sm" placeholder="Your full name"
                                                           @bind="signUpName" />
                                                    <input class="spe-input px-3 py-1.5 text-sm" placeholder="Your university"
                                                           @bind="signUpUniversity" />
                                                    @if (signUpError is not null)
                                                    {
                                                        <p class="text-xs text-red-500">@signUpError</p>
                                                    }
                                                    <div class="flex gap-2">
                                                        <button @onclick="() => ConfirmSignUp(evt.Id)" class="spe-primary-btn px-4 py-1.5">
                                                            Confirm
                                                        </button>
                                                        <button @onclick="() => signUpEventId = null"
                                                                class="rounded-lg border border-slate-300 px-4 py-1.5 text-sm text-slate-600 transition-colors hover:bg-slate-100">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <button @onclick="() => OpenSignUp(evt.Id)" class="spe-primary-btn inline-block w-full">
                                                    Sign Up to Attend 
                                                </button>
                                            }
                                        </div>
                                    </Authorized>
                                    <NotAuthorized Context="signUpAnon">
                                        <div class="mt-4 border-t border-slate-200 pt-4">
                                            <a href="/login?returnUrl=/events" class="text-sm font-semibold text-spe-cobalt hover:underline">
                                                Sign in to attend this event
                                            </a>
                                        </div>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <hr class="my-12 border-slate-200" />

<!-- Past Events Section -->
        <section>
            <h2 class="mb-4 text-2xl font-bold text-white font-heading">Past Events</h2>
            @if (!FilteredPastEvents.Any())
            {
                <div class="rounded-xl border border-slate-200/70 bg-white py-12 text-center">
                    <p class="text-xl text-slate-400">No past events match your search.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var evt in FilteredPastEvents)
                    {
                        @* @key matters most here: each card holds a JS-hydrated Instagram
                           blockquote, which mis-keyed diffing would destroy and rebuild. *@
                        <article @key="evt.Id" class="spe-card overflow-hidden border-slate-200/70 bg-white transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
                            @if (!string.IsNullOrEmpty(evt.InstagramEmbedUrl))
                            {
                                <div class="ig-embed-slot flex justify-center overflow-hidden bg-slate-50">
                                    <blockquote class="ig-lazy" data-instgrm-permalink="@evt.InstagramEmbedUrl" data-instgrm-version="14" style="width:100%; min-width:236px; margin:0;"></blockquote>
                                </div>
                            }
                            else
                            {
                                <div class="flex h-48 w-full items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300">
                                    <Icon Name="image" Class="h-12 w-12 text-slate-400" />
                                </div>
                            }

                            <div class="p-5">
                                <h3 class="mb-1 text-lg font-bold text-spe-endeavor font-heading">@evt.Title</h3>
                                <span class="mb-3 inline-block rounded-full bg-spe-cobalt/10 px-3 py-1 text-xs font-semibold text-spe-cobalt">
                                    @GetCategoryLabel(evt.Category)
                                </span>
                                <div class="mb-3 space-y-2">
                                    <div class="flex items-center justify-between gap-3">
                                        <p class="text-xs text-slate-400">
                                            @evt.Date.ToString("MMMM d, yyyy")
                                        </p>
                                        <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                            <Authorized>
                                                <a href="/events/@evt.Id/attendees" @onclick:stopPropagation="true"
                                                   class="shrink-0 rounded-md bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-200">
                                                    Attendees@(registrationCounts.TryGetValue(evt.Id, out var signedUp) && signedUp > 0 ? $" ({signedUp})" : "")
                                                </a>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>

                                    <div class="flex items-center justify-between gap-3">
                                        @if (!string.IsNullOrEmpty(evt.Location))
                                        {
                                            <a href="@evt.Location" target="_blank" rel="noopener noreferrer"
                                               @onclick:stopPropagation="true"
                                               class="inline-flex min-w-0 items-center gap-1.5 text-sm text-spe-cobalt hover:underline">
                                                <Icon Name="location-dot" Class="h-4 w-4 shrink-0" />
                                                <span class="truncate">View Location</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-slate-300">No location</span>
                                        }
                                        <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                            <Authorized>
                                                <button @onclick:stopPropagation="true" @onclick="() => DeleteEvent(evt.Id)"
                                                        class="shrink-0 rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-red-700">
                                                    Delete
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </div>
                                <p class="mb-4 text-sm text-slate-600">@evt.Description</p>

                                @{
                                    var avgRating = evt.Ratings.Any() ? evt.Ratings.Average(r => r.Stars) : 0;
                                    var ratingCount = evt.Ratings.Count;
                                }
                                @if (ratingCount > 0)
                                {
                                    <div class="mb-4 flex items-center gap-2">
                                        <div class="flex">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <Icon Name="star" Filled="@(i <= Math.Round(avgRating))"
                                                      Class="@($"h-4 w-4 {(i <= Math.Round(avgRating) ? "text-spe-gold" : "text-slate-300")}")" />
                                            }
                                        </div>
                                        <span class="text-sm text-slate-500">@avgRating.ToString("0.0") (@ratingCount @(ratingCount == 1 ? "review" : "reviews"))</span>
                                    </div>
                                }

                                @if (ratingPanelEventId == evt.Id)
                                {
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="mb-2 text-sm font-semibold text-slate-700">Rate this event</p>
                                        <div class="mb-3 flex gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                int star = i;
                                                <button @onclick="() => pendingStars = star" aria-label="@($"Rate {star} out of 5")"
                                                        class="transition-colors @(star <= pendingStars ? "text-spe-gold" : "text-slate-300") hover:text-spe-gold">
                                                    <Icon Name="star" Filled="@(star <= pendingStars)" Class="h-7 w-7" />
                                                </button>
                                            }
                                        </div>
                                        <textarea class="spe-input mb-3 w-full px-3 text-sm"
                                                  rows="2" placeholder="Optional feedback..." @bind="pendingComment"></textarea>
                                        <div class="flex gap-2">
                                            <button @onclick="() => SubmitRating(evt.Id)" class="spe-primary-btn px-4 py-1.5">Submit</button>
                                            <button @onclick="() => ratingPanelEventId = null" class="rounded-lg border border-slate-300 px-4 py-1.5 text-sm text-slate-600 transition-colors hover:bg-slate-100">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @* Reviews are attributed to the member now (for the committee's
                                       export), so they require sign-in. Names are never shown here. *@
                                    <AuthorizeView>
                                        <Authorized Context="review">
                                            <button @onclick="() => OpenRating(evt.Id)" class="text-sm font-semibold text-spe-cobalt hover:underline">
                                                Leave a review
                                            </button>
                                        </Authorized>
                                        <NotAuthorized Context="reviewAnon">
                                            <a href="/login?returnUrl=/events" class="text-sm font-semibold text-spe-cobalt hover:underline">
                                                Sign in to leave a review
                                            </a>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    @* Calendar subscription chooser.

       A modal rather than three buttons in the header or a dropdown: subscribing is a
       once-ever action that needs a platform choice, a line explaining it's an ongoing
       subscription rather than a one-off import, and a raw-URL fallback for desktop Outlook
       and anything else. None of that fits comfortably in a header row or a popover. *@
    @if (showCalendarOptions)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4"
             @onclick="() => showCalendarOptions = false">
            @* Stop clicks inside the card from closing it via the backdrop handler above. *@
            <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl" @onclick:stopPropagation="true">
                <h2 class="font-heading text-xl font-bold text-spe-cobalt">Add the SPE event calendar</h2>
                <p class="mt-2 text-sm text-slate-600">
                    Subscribe once and new chapter events show up in your calendar automatically —
                    you don't need to come back here for each one.
                </p>

                <div class="mt-6 flex flex-col gap-2">
                    <a href="@AppleCalendarUrl"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 transition-colors hover:border-spe-cobalt hover:bg-slate-50">
                        <Icon Name="apple" Class="h-6 w-6 text-slate-800" />
                        <span class="flex-1">
                            <span class="block text-sm font-semibold text-slate-800">iPhone &amp; Mac</span>
                            <span class="block text-xs text-slate-500">Opens Apple Calendar</span>
                        </span>
                    </a>

                    <a href="@GoogleCalendarUrl" target="_blank" rel="noopener noreferrer"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 transition-colors hover:border-spe-cobalt hover:bg-slate-50">
                        <Icon Name="android" Class="h-6 w-6 text-slate-800" />
                        <span class="flex-1">
                            <span class="block text-sm font-semibold text-slate-800">Android</span>
                            <span class="block text-xs text-slate-500">Adds it to Google Calendar</span>
                        </span>
                    </a>

                    <a href="@OutlookCalendarUrl" target="_blank" rel="noopener noreferrer"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 transition-colors hover:border-spe-cobalt hover:bg-slate-50">
                        <Icon Name="outlook" Class="h-6 w-6 text-slate-800" />
                        <span class="flex-1">
                            <span class="block text-sm font-semibold text-slate-800">Outlook</span>
                            <span class="block text-xs text-slate-500">Adds it to Outlook on the web</span>
                        </span>
                    </a>
                </div>

                @* Fallback for the desktop Outlook app, university calendars, and anything else
                   that wants the raw feed. onfocus/select is plain HTML — no JS interop needed.
                   All four URLs are #UpdateLinks constants in the @@code block below. *@
                <div class="mt-6 border-t border-slate-200 pt-5">
                    <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-500" for="calendar-feed-url">
                        Or use the calendar link
                    </label>
                    <input id="calendar-feed-url" class="spe-input w-full text-xs text-slate-600" readonly
                           value="@CalendarFeedUrl" onfocus="this.select()" onclick="this.select()" />
                    <p class="mt-1.5 text-xs text-slate-400">
                        Paste this into any calendar app that supports subscribing by URL.
                    </p>
                </div>

                <button type="button" @onclick="() => showCalendarOptions = false"
                        class="mt-6 w-full rounded-lg border border-slate-300 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">
                    Close
                </button>
            </div>
        </div>
    }

    @* "Collab with us" — same column treatment as the Quick Links block in the site footer.
       #Updates: hrefs are intentionally blank until the collaboration links are decided. *@
    <section class="mt-16 border-t border-white/20 pt-10">
        <div class="flex flex-col items-center">
            <h4 class="mb-5 border-b border-spe-gold pb-2 font-heading text-sm font-bold uppercase tracking-[0.2em] text-spe-gold">
                Collab With Us
            </h4>
            <p class="mb-6 max-w-md text-center text-sm text-white/70">
                Partnering on an event, sponsoring the chapter, or speaking to our members? Get in touch.
            </p>
        </div>
    </section>
</div>

@code {
    private List<Event>? upcomingEvents;
    private List<Event>? pastEvents;
    private bool showForm;
    private string newTitle = "";
    private string newLocation = "";
    private string newInstagramEmbedUrl = "";
    private EventCategory selectedCategory = EventCategory.Other;
    private string searchQuery = "";
    private DateTime selectedEventDate = UkTime.Today.AddDays(7);
    private DateTime calendarMonth = new(UkTime.Today.AddDays(7).Year, UkTime.Today.AddDays(7).Month, 1);
    private TimeOnly newTime = new(18, 0);
    private bool isYearPickerOpen;
    private int yearPickerStart = UkTime.Today.Year - 6;
    private string? formError;
    private bool shouldProcessInstagramEmbeds;
    private static readonly string[] weekDayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private int firstDayOffset => (int)new DateTime(calendarMonth.Year, calendarMonth.Month, 1).DayOfWeek;
    private int daysInMonth => DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);

    private int? ratingPanelEventId;
    private int pendingStars = 5;
    private string pendingComment = "";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool showCalendarOptions;

    private static readonly EventCategory[] AllCategories = Enum.GetValues<EventCategory>();

    // Empty means "no category filter", i.e. show everything.
    private readonly HashSet<EventCategory> selectedCategories = [];

    private void ToggleCategory(EventCategory category)
    {
        if (!selectedCategories.Add(category)) selectedCategories.Remove(category);
    }

    // ---- Calendar subscription links -------------------------------------------------
    //
    // These point at the chapter's shared Google Calendar (spe@ausa.org.uk), NOT at the feed
    // this app generates from the Events table at /events/calendar.ics. That endpoint is still
    // served, but nothing links to it any more — so an event added through this site does not
    // reach a subscriber unless it is also put in the Google Calendar.
    //
    // Each is the platform's own "subscribe" entry point, so they are not interchangeable and
    // are not derived from one another. If the calendar address changes, all four need editing.

    /// <summary>Raw iCalendar URL, offered as the copy-and-paste fallback.</summary>
    // #UpdateLinks — chapter calendar: raw .ics feed
    private const string CalendarFeedUrl =
        "https://calendar.google.com/calendar/ical/spe%40ausa.org.uk/public/basic.ics";

    /// <summary>
    /// webcal:// is what makes Apple Calendar (and several others) offer to *subscribe* rather
    /// than import a one-off snapshot. Same address, different scheme.
    /// </summary>
    // #UpdateLinks — chapter calendar: iPhone & Mac (Apple Calendar)
    private const string AppleCalendarUrl =
        "webcal://calendar.google.com/calendar/ical/spe%40ausa.org.uk/public/basic.ics";

    // #UpdateLinks — chapter calendar: Android (Google Calendar)
    private const string GoogleCalendarUrl =
        "https://calendar.google.com/calendar/u/0/r?cid=https%3A%2F%2Fcalendar.google.com%2Fcalendar%2Fical%2Fspe%2540ausa.org.uk%2Fpublic%2Fbasic.ics";

    // #UpdateLinks — chapter calendar: Outlook on the web
    private const string OutlookCalendarUrl =
        "https://outlook.office.com/calendar/0/addfromweb?url=https%3A%2F%2Fcalendar.google.com%2Fcalendar%2Fical%2Fspe%2540ausa.org.uk%2Fpublic%2Fbasic.ics&name=SPE%20AUSA%20Events";

    // Attendance sign-up state. currentUserId is null for anonymous visitors, who see a
    // "sign in to attend" link instead of the form.
    private string? currentUserId;
    
    private HashSet<int> registeredEventIds = [];
    private Dictionary<int, int> registrationCounts = [];
    private int? signUpEventId;
    private string signUpName = "";
    private string signUpUniversity = "";
    private string? signUpError;

    private IEnumerable<Event> FilteredUpcomingEvents =>
        upcomingEvents?.Where(Matches) ?? Enumerable.Empty<Event>();

    private IEnumerable<Event> FilteredPastEvents =>
        pastEvents?.Where(Matches) ?? Enumerable.Empty<Event>();

    /// <summary>Search text and category chips narrow the list together, not separately.</summary>
    private bool Matches(Event evt) => MatchesCategory(evt) && MatchesSearch(evt);

    private bool MatchesCategory(Event evt) =>
        selectedCategories.Count == 0 || selectedCategories.Contains(evt.Category);

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await AuthStateTask.GetUserIdAsync();
        await LoadEventsAsync();
    }

    // Imported on demand rather than loaded globally, so pages without embeds never fetch it.
    private IJSObjectReference? instagramModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldProcessInstagramEmbeds)
        {
            return;
        }

        shouldProcessInstagramEmbeds = false;
        instagramModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/instagram-embed.js");
        await instagramModule.InvokeVoidAsync("processInstagramEmbeds");
    }

    /// <summary>
    /// Disconnects the module's IntersectionObserver on navigation away, so it doesn't
    /// outlive the page. JSDisconnectedException is expected when the circuit is already gone.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (instagramModule is null) return;

        try
        {
            await instagramModule.InvokeVoidAsync("dispose");
            await instagramModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadEventsAsync()
    {
        (upcomingEvents, pastEvents) = await EventSvc.GetUpcomingAndPastAsync();
        registrationCounts = await EventSvc.GetRegistrationCountsAsync();

        if (currentUserId is not null)
        {
            registeredEventIds = await EventSvc.GetRegisteredEventIdsAsync(currentUserId);
        }

        shouldProcessInstagramEmbeds = true;
    }

    private void PrevCalendarMonth()
    {
        calendarMonth = calendarMonth.AddMonths(-1);
        isYearPickerOpen = false;
    }

    private void NextCalendarMonth()
    {
        calendarMonth = calendarMonth.AddMonths(1);
        isYearPickerOpen = false;
    }

    private void ToggleYearPicker()
    {
        yearPickerStart = calendarMonth.Year - 6;
        isYearPickerOpen = !isYearPickerOpen;
    }

    private void ShiftYearRange(int offset) => yearPickerStart += offset;

    private void SelectCalendarYear(int year)
    {
        calendarMonth = new DateTime(year, calendarMonth.Month, 1);
        isYearPickerOpen = false;
    }

    private void SelectEventDate(DateTime date)
    {
        selectedEventDate = date.Date;
        formError = null;
    }

    private async Task SaveEvent()
    {
        formError = null;

        // Only the title is genuinely required. Location and the Instagram post used to be
        // mandatory *and* failed silently, so an upcoming event could not be created before
        // it had been posted about — and pressing Save just did nothing, with no explanation.
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            formError = "Give the event a title.";
            return;
        }

        await EventSvc.CreateAsync(new Event
        {
            Title = newTitle.Trim(),
            Description = "",
            Location = newLocation.Trim(),
            Category = selectedCategory,
            InstagramEmbedUrl = newInstagramEmbedUrl.Trim(),
            Date = selectedEventDate.Date + newTime.ToTimeSpan(),
            IsUpcoming = true
        });

        showForm = false;
        newTitle = "";
        newInstagramEmbedUrl = "";
        newLocation = "";
        selectedCategory = EventCategory.Other;
        await LoadEventsAsync();
    }

    private void OpenRating(int eventId)
    {
        ratingPanelEventId = eventId;
        pendingStars = 5;
        pendingComment = "";
    }

    private async Task SubmitRating(int eventId)
    {
        if (currentUserId is null) return;

        await EventSvc.AddRatingAsync(eventId, currentUserId, pendingStars, pendingComment);
        ratingPanelEventId = null;
        await LoadEventsAsync();
    }

    /// <summary>Opens the sign-up form, prefilled from the member's profile so most sign-ups are one click plus confirm.</summary>
    private async Task OpenSignUp(int eventId)
    {
        if (currentUserId is null) return;

        signUpError = null;
        signUpEventId = eventId;
        (signUpName, signUpUniversity) = await EventSvc.GetMemberDetailsAsync(currentUserId);
    }

    private async Task ConfirmSignUp(int eventId)
    {
        if (currentUserId is null) return;

        if (string.IsNullOrWhiteSpace(signUpName) || string.IsNullOrWhiteSpace(signUpUniversity))
        {
            signUpError = "Please give both your name and your university.";
            return;
        }

        var registered = await EventSvc.RegisterAsync(eventId, currentUserId, signUpName, signUpUniversity);
        if (!registered)
        {
            signUpError = "That sign-up could not be saved — you may already be signed up.";
        }

        signUpEventId = null;
        await LoadEventsAsync();
    }

    private async Task CancelSignUp(int eventId)
    {
        if (currentUserId is null) return;

        await EventSvc.CancelRegistrationAsync(eventId, currentUserId);
        await LoadEventsAsync();
    }

    private async Task DeleteEvent(int id)
    {
        await EventSvc.DeleteAsync(id);
        await LoadEventsAsync();
    }

    private bool MatchesSearch(Event evt)
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return true;
        }

        return evt.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
            || evt.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
            || evt.Location.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
            || GetCategoryLabel(evt.Category).Contains(searchQuery, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetCategoryLabel(EventCategory category) => category switch
    {
        EventCategory.Talk => "Talk",
        EventCategory.SiteVisit => "Site Visit",
        EventCategory.Workshop => "Workshop",
        _ => "Other"
    };
}
