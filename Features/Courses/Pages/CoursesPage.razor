@page "/courses"
@attribute [AllowAnonymous]
@using SPE_website.Features.Courses.Components

@* Static SSR. The intro and the competitions band are fixed copy, so they need no SignalR
   circuit — the video library brings its own (see Components/CourseLibrary.razor). A guest
   reading this page now opens no circuit at all. *@

@* #UpdateLink — tab title, the description used in search results and link previews,
   and the preview image. *@
<PageMeta Title="Competitions &amp; Workshops — SPE Chapter"
          Description="Technical sections, competitions such as PetroBowl and the SPE Student Paper Contest, and a members-only library of chapter learning videos." />

@* ---------- Intro: Technical & Academic Development ---------- *@

@* Copy beside a photo. Two columns from lg up; below that the grid collapses to one column and
   the text centres under the image — hence text-center / lg:text-left on the column and the
   matching justify switch on the discipline chips. *@
<FadeUp class="spe-page-shell md:max-w-300">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div class="text-center lg:text-left">
            @* #UpdateLink — intro heading, body copy, the technical-sections link and the
               discipline chips below it. *@
            <p class="spe-page-kicker">—Member Benefits—</p>
            <h1 class="spe-page-title mb-5">Competitions &amp; Workshops</h1>

            <p class="mb-4 leading-relaxed text-slate-700">
                SPE events serve as platforms for global collaboration, professional development, and technical
                innovation across the energy sector. Whether you are attending technical conferences,
                talks, or workshops, these gatherings connect you directly with
                world-class industry experts and a global peer network. Participating in these events provides firsthand
                exposure to cutting-edge industry solutions, sharpens your professional competence, and empowers you to
                stay ahead of evolving energy trends while making a meaningful impact in the field.
            </p>

            @* The only outbound link in this column, so it reads as a card rather than an inline
               anchor. text-left overrides the column's mobile centring — a centred icon/label/arrow
               row would leave the three parts floating with no shared edge. *@
            <a href="https://connect.spe.org/technical-sections/tshome" target="_blank" rel="noopener noreferrer"
               class="group spe-card mb-4 flex items-center gap-4 p-4 text-left transition-colors hover:border-spe-gold">
                <span
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-spe-cobalt/10 text-spe-cobalt transition-colors group-hover:bg-spe-gold group-hover:text-spe-ink">
                    <Icon Name="screwdriver-wrench" Class="h-5 w-5" />
                </span>
                <span class="min-w-0 flex-1">
                    <span class="block font-heading text-sm font-bold text-black">Browse SPE Technical Sections</span>
                    <span class="block text-xs leading-relaxed text-slate-500">Join the discipline communities on SPE
                        Connect</span>
                    </span>
                    <Icon Name="arrow-right"
                          Class="h-4 w-4 shrink-0 text-slate-400 transition-colors group-hover:text-spe-gold" />
                </a>

                <p class="leading-relaxed text-slate-700">
                    To help navigate these specialised fields, the global <a href="https://www.spe.org/en/ementoring/"
                                                                             target="_blank" class="hover:text-spe-gold font-bold">eMentoring program</a> pairs you
                    directly with experienced international professionals who provide one-on-one
                    academic guidance, technical coaching, and early career advice.
                </p>
                <p class="leading-relaxed text-slate-700">
                    Additional SPE offers a <a href="https://www.spe.org/en/training/competency/" target="_blank"
                                               class="hover:text-spe-gold font-bold">Competency Metrics</a> to test your skills accross all oil and gas
                    disipline to guide your through your learning.
                </p>

            </div>

            @* A CSS background rather than an <img>: it is decorative, so it needs no alt text, and
           a missing file degrades to a plain tile instead of a broken-image icon. *@
            <div aria-hidden="true" class="spe-academic-photo aspect-4/3 w-full overflow-hidden rounded-xl shadow-lg"></div>
        </div>
    </FadeUp>

    @* ---------- Competitions & Academic Recognition ---------- *@

    @* Photo-backed band. The cards sit in a left-hand column over the image on desktop and stack
   centred once there is no room beside it — hence items-center / md:items-start rather than a
   grid, so the column collapses without the cards changing width. *@
    <FadeUp class="relative mx-4 my-6 overflow-hidden rounded-2xl bg-spe-cobalt/90 backdrop-blur md:mx-auto md:max-w-300">
        <div aria-hidden="true" class="spe-competition-wash pointer-events-none absolute inset-0"></div>

        <div class="relative px-6 py-14 lg:px-10">
            <h2
                class="mb-10 text-center font-heading text-3xl font-extrabold text-spe-gold bg-spe-blue px-10 py-4 rounded-xl  ">
                Competitions &amp; Academic Recognition
            </h2>

            <div class="flex flex-col items-center gap-6 md:items-start">
                @foreach (var contest in Competitions)
                {
                    @* backdrop-blur keeps the body copy legible wherever the photo happens to be
                   busy, without dropping the panel's transparency. *@
                    <article @key="contest.Title"
                             class="w-full max-w-sm rounded-lg border border-white/25 bg-white/15 p-6 shadow-lg backdrop-blur-sm">
                        <h3 class="mb-3 font-heading text-xl font-bold text-white">@contest.Title</h3>
                        <p class="mb-5 text-sm leading-relaxed text-white/85">@contest.Description</p>
                        <a href="@contest.Url" target="_blank" rel="noopener noreferrer"
                           class="block rounded-md bg-spe-endeavor px-5 py-2.5 text-center font-heading text-sm font-bold text-white transition-colors hover:bg-spe-gold hover:text-spe-ink">
                            Find out more
                        </a>
                    </article>
                }
            </div>
        </div>
    </FadeUp>

    @* The SPE benefits panel above is public; the chapter's own video library is not. Guests get
   a sign-in prompt in its place rather than an empty search box over nothing. *@
    @* ---------- Learning library (members only) ---------- *@

    <AuthorizeView>
        <Authorized Context="library">
            <CourseLibrary />
        </Authorized>
        <NotAuthorized Context="guest">
            <div class="spe-page-shell md:max-w-300">
                <div class="rounded-xl border border-slate-200 bg-slate-50 py-16 text-center">
                    <div
                        class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-spe-cobalt/10 text-spe-cobalt">
                        <Icon Name="desktop" Class="h-6 w-6" />
                    </div>
                    <h2 class="font-heading text-xl font-bold text-black">Members-only learning library</h2>
                    <p class="mx-auto mt-2 max-w-md text-sm text-slate-600">
                        Sign in with your SPE membership email to browse and search the chapter's
                        learning videos.
                    </p>
                    <a href="/login" class="spe-primary-btn mt-6 inline-block">Sign in</a>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>

@code {
    /* ---------- Competition cards ---------- */

    // #UpdateLink — the competition cards: title, description and destination.
    private static readonly Competition[] Competitions =
        [
            new("PetroBowl® Competition",
            "The PetroBowl brings together SPE student chapters for a high-intensity showdown on oil and gas expertise. Following past successes, the University of Aberdeen petroleum engineering team continues to prove itself as a top-tier competitor in Europe.",
            "https://www.spe.org/en/students/petrobowl/"),

        new("SPE Student Paper Contest",
            "Present your academic research or thesis papers to industry judges at regional and international levels.",
            "https://www.spe.org/en/students/contest/")
        ];

    /// <summary>A card in the photo band. No icon — the panel is carried by the background image.</summary>
    private sealed record Competition(string Title, string Description, string Url);
}
