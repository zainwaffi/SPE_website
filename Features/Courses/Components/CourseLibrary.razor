@rendermode InteractiveServer
@inject CourseService CourseSvc

@* The members-only video library: search, the committee's add/delete controls, and the
   YouTube cards.

   This is the only part of the Courses page that needs a SignalR circuit, so it is a component
   rather than markup on the page. The page itself is static SSR — the intro and the
   competitions band are fixed copy — so a guest, who sees a sign-in prompt here instead of the
   library, opens no circuit at all.

   The caller is responsible for only rendering this for signed-in users; it does not repeat
   that check. *@

    <div class="spe-page-shell md:max-w-300">
        <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="spe-page-kicker">Chapter Library</p>
                <h2 class="spe-page-title">Workshops & Courses</h2>
                <p class="mt-2 text-sm text-slate-600">Explore our courses and workshops done by our student chapter
                </p>
            </div>
            <AuthorizeView Roles="CommitteeMember,TeamLeader">
                <Authorized>
                    <button @onclick="() => showForm = true" class="spe-gold-btn">+ Add Video</button>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="mb-6">
            <input class="w-full spe-input" placeholder="Search courses by title or description..."
                   @bind="searchQuery" @bind:event="oninput" />
        </div>

        @if (showForm)
        {
            <section class="spe-card mb-8 border-slate-200 p-6">
                <h2 class="mb-4 text-xl font-semibold text-spe-cobalt font-heading">New Course Video</h2>
                <div class="grid grid-cols-1 gap-4">
                    <input class="spe-input" placeholder="Video title" @bind="newTitle" />
                    <input class="spe-input" placeholder="YouTube URL (watch, youtu.be, Shorts or embed)"
                           @bind="newYoutubeUrl" />
                    <textarea class="spe-input" rows="3" placeholder="Course description"
                              @bind="newDescription"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(formError))
                {
                    <p class="mt-3 text-sm text-red-600">@formError</p>
                }
                <div class="mt-4 flex gap-3">
                    <button @onclick="SaveCourse" class="spe-primary-btn">Save</button>
                    <button @onclick="CloseForm"
                            class="rounded-lg border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
                </div>
            </section>
        }

        @if (courses is null)
        {
            <p class="py-20 text-center text-slate-500">Loading courses...</p>
        }
        else if (!FilteredCourses.Any())
        {
            <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
                <p class="text-xl text-slate-400">No courses match your search.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                @foreach (var course in FilteredCourses)
                {
                    <article @key="course.Id"
                             @oncontextmenu="e => OpenMenu(e, course)"
                             @oncontextmenu:preventDefault="canManage"
                             class="spe-card overflow-hidden border-slate-200 transition-shadow hover:shadow-lg">
                        <div class="aspect-video">
                            <iframe src="@course.YoutubeEmbedUrl" class="h-full w-full" frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen></iframe>
                        </div>
                        <div class="p-5">
                            <h3 class="mb-1 text-lg font-bold text-black font-heading">@course.Title</h3>
                            <p class="text-sm text-slate-600">@course.Description</p>
                            <AuthorizeView Roles="CommitteeMember,TeamLeader">
                                <Authorized>
                                    <button @onclick="() => DeleteCourse(course.Id)"
                                            class="mt-3 text-xs font-medium text-red-400 transition-colors hover:text-red-600">
                                        Delete
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </article>
                }
            </div>
        }

        @* ---------- Committee: right-click menu, edit dialog, delete confirmation ---------- *@

        @if (menuCourse is not null)
        {
            <ContextMenu X="menuX" Y="menuY" Label="@menuCourse.Title"
                         OnUpdate="StartEdit" OnDelete="StartDelete" OnClose="CloseMenu" />
        }

        @if (editCourse is not null)
        {
            <div class="spe-modal-backdrop" @onclick="CancelEdit">
                <div class="spe-modal-card max-w-lg" @onclick:stopPropagation="true">
                    <h2 class="mb-6 font-heading text-xl font-bold text-spe-cobalt">Edit Course Video</h2>
                    <div class="flex flex-col gap-3">
                        <input class="spe-input" placeholder="Video title" @bind="editTitle" />
                        <input class="spe-input" placeholder="YouTube URL (watch, youtu.be, Shorts or embed)"
                               @bind="editYoutubeUrl" />
                        <textarea class="spe-input" rows="3" placeholder="Course description"
                                  @bind="editDescription"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(editError))
                    {
                        <p class="mt-3 text-sm text-red-600">@editError</p>
                    }
                    <div class="mt-6 flex gap-3">
                        <button @onclick="SaveEdit" class="spe-primary-btn flex-1">Save changes</button>
                        <button @onclick="CancelEdit"
                                class="flex-1 rounded-lg border border-slate-300 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (deleteCourse is not null)
        {
            <ConfirmDialog Title="Delete this course?"
                           Message="@($"“{deleteCourse.Title}” will be removed from the library for everyone. This cannot be undone.")"
                           OnConfirm="ConfirmDelete" OnCancel="() => deleteCourse = null" />
        }
    </div>

@code {
    /* ---------- Library state ---------- */

    private List<Course>? courses;
    private bool showForm;
    private string newTitle = "";
    private string newDescription = "";
    private string newYoutubeUrl = "";
    private string? formError;
    private string searchQuery = "";

    /* ---------- Committee: right-click update/delete ---------- */

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    // Same audience as the Add and Delete controls: <AuthorizeView Roles="CommitteeMember,
    // TeamLeader">. Resolved once in C# rather than left to that component, because the
    // contextmenu handler has to decide whether to run at all — an <AuthorizeView> could hide
    // the menu, but not stop the paired preventDefault from suppressing the browser's own
    // right-click menu for every other reader of the page.
    private bool canManage;

    private Course? menuCourse;
    private double menuX, menuY;

    private Course? editCourse;
    private string editTitle = "";
    private string editDescription = "";
    private string editYoutubeUrl = "";
    private string? editError;

    private Course? deleteCourse;

    private IEnumerable<Course> FilteredCourses =>
        courses?.Where(course =>
            string.IsNullOrWhiteSpace(searchQuery) ||
            course.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            course.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Course>();

    /* ---------- Load, create, delete ---------- */

    protected override async Task OnInitializedAsync()
    {
        canManage = await AuthStateTask.IsInAnyRoleAsync("CommitteeMember", "TeamLeader");
        await LoadCourses();
    }

    private async Task LoadCourses() => courses = await CourseSvc.GetAllAsync();

    private async Task SaveCourse()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newYoutubeUrl))
        {
            formError = "Title and YouTube URL are required.";
            return;
        }

        var embedUrl = YouTubeUrl.ToEmbedUrl(newYoutubeUrl);
        if (embedUrl is null)
        {
            formError = "Please provide a valid YouTube URL.";
            return;
        }

        await CourseSvc.CreateAsync(new Course
        {
            Title = newTitle,
            Description = newDescription,
            YoutubeEmbedUrl = embedUrl
        });

        CloseForm();
        await LoadCourses();
    }

    private async Task DeleteCourse(int id)
    {
        await CourseSvc.DeleteAsync(id);
        await LoadCourses();
    }

    /* ---------- Committee: right-click update/delete ---------- */

    /// <summary>
    /// Opens the context menu over the card. Does nothing for a member without edit rights,
    /// whose browser then keeps its own right-click menu — the markup pairs this with
    /// <c>@@oncontextmenu:preventDefault="canManage"</c> so the two agree.
    /// </summary>
    private void OpenMenu(MouseEventArgs e, Course course)
    {
        if (!canManage) return;

        menuCourse = course;
        (menuX, menuY) = (e.ClientX, e.ClientY);
    }

    private void CloseMenu() => menuCourse = null;

    private void StartEdit()
    {
        if (menuCourse is null) return;

        editCourse = menuCourse;
        editTitle = editCourse.Title;
        editDescription = editCourse.Description;
        // The stored value is the /embed/ form. Round-tripping it through the same parser the
        // add form uses means an unchanged URL survives a save untouched.
        editYoutubeUrl = editCourse.YoutubeEmbedUrl;
        editError = null;
        CloseMenu();
    }

    private async Task SaveEdit()
    {
        if (editCourse is null) return;

        editError = null;
        if (string.IsNullOrWhiteSpace(editTitle) || string.IsNullOrWhiteSpace(editYoutubeUrl))
        {
            editError = "Title and YouTube URL are required.";
            return;
        }

        var embedUrl = YouTubeUrl.ToEmbedUrl(editYoutubeUrl);
        if (embedUrl is null)
        {
            editError = "Please provide a valid YouTube URL.";
            return;
        }

        await CourseSvc.UpdateAsync(editCourse.Id, editTitle, editDescription, embedUrl);
        editCourse = null;
        await LoadCourses();
    }

    private void CancelEdit()
    {
        editCourse = null;
        editError = null;
    }

    private void StartDelete()
    {
        deleteCourse = menuCourse;
        CloseMenu();
    }

    private async Task ConfirmDelete()
    {
        if (deleteCourse is null) return;

        var id = deleteCourse.Id;
        deleteCourse = null;
        await DeleteCourse(id);
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
        newTitle = "";
        newDescription = "";
        newYoutubeUrl = "";
    }
}
