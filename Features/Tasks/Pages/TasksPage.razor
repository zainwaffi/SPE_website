@page "/tasks"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "CommitteeMember,TeamLeader")]
@inject TaskItemService TaskSvc

<PageTitle>My Tasks — SPE Chapter</PageTitle>

<div class="spe-page-shell md:max-w-5xl">
    <div class="mb-8">
        <p class="spe-page-kicker">Tasks</p>
        <h1 class="spe-page-title">My Tasks</h1>
    </div>

    @if (completionNotice is not null)
    {
        <div class="mb-6 rounded-lg border px-4 py-3 text-sm @(completionNotice.Sent ? "border-green-200 bg-green-50 text-green-800" : "border-amber-200 bg-amber-50 text-amber-800")">
            <p class="font-semibold">Task marked complete.</p>
            @if (completionNotice.Sent)
            {
                <p>Your team leader has been notified by email.</p>
            }
            else
            {
                <p>Your team leader was <strong>not</strong> notified by email: @completionNotice.Error</p>
            }
        </div>
    }

    @if (tasks is null)
    {
        <p class="text-slate-500">Loading tasks...</p>
    }
    else if (tasks.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white py-20 text-center">
            <p class="text-xl font-medium text-slate-400">No tasks assigned yet.</p>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var task in tasks)
            {
                <article @key="task.Id" class="spe-card border-slate-200 p-6 transition-shadow hover:shadow-sm">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <h3 class="mb-1 text-lg font-bold text-black font-heading">@task.Title</h3>
                            <p class="mb-3 text-sm text-slate-600">@task.Description</p>
                            <p class="text-xs text-slate-400">
                                Due <span class="font-semibold @(task.Deadline < UkTime.Now && task.Status == AssignmentStatus.Processing ? "text-red-500" : "text-slate-600")">
                                    @task.Deadline.ToString("MMMM d, yyyy")
                                </span>
                            </p>
                        </div>
                        <div class="shrink-0">
                            <span class="rounded-full px-3 py-1 text-xs font-bold @StatusBadge(task.Status)">@task.Status</span>
                        </div>
                    </div>
                    @if (task.Status == AssignmentStatus.Processing)
                    {
                        <div class="mt-4 flex gap-2">
                            <button @onclick="() => UpdateStatus(task.Id, AssignmentStatus.Completed)"
                                    class="rounded-lg bg-green-100 px-3 py-1 text-xs font-semibold text-green-700 transition-colors hover:bg-green-200">
                                Complete
                            </button>
                            <button @onclick="() => UpdateStatus(task.Id, AssignmentStatus.Failed)"
                                    class="rounded-lg bg-red-100 px-3 py-1 text-xs font-semibold text-red-600 transition-colors hover:bg-red-200">
                                Mark Failed
                            </button>
                        </div>
                    }
                </article>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<TaskItem>? tasks;
    private string? userId;

    // Outcome of the team-leader notification for the last completed task. Null for any other
    // status change, which sends nothing and so has nothing to report.
    private EmailResult? completionNotice;

    protected override async Task OnInitializedAsync()
    {
        userId = await AuthStateTask.GetUserIdAsync();
        await ReloadTasksAsync();
    }

    private async Task UpdateStatus(int taskId, AssignmentStatus status)
    {
        completionNotice = await TaskSvc.UpdateStatusAsync(taskId, status);
        await ReloadTasksAsync();
    }

    private async Task ReloadTasksAsync()
    {
        if (userId is not null)
            tasks = await TaskSvc.GetForUserAsync(userId);
    }

    private static string StatusBadge(AssignmentStatus s) => s switch
    {
        AssignmentStatus.Completed => "bg-green-100 text-green-700",
        AssignmentStatus.Failed => "bg-red-100 text-red-700",
        _ => "bg-amber-100 text-amber-700"
    };
}
