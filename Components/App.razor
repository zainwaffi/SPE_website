<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Warms the TLS handshake to Instagram's hosts so the first lazily-loaded
       embed doesn't pay for connection setup on top of its own download. *@
    <link rel="preconnect" href="https://www.instagram.com" />
    <link rel="preconnect" href="https://scontent.cdninstagram.com" crossorigin />
    <link rel="stylesheet" href="tailwind.css" />
    <link rel="stylesheet" href="@Assets["SPE_website.styles.css"]" />
    <ImportMap />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="bg-slate-50 text-slate-800">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/instagram-embed.js"></script>
    <script src="js/animations.js"></script>
</body>

</html>
