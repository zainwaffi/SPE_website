<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    @* Marks the document script-capable before first paint. Styles/input.css gates the
       .fade-up hidden state on this class, so without JS the content renders visible
       instead of being stuck at opacity 0. Inline and first so there is no flash. *@
    <script>document.documentElement.classList.add('js')</script>

    @* Fonts must be a <link>, not an @@import inside input.css: Tailwind emits @@import at
       the end of the generated stylesheet, which is spec-invalid and silently dropped. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600;700&family=Roboto+Mono:wght@600;700&display=swap" />

    <link rel="stylesheet" href="@Assets["tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["SPE_website.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <HeadOutlet />
</head>

<body class="bg-slate-50 text-slate-800">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/ui.js"]" defer></script>
</body>

</html>
