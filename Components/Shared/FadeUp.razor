@* Scroll-reveal wrapper. The reveal itself is handled entirely by wwwroot/js/ui.js, which
   runs one shared IntersectionObserver over every .fade-up on the page. Because this
   component needs no JS interop, pages using it can stay static SSR instead of opening a
   SignalR circuit. Styling for .fade-up / .is-visible lives in Styles/input.css. *@

<div class="fade-up @Class">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Class { get; set; } = "";
}
