@* Inline SVG icons, replacing the Font Awesome 4.7.0 CDN stylesheet.

   That stylesheet was a render-blocking cross-origin request (~31 KB of CSS plus a ~75 KB
   webfont, from a library EOL since 2016) for eleven glyphs. These are the same eleven,
   inlined — no extra request, and they inherit currentColor. *@

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="@Class"
     fill="@(IsSolid ? "currentColor" : "none")"
     stroke="@(IsBrand ? "none" : "currentColor")"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     role="@(string.IsNullOrEmpty(Title) ? "presentation" : "img")"
     aria-hidden="@(string.IsNullOrEmpty(Title) ? "true" : null)">
    @if (!string.IsNullOrEmpty(Title))
    {
        <title>@Title</title>
    }
    @((MarkupString)Path)
</svg>

@code {
    /// <summary>Icon name. See <see cref="Paths"/> for the supported set.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>Sizing/colour utilities, e.g. "h-6 w-6".</summary>
    [Parameter]
    public string Class { get; set; } = "h-6 w-6";

    /// <summary>Accessible label. When omitted the icon is treated as decorative.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Fills the shape instead of outlining it. Used for the star rating, where filled and
    /// empty stars have to be visually distinct at a glance.
    /// </summary>
    [Parameter]
    public bool Filled { get; set; }

    private bool IsBrand => Brands.Contains(Name);

    // Brand marks are always solid; other icons outline unless explicitly filled.
    private bool IsSolid => IsBrand || Filled;

    private string Path => Paths.TryGetValue(Name, out var d) ? d : "";

    // Brand marks are filled silhouettes; the UI icons are stroked outlines.
    private static readonly HashSet<string> Brands = ["instagram", "linkedin", "whatsapp", "github"];

