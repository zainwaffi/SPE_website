@page "/not-found"
@layout MainLayout

<PageTitle>Not Found — SPE Chapter</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4" style="min-height: calc(100vh - 10rem)">
    <div class="text-center max-w-md">
        <div class="text-7xl font-extrabold text-slate-200 mb-4">404</div>
        <h1 class="text-3xl font-bold text-spe-blue mb-3">Page Not Found</h1>
        <p class="text-slate-500 mb-8">The page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="bg-spe-blue text-white font-semibold px-6 py-2.5 rounded-lg hover:bg-blue-800 transition-colors">
            Back to Home
        </a>
    </div>
</div>
