@page "/"
@attribute [AllowAnonymous]

@* Static SSR: this page has no event handlers and no mutable state, so it needs no circuit.
   The scroll reveals come from wwwroot/js/ui.js, not JS interop. *@

@* #UpdateLink — tab title, the description used in search results and link previews,
   and the preview image. *@
<PageMeta Title="SPE Chapter — Home"
          Description="The Society of Petroleum Engineers student chapter at the University of Aberdeen: events, scholarships, volunteering and a route into the energy industry."
          Image="/images/student-chapter.webp"
          ImageAlt="Members of the SPE University of Aberdeen student chapter." />

@* ---------- Hero ---------- *@

@* #UpdateLink — hero kicker, headline, mission statement, and both buttons (label and,
   for "Join SPE", its destination). *@
<FadeUp class="relative flex min-h-150 items-center justify-center overflow-hidden px-6 text-center">
    <div class="absolute inset-0 bg-gradient-to-br from-spe-cobalt/60 via-spe-cobalt/20 to-transparent"></div>
    <div class="relative z-10 mx-auto max-w-3xl">
        <p class="mb-4 font-kicker text-xs font-bold uppercase tracking-[0.3em] text-white/70">
            Society of Petroleum Engineers — Student Chapter
        </p>
        <h1 class="mb-6 font-heading text-4xl font-extrabold leading-tight text-white md:text-6xl">
            Solutions.<br />People. Energy.
        </h1>
        <p class="mb-8 text-base leading-relaxed text-white/85 md:text-lg">
            To empower students with the knowledge, skills, and connections they need to thrive in the energy industry
            while promoting a culture of safety, responsibility, and sustainability.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <a href="/events"
               class="rounded border-2 border-white px-7 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-white hover:text-spe-cobalt">
                Our Events
            </a>

            <AuthorizeView>
                <NotAuthorized>
                    <a href="https://www.spe.org/en/join/" target="_blank" rel="noopener noreferrer"
                       class="spe-gold-btn px-7 py-3">
                        Join SPE
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</FadeUp>

@* ---------- About Us ---------- *@

<FadeUp class="spe-page-shell md:max-w-300">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
            @* #UpdateLink — About Us heading, both paragraphs, and both buttons (label and, for
               "Join Now", its destination). *@
            <p class="spe-page-kicker">—About Us—</p>
            <h2 class="mb-6 font-heading text-3xl font-extrabold text-black md:text-4xl">
                the world's largest community dedicated to the oil, gas, and energy industry
            </h2>
            <p class="mb-4 text-slate-700">
                The SPE Student Chapter at the University of Aberdeen is your direct connection to the Society of
                Petroleum Engineers. We serve as the link between students and SPE International ensuring our members
                are aware of the many opportunities available.
            </p>
            <p class="mb-6 text-slate-700">
                We introduce students to the industry and guide them toward the wealth of opportunities SPE offers. From
                technical lectures, international competitions, and networking events to publishing papers, pursuing
                chartership, and applying for scholarships through SPE International, we make sure our members are well
                informed and well prepared to take full advantage of what SPE has to offer.
            </p>
            <div class="flex flex-wrap gap-3">
                <AuthorizeView>
                    <NotAuthorized>
                        <a href="https://www.spe.org/" target="_blank" rel="noopener noreferrer" class="spe-primary-btn">Join Now</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="/events" class="spe-gold-btn">Find Out More</a>
            </div>
        </div>
        <div class="relative">
            <div class="aspect-4/3 overflow-hidden rounded-xl shadow-2xl">
                <img src="/images/student-chapter.webp" alt="Petroleum engineers" class="h-full w-full object-cover"
                     width="800" height="600" loading="lazy" decoding="async" />
            </div>
            @* #UpdateLink — the chapter-count figure and its caption. *@
            <div class="absolute -bottom-6 -left-6 rounded-xl bg-spe-cobalt p-5 shadow-xl">
                <p class="font-heading text-3xl font-extrabold text-white">360+</p>
                <p class="mt-1 text-xs text-white/80">Student Chapter Around the World</p>
            </div>
        </div>
    </div>
</FadeUp>

@* ---------- Why Join Us ---------- *@

<FadeUp class="mx-4 my-6 rounded-2xl bg-spe-cobalt/90 py-16 backdrop-blur md:mx-auto md:max-w-300">
    <div class="px-6 lg:px-8">
        @* Photo band behind the heading only — the benefit cards below keep the plain cobalt.
           The band carries the image's own 4.03:1 ratio so `contain` fills it without cropping;
           min-h-40 stops it collapsing to an unreadable sliver on a phone, where the image
           letterboxes instead. overflow-hidden clips it to the rounded corners, and the text
           needs `relative` to stack above the absolutely-positioned background. *@
        <div class="relative mb-12 flex min-h-40 items-center justify-center overflow-hidden rounded-xl px-4 py-10 md:aspect-1588/394 md:py-0">
            <div aria-hidden="true" class="spe-photo-wash pointer-events-none absolute inset-0"></div>
            <div class="relative text-center">
                @* #UpdateLink — section headings. The company buttons come from Companies below. *@
                <p class="spe-page-kicker text-spe-gold">—Why Join Us—</p>
                <h2 class="mb-4 font-heading text-3xl font-extrabold text-white">Featured Guest Speakers & Hosts from</h2>
                <div class="flex flex-wrap justify-center gap-3">
                    @foreach (var company in Companies)
                    {
                        <a href="@company.LinkedIn" @key="company" rel="noopener noreferrer" target="_blank"
                           class="rounded-lg bg-spe-cobalt/70 px-5 py-2.5 font-heading text-sm font-bold text-white backdrop-blur-sm transition-colors hover:bg-amber-500 hover:text-spe-ink">@company.Name</a>
                    }
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            @foreach (var benefit in Benefits)
            {
                <article @key="benefit.Title" class="rounded-xl bg-white/10 p-6">
                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-spe-gold text-black">
                        <Icon Name="@benefit.Icon" Class="h-6 w-6" />
                    </div>
                    <h3 class="mb-2 font-heading text-lg font-bold text-white">@benefit.Title</h3>
                    <p class="text-sm text-white/75">@benefit.Description</p>
                </article>
            }
        </div>
    </div>
</FadeUp>

@* ---------- Our Team ---------- *@

<FadeUp class="spe-page-shell md:max-w-300">
    <div class="mb-12 text-center">
        @* #UpdateLink — section headings. The cards come from TeamMembers below. *@
        <p class="spe-page-kicker">—Our Team—</p>
        <h2 class="font-heading text-3xl font-extrabold text-black">Meet the Committee</h2>
    </div>
    <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4">
        @foreach (var member in TeamMembers)
        {
            <article @key="member.ImageUrl" class="w-56 flex-none snap-start text-center md:w-[calc((100%-3rem)/3)]">
                <div class="mb-3 aspect-square overflow-hidden rounded-xl border border-slate-200 shadow-sm">
                    <img src="@member.ImageUrl" alt="@member.Name" class="h-full w-full object-cover"
                         width="256" height="256" loading="lazy" decoding="async" />
                </div>
                <h3 class="font-heading text-sm font-bold text-black">@member.Name</h3>
                <p class="mt-1 text-sm font-semibold text-spe-blue">@member.Role</p>
                <a href="@member.LinkedInUrl" target="_blank" rel="noopener noreferrer"
                   aria-label="@($"{member.Name} on LinkedIn")"
                   class="mt-2 inline-flex items-center justify-center text-slate-400 transition-colors hover:text-spe-cobalt">
                    <Icon Name="linkedin" Class="h-5 w-5" />
                </a>
            </article>
        }
    </div>
</FadeUp>

@* ---------- Chapter Achievements ---------- *@

<FadeUp class="mx-4 mb-0 mt-6 rounded-2xl bg-spe-cobalt/90 py-16 backdrop-blur md:mx-auto md:max-w-300">
    <div class="px-6 lg:px-8">
        <div class="mb-10 flex items-end justify-between gap-4">
            <div>
                @* #UpdateLink — section headings. The list comes from Achievements below. *@
                <p class="spe-page-kicker text-spe-gold">—Chapter Achievements—</p>
                <h2 class="font-heading text-2xl font-extrabold text-white">Awards And Recognitions</h2>
            </div>
        </div>
        <article class="rounded-xl bg-white/10 p-6">
            @foreach (var achievement in Achievements)
            {
                <div @key="achievement" class="mb-4 flex flex-row items-center gap-2">
                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-spe-gold text-black">
                        <Icon Name="trophy" Class="h-6 w-6" />
                    </div>
                    <h3 class="mb-2 font-heading text-lg font-bold text-white">@achievement</h3>
                </div>
            }
        </article>
        @* #UpdateLink — closing line, button label and its destination. *@
        <div class="mt-6 text-center">
            <p class="mb-3 text-sm text-white/80">Learn more about SPE chapters' achievements and awards.</p>
            <a href="https://www.spe.org/en/awards/nominator-and-recipient-stories/" target="_blank"
               rel="noopener noreferrer" class="spe-primary-btn">Find Out More</a>
        </div>
    </div>
</FadeUp>

