@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager NavigationManager

@if (_navOpen || _toolsOpen)
{
    <div class="fixed inset-0 z-40" @onclick="CloseAll"></div>
}

<header class="sticky top-0 z-50 border-b border-white/10 bg-spe-cobalt/95 shadow-lg backdrop-blur">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-20">
        <div class="flex h-16 items-center justify-between">
            <a href="/" class="group flex items-center gap-3" @onclick="CloseAll">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white">
                    <i class="fa fa-globe text-xl text-spe-cobalt"></i>
                </div>
                <div class="hidden text-left sm:block">
                    <p class="text-sm font-bold leading-tight text-white" style="font-family:Montserrat, sans-serif;">SPE Student Chapter</p>
                    <p class="text-xs leading-tight text-white/70">Society of Petroleum Engineers</p>
                </div>
            </a>

            <button @onclick="ToggleNav" class="rounded p-2 text-white transition-colors hover:bg-white/10" aria-label="Open navigation menu">
                <i class="@(_navOpen ? "fa fa-close" : "fa fa-bars") text-xl"></i>
            </button>
        </div>
    </div>

    @if (_navOpen)
    {
        <div class="border-t border-white/10 bg-spe-endeavor shadow-xl">
            <div class="mx-auto max-w-[1440px] px-6 py-2 lg:px-20">
                <a href="/" @onclick="CloseAll" class="block border-b border-white/10 px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">Home</a>
                <a href="/events/upcoming" @onclick="CloseAll" class="block border-b border-white/10 px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">Events</a>
                <a href="/opportunities" @onclick="CloseAll" class="block border-b border-white/10 px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">Opportunities</a>
                <a href="/tutorials" @onclick="CloseAll" class="block border-b border-white/10 px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">Tutorials</a>
                <a href="https://www.spe-aberdeen.org/news" target="_blank" rel="noopener noreferrer" @onclick="CloseAll" class="block border-b border-white/10 px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">News</a>

                <AuthorizeView>
                    <Authorized>
                        <button @onclick="ToggleTools" class="mt-2 w-full rounded border border-white/20 px-2 py-3 text-left text-sm font-semibold text-white transition-colors hover:bg-white/10">
                            Tools
                        </button>
                        @if (_toolsOpen)
                        {
                            <div class="mt-2 space-y-1 rounded-lg bg-white/10 p-2 text-sm">
                                <a href="/profile" @onclick="CloseAll" class="block rounded px-2 py-2 text-white transition-colors hover:bg-white/10">Profile</a>
                                <a href="/tasks" @onclick="CloseAll" class="block rounded px-2 py-2 text-white transition-colors hover:bg-white/10">Tasks</a>
                                <a href="/tutorials" @onclick="CloseAll" class="block rounded px-2 py-2 text-white transition-colors hover:bg-white/10">Tutorials</a>
                                <a href="/admin/members" @onclick="CloseAll" class="block rounded px-2 py-2 text-white transition-colors hover:bg-white/10">Admin Panel</a>
                                <form method="post" action="/logout" class="pt-1">
                                    <button type="submit" class="w-full rounded px-2 py-2 text-left text-white/80 transition-colors hover:bg-white/10 hover:text-white">Logout</button>
                                </form>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" @onclick="CloseAll" class="mt-2 block rounded border border-white/20 px-2 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    }
</header>

@code {
    private bool _navOpen;
    private bool _toolsOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navOpen = false;
        _toolsOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleNav()
    {
        _navOpen = !_navOpen;
        if (!_navOpen)
        {
            _toolsOpen = false;
        }
    }

    private void ToggleTools()
    {
        _toolsOpen = !_toolsOpen;
    }

    private void CloseAll()
    {
        _navOpen = false;
        _toolsOpen = false;
    }
}
