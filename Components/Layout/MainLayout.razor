@inherits LayoutComponentBase

@* ---------- Page background ---------- *@

@* Decorative — empty alt so screen readers skip it. It is the largest paint on every page,
   hence the explicit dimensions, srcset and high fetch priority. *@
<div class="fixed inset-0 -z-10">
    <img src="/images/banner-1280.webp"
         srcset="/images/banner-640.webp 640w, /images/banner-1280.webp 1280w, /images/banner-1920.webp 1920w"
         sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" decoding="async"
         class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-[rgba(0,20,60,0.72)]"></div>
</div>

<div class="min-h-screen flex flex-col">

    @* ---------- Header and page body ---------- *@

    <SiteHeader />

    <main class="flex-1">
        @Body
    </main>

    <footer class="mt-20 bg-black text-white">
        <div class="mx-auto max-w-360 px-6 py-16 lg:px-20">
            <div class="grid grid-cols-1 gap-10 md:grid-cols-3">

                @* ---------- Footer: Oil & Gas News ---------- *@

                <div class="flex flex-col items-center">
                    <h4 class="spe-footer-heading">Oil & Gas News</h4>
                    @* #UpdateLink — the three news links below. *@
                    <ul class="list-disc space-y-3 text-sm text-white/70">
                        <li>
                            <a class="spe-footer-link" href="https://www.spe-aberdeen.org/news"
                               target="_blank" rel="noopener noreferrer">SPE Aberdeen Section News</a>
                        </li>
                        <li>
                            <a class="spe-footer-link" href="https://www.spe.org/en/publications-and-insights/"
                               target="_blank" rel="noopener noreferrer">SPE Resources</a>
                        </li>
                        <li>
                            <a class="spe-footer-link" href="https://jpt.spe.org/"
                               target="_blank" rel="noopener noreferrer">JPT</a>
                        </li>
                    </ul>
                </div>

                @* ---------- Footer: Useful Links ---------- *@

                <div class="flex flex-col items-center">
                    <h4 class="spe-footer-heading">Useful Links</h4>
                    @* #UpdateLink — the three links below. To change one, edit its href and its
                       label text. To add another, copy a whole <li>; to drop one, delete its <li>.
                       Keep target="_blank" rel="noopener noreferrer" on anything off-site. *@
                    <ul class="space-y-3 text-sm text-white/70">
                        <li>
                            <a class="spe-footer-link" href="https://connect.spe.org/home"
                               target="_blank" rel="noopener noreferrer">SPE Connect</a>
                        </li>
                        <li>
                            <a class="spe-footer-link" href="https://www.energy4me.org/"
                               target="_blank" rel="noopener noreferrer">Energy4me</a>
                        </li>
                        <li>
                            <a class="spe-footer-link" href="https://www.linkedin.com/company/spe-young-members/posts/"
                               target="_blank" rel="noopener noreferrer">Young Professionals</a>
                        </li>
                    </ul>
                </div>

                @* ---------- Footer: Contact Us ---------- *@

                <div class="flex flex-col items-center">
                    <h4 class="spe-footer-heading">Contact Us</h4>
                    @* #UpdateLink — chapter contact address, social accounts, and the society
                       sign-up button at the bottom of this block. The WhatsApp invite is shown
                       to signed-in members only; the repository link to Team Leaders only. *@
                    <div class="flex flex-row gap-4">
                        <a href="mailto:spe@ausa.org.uk" aria-label="Email the chapter">
                            <Icon Name="envelope" Class="h-8 w-8" />
                        </a>
                        <a href="https://www.instagram.com/spe_uoa?utm_source=ig_web_button_share_sheet&igsi=ZDNlZDc0MzIxNw=="
                           target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                            <Icon Name="instagram" Class="h-8 w-8" />
                        </a>
                        <a href="https://www.linkedin.com/company/speabdnuni/?viewAsMember=true" target="_blank"
                           rel="noopener noreferrer" aria-label="LinkedIn">
                            <Icon Name="linkedin" Class="h-8 w-8" />
                        </a>
                        <AuthorizeView>
                            <Authorized Context="memberLinks">
                                <a href="https://chat.whatsapp.com/JmBsysaef0jLvk5EY5WhAh" target="_blank"
                                   rel="noopener noreferrer" aria-label="WhatsApp group">
                                    <Icon Name="whatsapp" Class="h-8 w-8" />
                                </a>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="TeamLeader">
                            <Authorized Context="repoLink">
                                <a href="https://github.com/zainwaffi/SPE_website" target="_blank"
                                   rel="noopener noreferrer" aria-label="Source repository">
                                    <Icon Name="github" Class="h-8 w-8" />
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                    <a href="https://www.ausa.org.uk/organisation/speabdn/" target="_blank" rel="noopener noreferrer"
                       class="spe-primary-btn mt-6 inline-block">
                        Join Our University Society
                    </a>
                </div>
            </div>
        </div>

        @* ---------- Footer: copyright ---------- *@

        <div class="mx-auto max-w-360 px-6 py-6 lg:px-20">
            <p class="text-xs text-white/60">
                Copyright @CopyrightYears, SPE University of Aberdeen Student Chapter. All rights reserved.
            </p>
            <p class="text-xs text-white/40">
                Trademarks and materials belonging to the Society of Petroleum Engineers and other third parties
                remain the property of their respective owners and are used with permission.
            </p>
        </div>
    </footer>
</div>

@* ---------- Unhandled-error banner ---------- *@

@* Shown by Blazor itself when a circuit throws; hidden until then. *@
<div id="blazor-error-ui"
     class="hidden fixed bottom-4 right-4 bg-red-50 border border-red-300 text-red-800 p-4 rounded-lg shadow-lg z-50"
     data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
</div>

@code {
    // #UpdateLink — the year the site launched. The copyright line reads "2026" on its own
    // until the current year moves past it, then becomes a range.
    private const int FoundingYear = 2026;

    private static string CopyrightYears =>
        DateTime.Now.Year > FoundingYear ? $"{FoundingYear}-{DateTime.Now.Year}" : FoundingYear.ToString();
}
