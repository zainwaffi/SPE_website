@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <nav class="bg-spe-blue shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-spe-gold font-extrabold text-xl tracking-tight">SPE</span>
                    <span class="text-white font-semibold text-lg">Chapter</span>
                </a>

                <div class="flex items-center gap-1 sm:gap-4 text-sm font-medium">
                    <NavLink href="/" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10" Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                    <NavLink href="/events/upcoming" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10">
                        Events
                    </NavLink>
                    <NavLink href="/events/past" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10">
                        Our Events
                    </NavLink>
                    <NavLink href="/opportunities" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10">
                        Opportunities
                    </NavLink>

                    <AuthorizeView>
                        <Authorized>
                            <NavLink href="/profile" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10">
                                Dashboard
                            </NavLink>
                            <NavLink href="/tutorials" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10">
                                Tutorials
                            </NavLink>
                            <NavLink href="/change-password" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors" ActiveClass="text-white bg-white/10">
                                Change Password
                            </NavLink>
                            <AuthorizeView Roles="President" Context="presidentCtx">
                                <Authorized>
                                    <NavLink href="/admin/members" class="text-spe-gold hover:text-amber-300 px-2 py-1 rounded transition-colors font-semibold" ActiveClass="text-amber-300">
                                        Admin
                                    </NavLink>
                                </Authorized>
                            </AuthorizeView>
                            <form method="post" action="/logout" class="inline">
                                <button type="submit" class="text-blue-200 hover:text-white px-2 py-1 rounded transition-colors cursor-pointer">
                                    Logout
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink href="/login" class="bg-spe-gold text-spe-blue px-4 py-2 rounded-lg font-semibold hover:bg-amber-400 transition-colors">
                                Login
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-1">
        @Body
    </main>

    <footer class="bg-slate-800 text-slate-400 text-sm py-6 text-center">
        <p>&copy; @DateTime.Now.Year SPE Local Chapter. All rights reserved.</p>
    </footer>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-4 right-4 bg-red-50 border border-red-300 text-red-800 p-4 rounded-lg shadow-lg z-50" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
</div>
