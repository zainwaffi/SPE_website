@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <SiteHeader />

    <main class="flex-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start text-center">

                <!-- Contact Us -->
                <div class="flex flex-col items-center">
                    <h3 class="text-spe-blue text-4xl font-semibold mb-2">Contact us</h3>
                    <a href="mailto:spe@ausa.org.uk" class="text-spe-blue text-lg hover:underline">
                        spe@ausa.org.uk
                    </a>
                </div>

                <!-- Membership -->
                <div class="flex flex-col items-center">
                    <h3 class="text-spe-blue text-4xl font-semibold mb-4">Membership</h3>
                    <div class="flex flex-col items-center gap-3">
                        <a href="https://www.spe.org/" target="_blank" rel="noopener noreferrer">
                        <img src="/images/logo-footer.png" alt="SPE International" class="h-8 object-contain" />
                        </a>
                        <a href="https://www.ausa.org.uk/organisation/speabdn/" target="_blank" rel="noopener noreferrer">
                        <img src="/images/student-union.png" alt="Students' Union" class="h-8 object-contain" />
                        </a>
                    </div>
                </div>

                <!-- Follow Us -->
                <div class="flex flex-col items-center">
                    <h3 class="text-spe-blue text-4xl font-semibold mb-4">Follow Us</h3>
                    <div class="flex items-center gap-3">
                        <a href="https://www.instagram.com/spe_aberdeen?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" aria-label="Instagram"
                           class="text-spe-blue hover:opacity-70 transition-opacity" target="_blank" rel="noopener noreferrer">
                            <i class="fa fa-instagram fa-3x"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/spe-aberdeen-university-student-chapter-838896333" aria-label="LinkedIn"
                           class="text-spe-blue hover:opacity-70 transition-opacity" target="_blank" rel="noopener noreferrer">
                            <i class="fa fa-linkedin fa-3x"></i>
                        </a>
                        <a href="https://chat.whatsapp.com/JmBsysaef0jLvk5EY5WhAh" aria-label="WhatsApp"
                           class="text-spe-blue hover:opacity-70 transition-opacity" target="_blank" rel="noopener noreferrer">
                            <i class="fa fa-whatsapp fa-3x"></i>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-4 right-4 bg-red-50 border border-red-300 text-red-800 p-4 rounded-lg shadow-lg z-50" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
</div>
