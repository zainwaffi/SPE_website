<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>28c69674-4798-4e15-b846-a8a48a396e78</UserSecretsId>
    <!-- `dotnet publish` writes into ./publish, whose copied wwwroot assets would otherwise
         be globbed back in as build inputs and fail with BLAZOR106. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <!-- Inputs/Outputs make this incremental: previously it re-shelled to npx on every single
       build, even when no markup or CSS had changed. -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="Exists('$(ProjectDir)node_modules')" Inputs="$(ProjectDir)Styles\input.css;@(RazorComponent)" Outputs="$(ProjectDir)wwwroot\tailwind.css">
    <Exec Command="npm run build:css" WorkingDirectory="$(ProjectDir)" ConsoleToMsBuild="true" />
  </Target>

</Project>
